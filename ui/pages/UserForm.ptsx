import { Layout } from "../layouts/Layout.ptsx";
import { EditorColumn } from "../components/EditorColumn.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { RecordProblems } from "../components/RecordEditor/RecordProblems.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type UserFormProps = {
  user_name: string;
  user_email: string;
  csrf: string;
  nav: JSX.Element;
  title: string;
  /** Where the form posts: create, or update of an existing account. */
  action: string;
  is_new: boolean;
  /** The account being edited is the signed-in user's own: the role is fixed. */
  is_me: boolean;
  name: string;
  email: string;
  is_admin: boolean;
  /** An existing account that has not set its password yet. */
  invited: boolean;
  /** A set-password link just issued, shown exactly once; empty otherwise. */
  link: string;
  link_action: string;
  delete_action: string;
  /** What was refused when the last post did not go through; empty otherwise. */
  problem: string;
  /** The custom field rows (RecordFields): one group per custom field group that applies
   * to the account, each field named `<group>.<field>`; absent for a new account, whose
   * role is not known yet. */
  fields?: JSX.Element;
  /** The custom field values refused, by path, when the last post did not go through. */
  problems: Array<{ path: string; message: string }>;
};

/** One account: its name, email and role. A new account is invited with a set-password
 * link unless a password is typed; an existing one can be renamed, given another role,
 * sent a fresh link, or deleted. */
export function UserForm({
  user_name, user_email, csrf, nav, title, action, is_new, is_me, name, email, is_admin,
  invited, link, link_action, delete_action, problem, fields, problems,
}: UserFormProps) {
  return (
    <Layout title={title} section="settings" crumb_label="Users" crumb_href="/admin/settings/users"
      sidebar={nav} user_name={user_name} user_email={user_email} csrf={csrf}>
      <EditorColumn>
        <PageHeader title={title} back_label="Users" back_href="/admin/settings/users" />
        {problem !== "" && (
          <Text as="p" variant="body-sm" tone="error" classes="font-medium">
            The user was not saved: {problem}.
          </Text>
        )}
        {problems.length > 0 && <RecordProblems problems={problems} />}
        {link !== "" && (
          <Callout title="Set-password link" tone="info">
            <Text as="p" variant="body-sm">
              Send this link to {name}; it works once, for an hour, and is shown only now.
              Prefix it with the site's address.
            </Text>
            <Code classes="mt-2 block break-all">{link}</Code>
          </Callout>
        )}
        <form id="user" method="post" action={action} class="mt-6 space-y-5">
          <input type="hidden" name="csrf" value={csrf} />
          <Field>
            <FieldLabel htmlFor="display_name">Name</FieldLabel>
            <Input id="display_name" name="display_name" value={name} required autocomplete="off" />
          </Field>
          <Field>
            <FieldLabel htmlFor="email">Email</FieldLabel>
            <Input id="email" type="email" name="email" value={email} required={is_new}
              readOnly={!is_new} autocomplete="off" />
            {!is_new && <FieldDescription>The email an account signs in with cannot change.</FieldDescription>}
          </Field>
          <Field>
            <FieldLabel htmlFor="role">Role</FieldLabel>
            <NativeSelect id="role" name="role" disabled={is_me}>
              <option value="editor" selected={!is_admin}>Editor: manages the content</option>
              <option value="admin" selected={is_admin}>Admin: everything, users and settings too</option>
            </NativeSelect>
            {is_me && <FieldDescription>Your own role is changed by another admin.</FieldDescription>}
          </Field>
          {is_new && (
            <Field>
              <FieldLabel htmlFor="password">Password</FieldLabel>
              <Input id="password" type="password" name="password" autocomplete="new-password" />
              <FieldDescription>
                Leave it empty to invite the person with a set-password link instead.
              </FieldDescription>
            </Field>
          )}
          {fields && <div class="space-y-5 border-t border-border pt-6" data-part="user-fields">{fields}</div>}
          <div class="flex flex-wrap items-center gap-2">
            <Button type="submit">{is_new ? "Create user" : "Save"}</Button>
            <Button href="/admin/settings/users" hierarchy="tertiary">Cancel</Button>
          </div>
        </form>
        {!is_new && (
          <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-border pt-6">
            <form method="post" action={link_action}>
              <input type="hidden" name="csrf" value={csrf} />
              <Button type="submit" hierarchy="secondary">
                {invited ? "New set-password link" : "Reset password by link"}
              </Button>
            </form>
            {!is_me && (
              <Dialog>
                <DialogTrigger asChild>
                  <Button hierarchy="secondary" intent="destructive">Delete user</Button>
                </DialogTrigger>
                <DialogContent>
                  <DialogTitle>Delete {name}?</DialogTitle>
                  <DialogDescription>
                    The account goes for good and is signed out everywhere. What they created stays.
                  </DialogDescription>
                  <form method="post" action={delete_action} class="mt-5 flex justify-end gap-2">
                    <input type="hidden" name="csrf" value={csrf} />
                    <DialogClose asChild>
                      <Button hierarchy="secondary">Cancel</Button>
                    </DialogClose>
                    <Button type="submit" intent="destructive">Delete user</Button>
                  </form>
                </DialogContent>
              </Dialog>
            )}
          </div>
        )}
      </EditorColumn>
    </Layout>
  );
}
