import { FormPage } from "../layouts/FormPage.ptsx";
import { ReferenceDrawer } from "../components/ReferenceDrawer.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";

export type SettingsDocumentProps = {
  title: string;
  description: string;
  has_fields: boolean;
  schema_href: string;
  /** The section's values in the record editor (RecordEditor), drawn by the adapter. */
  editor: JSX.Element;
};

/** One settings section of the site: its values in the record editor, or, before its
 * fields are defined, the way to define them. */
export function SettingsDocument({ title, description, has_fields, schema_href, editor }: SettingsDocumentProps) {
  return (
    <FormPage
      title={title}
      description={description}
      actions={!has_fields && <Button href={schema_href}>Define fields</Button>}
      editor={
        has_fields && (
          <div class="contents">
            {editor}
            <ReferenceDrawer />
          </div>
        )
      }
    >
      <Empty compact>
        <EmptyTitle>No fields yet</EmptyTitle>
        <EmptyDescription>Define its fields in Structure to start configuring it.</EmptyDescription>
      </Empty>
    </FormPage>
  );
}
