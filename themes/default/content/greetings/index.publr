---
import Base from '../../layouts/base.publr';
const greetings = Publr.build.getCollection({ limit: 100 });
---
<Base title="Greetings · Publr">
  <section class="mx-auto max-w-wide px-6 pt-16 pb-8">
    <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-accent">Everyone who said hello</p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">Greetings</h1>
  </section>
  <section class="mx-auto max-w-wide px-6 pb-16">
    {greetings.length === 0 ? (
      <p class="rounded-lg border border-dashed border-line bg-card px-6 py-10 text-center text-muted">Nobody has said hello yet. <code>publr --as you@example.com hello record --note "Hello"</code> adds the first one.</p>
    ) : null}
    <ul class="divide-y divide-line border-t border-line">
      {greetings.map((greeting) => (
        <li class="grid gap-2 py-7 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <time class="text-sm text-muted">{greeting.created_at}</time>
          <h2 class="font-serif text-2xl font-semibold leading-snug"><a href={`/greetings/${greeting.slug ?? ""}`} class="hover:text-accent">{greeting.title}</a></h2>
        </li>
      ))}
    </ul>
  </section>
</Base>
