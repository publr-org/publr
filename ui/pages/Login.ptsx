import { Publr } from "publr-jsx";
import { CardPage } from "../layouts/CardPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { ProviderButton } from "../components/ProviderButton.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";

export type LoginProps = {
  /** A failed attempt, a throttle delay: shown above the form. */
  notice?: string;
  /** Where the form posts: the login, carrying the page to come back to when there is one. */
  action?: string;
  /** The sign-in providers the site offers, one button each, under the form. */
  providers?: Array<{
    label: string;
    /** The provider's mark: one SVG path on a 24 by 24 canvas, drawn in the text colour. */
    icon: string;
    href: string;
  }>;
  /** False behind an identity-aware proxy: the proxy signs people in, so there is no form,
   * only the way back in through it. */
  password?: boolean;
  /** Just signed out behind such a proxy: says so, with one button to sign in again. */
  signed_out?: boolean;
  /** Signed in behind such a proxy with no role yet: waiting for an administrator. */
  waiting?: boolean;
};

export function Login({
  notice,
  action = "/admin/login",
  providers = [],
  password = true,
  signed_out = false,
  waiting = false,
}: LoginProps) {
  return (
    <CardPage
      title={
        waiting ? Publr.t("Waiting for access") : signed_out ? Publr.t("Signed out") : Publr.t("Log in")
      }
      description={
        waiting
          ? Publr.t("Your account is set up. An administrator still has to give you access.")
          : signed_out
            ? Publr.t("You're signed out of Publr. Your organisation's account stays signed in.")
            : Publr.t("Welcome back to Publr.")
      }
      notice={notice}
      footer={
        password &&
        providers.length > 0 && (
          <div class="contents">
            {providers.map((provider) => (
              <ProviderButton provider={provider} again={false} />
            ))}
          </div>
        )
      }
    >
      {password ? (
        <form method="post" action={action} class="flex flex-col gap-4">
          <Field>
            <FieldLabel htmlFor="email">{Publr.t("Email")}</FieldLabel>
            <Input id="email" type="email" name="email" required autocomplete="username" />
          </Field>
          <Field>
            <FieldLabel htmlFor="password">{Publr.t("Password")}</FieldLabel>
            <Input
              id="password"
              type="password"
              name="password"
              required
              autocomplete="current-password"
            />
          </Field>
          <Button type="submit" size="lg" classes="mt-2 w-full">
            {Publr.t("Log in")}
          </Button>
        </form>
      ) : (
        <div class="flex flex-col gap-2">
          {providers.map((provider) => (
            <ProviderButton provider={provider} again={signed_out} />
          ))}
        </div>
      )}
    </CardPage>
  );
}
