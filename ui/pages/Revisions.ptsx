import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

/** Every kept version of a record, newest first, after the current one. */
export type RevisionsProps = {
  title: string;
  record_title: string;
  record_href: string;
  status: string;
  changed: boolean;
  updated: string;
  updated_by: string;
  rows: Array<{ href: string; seq: string; kind: string; title: string; at: string; by: string }>;
};

export function Revisions({
  title,
  record_title,
  record_href,
  status,
  changed,
  updated,
  updated_by,
  rows,
}: RevisionsProps) {
  return (
    <IndexPage
      title={title}
      parents={[{ label: record_title, href: record_href }]}
      description={`${rows.length + 1} kept`}
      footer={
        rows.length === 0 && (
          <Text as="p" variant="body-sm" tone="muted">
            No previous versions yet: one is kept every time the live document is replaced.
          </Text>
        )
      }
    >
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>#</TableHead>
          <TableHead>Kind</TableHead>
          <TableHead>Title</TableHead>
          <TableHead>Taken</TableHead>
          <TableHead>By</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell>
            <Text as="span" variant="body-sm">
              current
            </Text>
          </TableCell>
          <TableCell>
            <div class="flex flex-wrap items-center gap-3">
              {status === "published" ? (
                <Status tone="success">{status}</Status>
              ) : (
                <Status tone="neutral">{status}</Status>
              )}
              {changed && <Status tone="warning">pending changes aside</Status>}
            </div>
          </TableCell>
          <TableCell>
            <Text as="span" variant="body-sm">
              {record_title}
            </Text>
          </TableCell>
          <TableCell numeric>
            <Text as="span" variant="body-sm" tone="muted">
              {updated}
            </Text>
          </TableCell>
          <TableCell>
            <Text as="span" variant="body-sm" tone="muted">
              {updated_by}
            </Text>
          </TableCell>
        </TableRow>
        {rows.map((row) => (
          <TableRow>
            <TableCell>
              <Link href={row.href} variant="body-sm">
                {row.seq}
              </Link>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm" tone="muted">
                {row.kind}
              </Text>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm">
                {row.title}
              </Text>
            </TableCell>
            <TableCell numeric>
              <Text as="span" variant="body-sm" tone="muted">
                {row.at}
              </Text>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm" tone="muted">
                {row.by}
              </Text>
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
</IndexPage>
  );
}
