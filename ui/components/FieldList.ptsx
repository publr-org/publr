import { IndexHeader } from "./IndexHeader.ptsx";
import { IndexSection } from "./IndexSection.ptsx";
import { FieldListActions } from "./FieldList/FieldListActions.ptsx";
import { FieldRows } from "./FieldList/FieldRows.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";

export type FieldListProps = {
  standalone?: boolean;
  csrf: string;
  title: string;
  /** The handle and the kind, under the title. */
  description: string;
  group_href: string;
  add_href: string;
  settings_href?: string;
  /** The type's records, absent for a component. */
  content_href?: string;
  rows: Array<{
    /** The field's path: `title`, or `gallery.caption` inside a group or repeater. */
    path: string;
    label: string;
    required: boolean;
    icon: IconName;
    /** The kind and what matters about it: `Reference (many) to address`. */
    summary: string;
    /** Inside a group or repeater: drawn indented under its parent. */
    nested: boolean;
    /** Declared in code by a plugin: shown, never changed here. */
    locked: boolean;
    edit_href: string;
    move_action: string;
    delete_action: string;
    /** The picker for a child field; present on groups and repeaters. */
    add_child_href?: string;
  }>;
};

/** A content type's fields: on its page, the title band with the preview and Add field,
 * then the rows (FieldRows) or the empty state filling the page; on a field group's page,
 * a boxed section of the form. A field is deleted from its own page, after a confirmation. */
export function FieldList({
  csrf,
  title,
  standalone = false,
  description,
  group_href,
  add_href,
  settings_href,
  content_href,
  rows,
}: FieldListProps) {
  return (
    <div class="flex flex-1 flex-col" data-part="field-list" data-standalone={standalone}>
      {standalone ? (
        <IndexSection
          boxed
          title={title}
          description={description}
          actions={
            <FieldListActions
              standalone={standalone}
              add_href={add_href}
              group_href={group_href}
              settings_href={settings_href}
              content_href={content_href}
            />
          }
        >
          {rows.length > 0 && (
            <FieldRows csrf={csrf} standalone={standalone} add_href={add_href} rows={rows} />
          )}
        </IndexSection>
      ) : (
        <div class="flex flex-1 flex-col">
          <IndexHeader
            title={title}
            description={description}
            actions={
              <FieldListActions
                standalone={standalone}
                add_href={add_href}
                group_href={group_href}
                settings_href={settings_href}
                content_href={content_href}
              />
            }
          />
          {rows.length === 0 ? (
            <Empty>
              <EmptyTitle>No fields yet</EmptyTitle>
              <EmptyDescription>
                Pick a kind, name the field, and keep going to build the form.
              </EmptyDescription>
            </Empty>
          ) : (
            <div class="border-t border-border">
              <FieldRows csrf={csrf} standalone={standalone} add_href={add_href} rows={rows} />
            </div>
          )}
        </div>
      )}
    </div>
  );
}
