import { Publr } from "publr-jsx";
import { Document } from "./Document.ptsx";
import { Mark } from "../components/Mark.ptsx";
import { AskBubble } from "../components/AskBubble.ptsx";
import { Crumbs } from "../components/Crumbs.ptsx";
import { RailItem } from "../components/RailItem.ptsx";
import { SidebarHeading } from "../components/SidebarHeading.ptsx";
import { Avatar } from "@publr/ui/Avatar.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuSeparator } from "@publr/ui/DropdownMenuSeparator.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type ChromeProps = {
  /** The page's name: the last crumb and the window's title. */
  title: string;
  /** The pages between the area and this one, in the crumbs. */
  parents?: Array<{ label: string; href: string }>;
  /** Editing one record: no sidebar, the sheet to itself. */
  focus?: boolean;
  children?: JSX.Element;
};

/** The admin around every signed-in page, drawn by the page layouts (IndexPage, FormPage,
 * HubPage), never by a page. A dark icon rail (the mark, the fixed areas and the pages the
 * person pinned, at the bottom the signed-in user and Settings), the area's sidebar unless the page is in focus, and the
 * sheet opening with the crumbs and the plugins' top bar items. Who is signed in, the area
 * and its sidebar come from the request. */
export function Chrome({ title, parents = [], focus = false, children }: ChromeProps) {
  return (
    <Document title={title}>
      <div class="flex h-dvh overflow-hidden">
        <div id="admin-nav" popover="auto" class="contents" data-part="admin-nav">
        {Publr.request.session.email !== "" && !Publr.request.admin.framed && (
        <div class="flex w-14 shrink-0 flex-col items-center bg-rail text-rail-foreground">
          <a
            href="/admin"
            aria-label={Publr.request.admin.brand !== "" ? Publr.request.admin.brand : "Publr"}
            class="flex h-14 w-full items-center justify-center text-rail-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-rail-foreground"
          >
            {Publr.request.admin.brand_mark !== "" ? (
              <img src={Publr.request.admin.brand_mark} alt="" class="size-7 rounded-full" />
            ) : (
              <Mark classes="size-6" />
            )}
          </a>
          <nav aria-label={Publr.t("Sections")} data-slot="rail" class="flex flex-col items-center gap-1 pt-1">
            <RailItem
              href="/admin"
              label={Publr.t("Overview")}
              icon_name="home"
              active={Publr.request.admin.area === "overview" && !Publr.request.admin.pinned_lit}
            />
            <RailItem
              href="/admin/content"
              label={Publr.t("Content")}
              icon_name="file"
              active={(Publr.request.admin.area === "content" || Publr.request.admin.area === "section") && !Publr.request.admin.pinned_lit}
            />
            <RailItem
              href="/admin/media"
              label={Publr.t("Media")}
              icon_name="image"
              active={Publr.request.admin.area === "media" && !Publr.request.admin.pinned_lit}
            />
            <RailItem
              href="/admin/design/system"
              label={Publr.t("Design")}
              icon_name="palette"
              active={Publr.request.admin.area === "design" && !Publr.request.admin.pinned_lit}
            />
            {Publr.request.admin.rail}
          </nav>
          <div class="mt-auto flex flex-col items-center gap-1 pb-3">
            {Publr.request.admin.site_href !== "" && (
              // On phones the top bar has no room to promise the site link; the menu keeps it.
              <div class="flex md:hidden">
                <RailItem
                  href={Publr.request.admin.site_href}
                  label={Publr.t("View site")}
                  icon_name="external"
                  active={false}
                  target="_blank"
                />
              </div>
            )}
            <DropdownMenu>
              <DropdownMenuTrigger classes="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 transition-colors hover:bg-rail-accent/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rail-foreground">
                <Avatar
                  size="sm"
                  name={Publr.request.session.name}
                  email={Publr.request.session.email}
                  src={Publr.request.session.avatar}
                />
              </DropdownMenuTrigger>
              <DropdownMenuContent align="left" classes="min-w-56">
                <div class="flex flex-col px-2 py-1.5" data-part="account">
                  <Text as="span" variant="heading-xs" classes="truncate">
                    {Publr.request.session.name}
                  </Text>
                  <Text as="span" variant="body-xs" tone="muted" classes="truncate">
                    {Publr.request.session.email}
                  </Text>
                </div>
                {Publr.request.admin.language_menu}
                <DropdownMenuSeparator />
                <form method="post" action="/admin/logout">
                  <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                  <DropdownMenuItem type="submit">
                    <Icon name="logout" size="sm" />
                    {Publr.t("Log out")}
                  </DropdownMenuItem>
                </form>
              </DropdownMenuContent>
            </DropdownMenu>
            {(Publr.request.admin.can_settings || Publr.request.admin.can_structure) && (
              <RailItem
                href={Publr.request.admin.can_settings ? "/admin/settings" : "/admin/structure"}
                label={Publr.t("Settings")}
                icon_name="settings"
                active={Publr.request.admin.area === "settings" && !Publr.request.admin.pinned_lit}
              />
            )}
          </div>
        </div>
        )}
        {!focus && !Publr.request.admin.framed && Publr.request.admin.sidebar && (
          <aside
            aria-label={Publr.t("Section navigation")}
            class="flex w-60 shrink-0 flex-col border-r border-sidebar-border text-sidebar-foreground"
          >
            {Publr.request.admin.sidebar_heading}
            {!Publr.request.admin.sidebar_heading && (
              <SidebarHeading
                href={Publr.request.admin.area === "content" ? "/admin/content" : "/admin/settings"}
                icon={Publr.request.admin.area === "content" ? "file" : "settings"}
                label={Publr.request.admin.area === "content" ? Publr.t("Content") : Publr.t("Settings")}
              />
            )}
            <nav
              class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 pb-4"
              aria-label={Publr.t("Section")}
            >
              {Publr.request.admin.sidebar}
            </nav>
          </aside>
        )}
        </div>
        <main
          id="main"
          tabindex="-1"
          data-sheet={!focus && !Publr.request.admin.framed && Publr.request.admin.sidebar ? "beside" : "alone"}
          class={[
            "flex min-w-0 flex-1 flex-col overflow-y-auto bg-card outline-none",
            // What sticks in the sheet sticks under its top bar, which a framed page has not.
            Publr.request.admin.framed ? "[--sheet-top:0px]" : "[--sheet-top:3.5rem]",
          ]}
        >
          {!Publr.request.admin.framed && (
            <div data-part="top-bar" class="sticky top-0 z-20 flex h-14 shrink-0 items-center justify-between gap-4 border-b border-border bg-card/95 px-5 backdrop-blur">
              <div class="flex min-w-8 items-center gap-2 max-md:flex-1 md:min-w-0">
                {Publr.request.session.email !== "" && (
                  <Button
                    type="button"
                    hierarchy="tertiary"
                    size="sm"
                    label={Publr.t("Menu")}
                    title={Publr.t("Menu")}
                    popovertarget="admin-nav"
                    classes="-ml-1.5 shrink-0 md:hidden"
                  >
                    <Icon name="menu-03" size="sm" />
                  </Button>
                )}
                <div class="flex min-w-0 max-md:flex-1 max-md:overflow-hidden">
                  <Crumbs title={title} parents={parents} />
                </div>
              </div>
              <div data-slot="top_bar" class="flex shrink-0 items-center gap-4 max-md:gap-2">
                {Publr.request.admin.top_bar}
              </div>
            </div>
          )}
          {children}
        </main>
      </div>
      {Publr.request.admin.can_ask && <AskBubble csrf={Publr.request.session.csrf} base={Publr.request.admin.base} />}
    </Document>
  );
}
