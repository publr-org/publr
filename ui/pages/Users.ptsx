import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { PeopleTable } from "../components/PeopleTable.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";

export type UsersProps = {
  users: Array<{
    href: string;
    name: string;
    email: string;
    /** The labels of the account's roles, comma-separated. */
    roles: string;
    /** Signed in at least once; an invited account is inactive until its link is used. */
    active: boolean;
    /** The signed-in user's own row. */
    me: boolean;
    /** The account's value in each plugin column, in `columns`' order; empty shows "—". */
    cells?: Array<{ text: string }>;
  }>;
  /** Columns plugins add (`.register_columns`): `kind` is number, money, date, text, status
   * or link; a column of a stored field sorts the list through `sort_href`. */
  columns?: Array<{ field: string; label: string; kind: string; sort_href: string; sorted: string }>;
  /** The columns this person hides, by field (`user.columns`). */
  hidden?: string[];
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  /** The pages before and after this one; empty at either end. */
  previous_href: string;
  next_href: string;
  /** The tab shown: `users`, or one a plugin adds (`roles`). */
  tab?: string;
  /** The tabs plugins add, after Users' own; none draws no tabs. */
  plugin_tabs?: Array<{ tab: string; label: string; href: string }>;
  /** A plugin tab's sections, each drawn by the plugin that adds it. */
  sections?: JSX.Element;
  /** A plugin tab's primary action, in place of Add user. */
  action_label?: string;
  action_href?: string;
};

/** The accounts, oldest first, a page at a time, and a way to add one. There is always one:
 * whoever looks. */
export function Users({
  users,
  columns = [],
  hidden = [],
  range,
  previous_href,
  next_href,
  tab = "users",
  plugin_tabs = [],
  sections,
  action_label = "",
  action_href = "",
}: UsersProps) {
  const own = tab === "users";
  return (
    <IndexPage
      title={Publr.t("Users")}
      description={Publr.t("Who may sign in, and what they may do.")}
      actions={
        own ? (
          <Button href="/admin/settings/users/new">{Publr.t("Add user")}</Button>
        ) : (
          action_label !== "" && <Button href={action_href}>{action_label}</Button>
        )
      }
      tabs={
        plugin_tabs.length > 0 && (
          <TabNav label={Publr.t("Users")}>
            <TabNavLink href="/admin/settings/users" active={own}>
              {Publr.t("Users")}
            </TabNavLink>
            {plugin_tabs.map((item) => (
              <TabNavLink href={item.href} active={tab === item.tab}>
                {item.label}
              </TabNavLink>
            ))}
          </TabNav>
        )
      }
      footer={own && range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
    >
      {!own && sections}
      {own && <PeopleTable users={users} columns={columns} hidden={hidden} />}
    </IndexPage>
  );
}
