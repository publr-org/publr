import { Publr } from "publr-jsx";
import { Pagination } from "@publr/ui/Pagination.ptsx";
import { PaginationContent } from "@publr/ui/PaginationContent.ptsx";
import { PaginationItem } from "@publr/ui/PaginationItem.ptsx";
import { PaginationNext } from "@publr/ui/PaginationNext.ptsx";
import { PaginationPrevious } from "@publr/ui/PaginationPrevious.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PagerProps = {
  /** "51–100 of 230". */
  range: string;
  /** The pages before and after this one; empty at either end. */
  previous_href: string;
  next_href: string;
};

/** A list's way through its pages: where this one stands, and the ones either side. */
export function Pager({ range, previous_href, next_href }: PagerProps) {
  return (
    <Pagination label={Publr.t("Pages")}>
      <PaginationContent>
        {previous_href !== "" && (
          <PaginationItem>
            <PaginationPrevious href={previous_href} />
          </PaginationItem>
        )}
        <PaginationItem>
          <Text as="span" variant="body-sm" tone="muted">{range}</Text>
        </PaginationItem>
        {next_href !== "" && (
          <PaginationItem>
            <PaginationNext href={next_href} />
          </PaginationItem>
        )}
      </PaginationContent>
    </Pagination>
  );
}
