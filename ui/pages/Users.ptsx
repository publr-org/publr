import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";

export type UsersProps = {
  users: Array<{
    href: string;
    name: string;
    email: string;
    /** The labels of the account's roles, comma-separated. */
    roles: string;
    /** Signed in at least once; an invited account is inactive until its link is used. */
    active: boolean;
    /** The signed-in user's own row. */
    me: boolean;
  }>;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  /** The pages before and after this one; empty at either end. */
  previous_href: string;
  next_href: string;
  /** The tab shown: `users`, or one a plugin adds (`roles`). */
  tab?: string;
  /** The tabs plugins add, after Users' own; none draws no tabs. */
  plugin_tabs?: Array<{ tab: string; label: string; href: string }>;
  /** A plugin tab's sections, each drawn by the plugin that adds it. */
  sections?: JSX.Element;
  /** A plugin tab's primary action, in place of Add user. */
  action_label?: string;
  action_href?: string;
};

/** The accounts, oldest first, a page at a time, and a way to add one. There is always one:
 * whoever looks. */
export function Users({
  users,
  range,
  previous_href,
  next_href,
  tab = "users",
  plugin_tabs = [],
  sections,
  action_label = "",
  action_href = "",
}: UsersProps) {
  const own = tab === "users";
  return (
    <IndexPage
      title={Publr.t("Users")}
      description={Publr.t("Who may sign in, and what they may do.")}
      actions={
        own ? (
          <Button href="/admin/settings/users/new">{Publr.t("Add user")}</Button>
        ) : (
          action_label !== "" && <Button href={action_href}>{action_label}</Button>
        )
      }
      tabs={
        plugin_tabs.length > 0 && (
          <TabNav label={Publr.t("Users")}>
            <TabNavLink href="/admin/settings/users" active={own}>
              {Publr.t("Users")}
            </TabNavLink>
            {plugin_tabs.map((item) => (
              <TabNavLink href={item.href} active={tab === item.tab}>
                {item.label}
              </TabNavLink>
            ))}
          </TabNav>
        )
      }
      footer={own && range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
    >
      {!own && sections}
      {own && (
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Name")}</TableHead>
            <TableHead>{Publr.t("Email")}</TableHead>
            <TableHead>{Publr.t("Roles")}</TableHead>
            <TableHead>{Publr.t("Status")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {users.map((user) => (
            <TableRow>
              <TableCell>
                <Link href={user.href} variant="body-sm" tone="default">
                  {user.name}
                </Link>
                {user.me && (
                  <Text as="span" variant="body-sm" tone="muted">
                    {" "}
                    {Publr.t("(you)")}
                  </Text>
                )}
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.email}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.roles}
                </Text>
              </TableCell>
              <TableCell>
                {user.active ? (
                  <Status tone="success">{Publr.t("Active")}</Status>
                ) : (
                  <Status tone="warning">{Publr.t("Invited")}</Status>
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      )}
    </IndexPage>
  );
}
