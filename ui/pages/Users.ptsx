import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";

export type UsersProps = {
  users: Array<{
    href: string;
    name: string;
    email: string;
    /** The labels of the account's roles, comma-separated. */
    roles: string;
    /** Signed in at least once; an invited account is inactive until its link is used. */
    active: boolean;
    /** The signed-in user's own row. */
    me: boolean;
  }>;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  /** The pages before and after this one; empty at either end. */
  previous_href: string;
  next_href: string;
};

/** The accounts, oldest first, a page at a time, and a way to add one. There is always one:
 * whoever looks. */
export function Users({ users, range, previous_href, next_href }: UsersProps) {
  return (
    <IndexPage
      title={Publr.t("Users")}
      description={Publr.t("Who may sign in, and what they may do.")}
      actions={<Button href="/admin/settings/users/new">{Publr.t("Add user")}</Button>}
      footer={range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Name")}</TableHead>
            <TableHead>{Publr.t("Email")}</TableHead>
            <TableHead>{Publr.t("Roles")}</TableHead>
            <TableHead>{Publr.t("Status")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {users.map((user) => (
            <TableRow>
              <TableCell>
                <Link href={user.href} variant="body-sm" tone="default">
                  {user.name}
                </Link>
                {user.me && (
                  <Text as="span" variant="body-sm" tone="muted">
                    {" "}
                    {Publr.t("(you)")}
                  </Text>
                )}
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.email}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.roles}
                </Text>
              </TableCell>
              <TableCell>
                {user.active ? (
                  <Status tone="success">{Publr.t("Active")}</Status>
                ) : (
                  <Status tone="warning">{Publr.t("Invited")}</Status>
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
