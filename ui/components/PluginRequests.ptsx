import { Publr } from "publr-jsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Switch } from "@publr/ui/Switch.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Textarea } from "@publr/ui/Textarea.ptsx";

export type PluginRequestsProps = {
  requests: Array<{
    key: string;
    sentence: string;
    /** The plugin's own reason, as it wrote it. */
    reason: string;
    /** `low`, `medium` or `high`, with the flags on now. */
    tier: string;
    /** `granted`, `pending`, `denied` or `unavailable`. */
    state: string;
    /** A line under the key: the types it names, the domains a fetch may reach, what an
     * unavailable key needs. */
    note: string;
    /** Whether the key is switched on: granted. */
    on: boolean;
    /** Whether the switches show: a form around the table posts them. */
    editable: boolean;
    /** Each flag it asked for, as set now. */
    flags: Array<{ name: string; label: string; on: boolean }>;
    /** `http.fetch`: it takes domains, shown in a box to edit when editable. */
    takes_domains: boolean;
    /** Its domains as set now, one a line. */
    domains: string;
    /** `*` is among them: it can reach any address on the internet. */
    anywhere: boolean;
    /** `http.fetch`: the secrets the plugin declares, which its requests carry. */
    secrets: Array<{
      name: string;
      label: string;
      /** Where to find it, as the plugin says. */
      help: string;
      set: boolean;
      /** "Set", or "Set, shared with ai_openai" when other plugins name it too. */
      status: string;
    }>;
  }>;
};

/** What a plugin wants to do, one request a row of a table under its section's heading: what
 * it would do, why ("because it: ..."), the types it names, the permission's key; then how
 * risky it is with the flags on now, where it stands, and (editable) a switch for the key and
 * one for each flag it asked for, set as asked. The form around the table posts them: `keys`
 * names every row, `on` the keys switched on, each flag's name the keys it is on for, and
 * `domains` the box of domains `http.fetch` may reach, one a line. Under `http.fetch`, a field
 * for each secret the plugin declares, posted as `secret:<NAME>`: optional, write-only ("Set"
 * with Replace, never the value). */
export function PluginRequests({ requests }: PluginRequestsProps) {
  return (
    <Table>
      <TableBody>
        {requests.map((request) => (
          <TableRow>
            <TableCell>
              <div class="flex min-w-0 flex-col gap-1 py-1.5" data-key={request.key}>
                <Text as="p" variant="body-md" classes="font-medium">{request.sentence}</Text>
                {request.reason !== "" && (
                  <Text as="p" variant="body-sm" tone="muted">{Publr.t("because it: “{reason}”", { reason: request.reason })}</Text>
                )}
                <div class="flex flex-wrap items-center gap-2 pt-1">
                  <Code>{request.key}</Code>
                  {request.note !== "" && <Text as="span" variant="body-xs" tone="muted">{request.note}</Text>}
                </div>
                {request.anywhere && (
                  <Text as="p" variant="body-sm" tone="warning">
                    {Publr.t("Can send data to any address on the internet")}
                  </Text>
                )}
                {request.editable && (
                  <div class="flex flex-col gap-2 pt-2">
                    <input type="hidden" name="keys" value={request.key} />
                    {request.flags.map((flag) => (
                      <label class="flex items-center gap-2" data-flag={flag.name}>
                        <Switch name={flag.name} value={request.key} checked={flag.on} />
                        <Text as="span" variant="body-sm">{flag.label}</Text>
                      </label>
                    ))}
                    {request.takes_domains && (
                      <Field>
                        <FieldLabel htmlFor="domains">{Publr.t("Domains it may reach, one per line")}</FieldLabel>
                        <Textarea id="domains" name="domains" value={request.domains} rows={3} placeholder={"api.example.com"} />
                        <Text as="p" variant="body-xs" tone="muted">
                          {Publr.t("A name like api.example.com; *.example.com for every name under it; * for any address on the internet.")}
                        </Text>
                      </Field>
                    )}
                  </div>
                )}
                {request.secrets.length > 0 && (
                  <div class="flex flex-col gap-3 pt-2" data-part="secrets">
                    {request.secrets.map((secret) => (
                      <Field>
                        <FieldLabel htmlFor={"secret-" + secret.name}>{secret.label}</FieldLabel>
                        {secret.help !== "" && <FieldDescription>{secret.help}</FieldDescription>}
                        <div class="flex flex-wrap items-center gap-2" data-secret={secret.name}>
                          <Code>{secret.name}</Code>
                          {secret.set ? (
                            <Status tone="success">{secret.status}</Status>
                          ) : (
                            <Status tone="warning">{Publr.t("Not set")}</Status>
                          )}
                        </div>
                        {request.editable && !secret.set && (
                          <Input
                            type="password"
                            id={"secret-" + secret.name}
                            name={"secret:" + secret.name}
                            autocomplete="off"
                            placeholder={Publr.t("Optional: paste it now or later")}
                          />
                        )}
                        {request.editable && secret.set && (
                          <details data-part="replace">
                            <summary class="inline-flex cursor-pointer">
                              <Text as="span" variant="body-sm">{Publr.t("Replace")}</Text>
                            </summary>
                            <div class="pt-2">
                              <Input
                                type="password"
                                id={"secret-" + secret.name}
                                name={"secret:" + secret.name}
                                autocomplete="off"
                                placeholder={Publr.t("Paste a new value")}
                              />
                            </div>
                          </details>
                        )}
                      </Field>
                    ))}
                  </div>
                )}
              </div>
            </TableCell>
            <TableCell align="right">
              <div class="flex flex-wrap items-center justify-end gap-3">
                {request.tier === "high" ? (
                  <Status tone="error">{Publr.t("High risk")}</Status>
                ) : request.tier === "medium" ? (
                  <Status tone="warning">{Publr.t("Medium risk")}</Status>
                ) : (
                  <Status tone="neutral">{Publr.t("Low risk")}</Status>
                )}
                {request.state === "granted" && <Status tone="success">{Publr.t("Granted")}</Status>}
                {request.state === "pending" && <Status tone="review">{Publr.t("Pending")}</Status>}
                {request.state === "denied" && <Status tone="error">{Publr.t("Denied")}</Status>}
                {request.state === "unavailable" && <Status tone="neutral">{Publr.t("Unavailable")}</Status>}
                {request.editable && (
                  <label class="flex items-center gap-2" data-switch="key">
                    <Text as="span" variant="body-sm">{Publr.t("Allowed")}</Text>
                    <Switch name="on" value={request.key} checked={request.on} />
                  </label>
                )}
              </div>
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
