---
const posts = Publr.build.getCollection({ type: 'post', limit: 5 });
---
<section class="rounded-lg border border-line bg-card px-6 py-5">
  <h2 class="text-xs font-semibold tracking-[0.18em] uppercase text-accent">{props.heading ?? "Latest posts"}</h2>
  {posts.length === 0 ? (
    <p class="mt-3 text-sm text-muted">No posts yet.</p>
  ) : null}
  <ul class="mt-3 divide-y divide-line">
    {posts.map((post) => (
      <li class="py-2"><a href={`/posts/${post.slug ?? ""}`} class="font-serif text-lg font-semibold hover:text-accent">{post.title}</a> <span class="ml-2 text-xs text-muted">{post.created_at}</span></li>
    ))}
  </ul>
  <slot />
</section>
