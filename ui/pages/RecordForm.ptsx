import { Editor } from "../layouts/Editor.ptsx";
import { ReferenceDrawer } from "../components/ReferenceDrawer.ptsx";

/** One record, new or existing: the editor fragment (RecordEditor, rendered by the
 * adapter and handed over as a node) inside the editor shell. */
export type RecordFormProps = {
  user_name: string;
  user_email: string;
  /** The rail sections the viewer may open besides Content: set by the server from what
   * the viewer's roles grant. */
  can_structure?: boolean;
  can_settings?: boolean;
  csrf: string;
  title: string;
  /** "content" for a record, "types" for a term. */
  section: string;
  crumb_label: string;
  crumb_href: string;
  editor: JSX.Element;
};

export function RecordForm({
  user_name,
  user_email, can_structure = true, can_settings = true,
  csrf,
  title,
  section,
  crumb_label,
  crumb_href,
  editor,
}: RecordFormProps) {
  return (
    <Editor
      title={title}
      section={section}
      crumb_label={crumb_label}
      crumb_href={crumb_href}
      user_name={user_name}
      user_email={user_email}
      can_structure={can_structure}
      can_settings={can_settings}
      csrf={csrf}
    >
      {editor}
      <ReferenceDrawer />
    </Editor>
  );
}
