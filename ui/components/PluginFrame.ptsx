import { Publr } from "publr-jsx";
import { PluginTour } from "./PluginTour.ptsx";

export const frame_ref = Publr.ref<HTMLIFrameElement>();
export const state = Publr.reactive({
  height: 0,
  plugin: "",
  page: "",
  csrf: "",
  operations: [] as string[],
});

/** Another page of the plugin's, or this one with another query: `notes`, `?week=2`,
 * `notes?week=2`; or an address in the admin, `/admin/roles/add`. Nothing else leaves the
 * frame as an address. */
const page_address = /^([a-z0-9-]{1,48})?(\?[^#]*)?$/;
const admin_address = /^\/admin\/[^\s#]*$/;

export function go(to: string, plugin: string = state.plugin, current: string = state.page) {
  if (admin_address.test(to)) {
    window.location.href = Publr.url(to);
    return;
  }
  const match = page_address.exec(to);
  if (to === "" || !match) return;
  const page = match[1] ?? current;
  if (page === "") return;
  window.location.href = Publr.url(`/admin/plugin/${plugin}/${page}${match[2] ?? ""}`);
}

export async function run(operation: string, input: unknown, csrf: string): Promise<unknown> {
  const dot = operation.indexOf(".");
  const response = await fetch(
    Publr.url(`/api/${operation.slice(0, dot)}/${operation.slice(dot + 1)}`),
    {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", "X-Csrf-Token": csrf },
      body: JSON.stringify(input ?? {}),
    },
  );
  const answer = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(answer.message ?? answer.error ?? `refused (${response.status})`);
  return answer;
}

/** A GROQ read the frame asks for, run by the admin as the plugin for the person looking. */
export async function read(
  frame: HTMLIFrameElement,
  id: number,
  query: string,
  params: unknown,
  plugin: string,
  csrf: string,
) {
  try {
    const response = await fetch(Publr.url(`/admin/plugin/${plugin}/query`), {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", "X-Csrf-Token": csrf },
      body: JSON.stringify({ query, params: params ?? {} }),
    });
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(answer.message ?? answer.error ?? `refused (${response.status})`);
    reply(frame, { id, ok: true, value: answer.result });
  } catch (error) {
    reply(frame, { id, ok: false, error: (error as Error).message });
  }
}

export function reply(frame: HTMLIFrameElement, answer: object) {
  frame.contentWindow?.postMessage(Object.assign({ publr: 1 }, answer), "*");
}

/** Runs what the frame asks when it is one of the plugin's own operations, as the person
 * looking at it, through the same checks as any call. */
export async function answer(
  frame: HTMLIFrameElement,
  id: number,
  operation: string,
  input: unknown,
  operations: string[],
  csrf: string,
) {
  if (!operations.includes(operation)) {
    reply(frame, { id, ok: false, error: `${operation} is not one of this plugin's operations` });
    return;
  }
  try {
    reply(frame, { id, ok: true, value: await run(operation, input, csrf) });
  } catch (error) {
    reply(frame, { id, ok: false, error: (error as Error).message });
  }
}

/** The plugin's own log lines after `after`, newest first: what its code logged as it ran,
 * read as the person looking. Only its own plugin's. */
export async function log(frame: HTMLIFrameElement, id: number, after: number, plugin: string, csrf: string) {
  try {
    const answer = (await run("plugin.log", { name: plugin, limit: 50 }, csrf)) as {
      lines?: Array<{ id: number }>;
    };
    const lines = (answer.lines ?? []).filter((line) => line.id > after);
    reply(frame, { id, ok: true, value: { lines } });
  } catch (error) {
    reply(frame, { id, ok: false, error: (error as Error).message });
  }
}

export const received = (event: MessageEvent) => {
  const frame = frame_ref.current;
  const message = event.data;
  if (!frame || event.source !== frame.contentWindow || !message || message.publr !== 1) return;
  if (message.kind === "hello") reply(frame, { kind: "ready" });
  if (message.kind === "height") state.height = Math.min(Math.max(Number(message.height) || 0, 0), 100000);
  if (message.kind === "navigate") go(String(message.to));
  const id = Number(message.id);
  if (message.kind === "call") answer(frame, id, String(message.operation), message.input, state.operations, state.csrf);
  if (message.kind === "query") read(frame, id, String(message.query), message.params, state.plugin, state.csrf);
  if (message.kind === "log") log(frame, id, Number(message.after) || 0, state.plugin, state.csrf);
  // To the tour player beside it: a message to this window, which only the admin sends.
  if (message.kind === "tour") window.postMessage({ publr_tour: message.steps }, location.origin);
};

export type PluginFrameProps = {
  /** The frame's document. */
  src: string;
  title: string;
  plugin: string;
  page: string;
  csrf: string;
  /** The plugin's own operations: the only ones the frame may ask for. */
  operations: string[];
};

/** A plugin's page in the plugin frame: an opaque, sandboxed iframe that grows with what
 * it shows and talks to the admin only through `received`. */
export function PluginFrame({ src, title, plugin, page, csrf, operations }: PluginFrameProps) {
  state.plugin = plugin;
  state.page = page;
  state.csrf = csrf;
  state.operations = operations;
  state.height = 0;
  return (
    <div class="contents">
      <iframe
        ref={frame_ref}
        src={src}
        title={title}
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
        class="block min-h-full w-full flex-1 border-0"
        style={state.height > 0 ? `height:${state.height}px` : ""}
        onWindowMessage={received}
      ></iframe>
      <PluginTour />
    </div>
  );
}
