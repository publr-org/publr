import { Publr } from "publr-jsx";
export type EditorAsideProps = {
  /** Drawn inside the reference drawer, whose panel scrolls on its own: sticks to its
   * top, not under the page's topbar. */
  in_drawer?: boolean;
  /** Drawn under the form instead of beside it (the block editor's Entry panel): full
   * width, a rule above. */
  stacked?: boolean;
  /** EditorAsideSections, drawn one under the other with a rule between. */
  children?: JSX.Element;
};

/** The editor's right column: the page's actions first, then what is known about the
 * thing being edited, then what cannot be undone. It stays in view while the form
 * scrolls. */
export function EditorAside({ in_drawer = false, stacked = false, children }: EditorAsideProps) {
  return (
    <aside
      aria-label={Publr.t("Actions and details")}
      class={stacked ? "w-full border-t border-border" : "w-80 shrink-0 border-l border-border max-md:w-full max-md:border-t max-md:border-l-0"}
    >
      <div class={["sticky flex flex-col divide-y divide-border", in_drawer ? "top-0" : "top-[var(--sheet-top,3.5rem)]"]}>
        {children}
      </div>
    </aside>
  );
}
