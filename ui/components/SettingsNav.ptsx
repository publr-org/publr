import { Icon } from "@publr/ui/Icon.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type SettingsNavProps = {
  /** The fixed pages first: the system's own settings, then the users. */
  system_active: boolean;
  users_active: boolean;
  /** The agents and tools acting for the viewer's account, or for everyone's. */
  devices_active: boolean;
  plugins_active: boolean;
  /** Structure sits below the users, for whoever may change structure. */
  can_structure: boolean;
  structure_active: boolean;
  /** The pages compiled-in plugins add, for whoever may use them. */
  pages: Array<{ label: string; href: string; icon: IconName; active: boolean }>;
  /** The settings sections defined under Structure, in their order. */
  sections: Array<{ label: string; href: string; active: boolean }>;
};

export function SettingsNav({
  system_active,
  users_active,
  devices_active,
  plugins_active,
  can_structure,
  structure_active,
  pages,
  sections,
}: SettingsNavProps) {
  return (
    <div class="flex flex-col pt-2">
      <SidebarNavItem href="/admin/settings/system" active={system_active}>
        <Icon name="settings" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav">System settings</Text>
      </SidebarNavItem>
      <SidebarNavItem href="/admin/settings/users" active={users_active}>
        <Icon name="users" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav">Users</Text>
      </SidebarNavItem>
      <SidebarNavItem href="/admin/settings/devices" active={devices_active}>
        <Icon name="device-desktop" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav">Devices</Text>
      </SidebarNavItem>
      {can_structure && (
        <SidebarNavItem href="/admin/structure" active={structure_active}>
          <Icon name="components" size="sm" classes="shrink-0" />
          <Text as="span" variant="nav">Structure</Text>
        </SidebarNavItem>
      )}
      <SidebarNavItem href="/admin/settings/plugins" active={plugins_active}>
        <Icon name="package" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav">Plugins</Text>
      </SidebarNavItem>

      {pages.map((page) => (
        <SidebarNavItem href={page.href} active={page.active}>
          <Icon name={page.icon} size="sm" classes="shrink-0" />
          <Text as="span" variant="nav">{page.label}</Text>
        </SidebarNavItem>
      ))}
      {sections.map((section) => (
        <SidebarNavItem href={section.href} active={section.active}>
          <Icon name="file" size="sm" classes="shrink-0" />
          <Text as="span" variant="nav">{section.label}</Text>
        </SidebarNavItem>
      ))}
    </div>
  );
}
