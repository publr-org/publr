import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { ContentAccess } from "../components/ContentAccess.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { IndexSection } from "../components/IndexSection.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginProps = {
  name: string;
  version: string;
  summary: string;
  enabled: boolean;
  /** The version of a newer module waiting to be applied, and its review; empty for none. */
  update: string;
  update_href: string;
  /** The version the last update replaced, to roll back to; empty for none. */
  previous: string;
  enable_href: string;
  disable_action: string;
  rollback_action: string;
  decide_action: string;
  access_action: string;
  remove_action: string;
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  operations: Array<{ name: string }>;
  show_access: boolean;
  scope: string;
  recommend: string;
  note: string;
  types: Array<{ handle: string; name: string; checked: boolean }>;
};

/** One plugin: whether it runs, its versions (an update waiting, the previous one to roll
 * back to), every permission it asked for, granted or revoked one at a time, its content
 * access, and what it brings. Revoking takes effect on its next call. */
export function Plugin({
  name,
  version,
  summary,
  enabled,
  update,
  update_href,
  previous,
  enable_href,
  disable_action,
  rollback_action,
  decide_action,
  access_action,
  remove_action,
  requests,
  operations,
  show_access,
  scope,
  recommend,
  note,
  types,
}: PluginProps) {
  return (
    <FormPage
      title={name}
      parents={[{ label: "Plugins", href: "/admin/settings/plugins" }]}
      description={summary}
      meta={
        <div class="contents">
          {enabled ? <Status tone="success">Enabled</Status> : <Status tone="neutral">Disabled</Status>}
          <Text as="span" variant="body-sm" tone="muted">
            Version {version}
          </Text>
        </div>
      }
      notice={
        update !== "" && (
          <Callout title={`Version ${update} is available`}>
            This version keeps running until you review and apply it.
          </Callout>
        )
      }
      aside={
        <div class="contents">
          <EditorAsideSection>
            {enabled ? (
              <form method="post" action={disable_action}>
                <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                <Button type="submit" hierarchy="secondary" classes="w-full">
                  Disable
                </Button>
              </form>
            ) : (
              <Button href={enable_href} classes="w-full">
                Enable
              </Button>
            )}
          </EditorAsideSection>
          {(update !== "" || previous !== "") && (
            <EditorAsideSection title="Versions">
              {update !== "" && (
                <Button href={update_href} hierarchy="secondary" classes="w-full">
                  Review {update}
                </Button>
              )}
              {previous !== "" && (
                <form method="post" action={rollback_action}>
                  <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                  <Button type="submit" hierarchy="secondary" classes="w-full">
                    Roll back to {previous}
                  </Button>
                </form>
              )}
            </EditorAsideSection>
          )}
        </div>
      }
      danger={
        <ConfirmAction
          label="Remove plugin"
          title={`Remove ${name}?`}
          description="Its operations and hooks stop and its grants go. Its content types and their records stay."
          action={remove_action}
        />
      }
    >
      <IndexSection boxed padded title="Permissions">
        {requests.length > 0 ? (
          <PluginRequests csrf={Publr.request.session.csrf} action={decide_action} requests={requests} />
        ) : (
          <Text as="p" variant="body-sm" tone="muted">
            It asks for nothing beyond its own operations and content types.
          </Text>
        )}
      </IndexSection>
      {show_access && (
        <IndexSection boxed padded title="Content access">
          <form method="post" action={access_action} class="flex flex-col gap-4">
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            <ContentAccess scope={scope} recommend={recommend} note={note} types={types} />
            <div>
              <Button type="submit" hierarchy="secondary">
                Save content access
              </Button>
            </div>
          </form>
        </IndexSection>
      )}
      <IndexSection boxed padded title="Operations">
        <div class="flex flex-wrap gap-2">
          {operations.map((operation) => (
            <Code>{operation.name}</Code>
          ))}
        </div>
      </IndexSection>
    </FormPage>
  );
}
