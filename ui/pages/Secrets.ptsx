import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type SecretsProps = {
  secrets: Array<{
    name: string;
    /** `environment`, `kept` or `missing`. */
    source: string;
    /** The plugins that declare it, joined; empty for none. */
    used_by: string;
    /** Where Remove posts; empty when nothing is kept. */
    remove_action: string;
  }>;
  /** Where the project's key is: `environment`, `file` or `none`. */
  key: string;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  previous_href: string;
  next_href: string;
  /** What the last post did, or why it was refused; empty for nothing. */
  notice: string;
  problem: string;
};

/** The values plugins name but never hold. Each is set here or in the environment, sealed
 * with the project's key, and never shown again. */
export function Secrets({ secrets, key, range, previous_href, next_href, notice, problem }: SecretsProps) {
  return (
    <IndexPage
      title={Publr.t("Secrets")}
      description={Publr.t("Keys plugins use to call other services. A plugin never sees one: it is filled into the request as it leaves.")}
      notice={
        <div class="flex flex-col gap-3">
          {problem !== "" && (
            <Callout tone="error" title={Publr.t("Not saved")}>
              {problem}
            </Callout>
          )}
          {notice !== "" && <Callout title={notice} />}
          {key === "file" && (
            <Callout title={Publr.t("Back up secret.key with the database")}>
              {Publr.t("Values set here are sealed with")} <Code>secret.key</Code>
              {Publr.t(", beside the database.")}{" "}
              {Publr.t("Without it they cannot be read again.")}
            </Callout>
          )}
        </div>
      }
      empty={
        secrets.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("No secrets")}</EmptyTitle>
            <EmptyDescription>
              {Publr.t("A plugin that declares one lists it here; you can also add one below.")}
            </EmptyDescription>
          </Empty>
        )
      }
      footer={
        <div class="flex flex-col gap-4">
          {range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
          <form method="post" action="/admin/settings/secrets/set" class="flex flex-wrap items-end gap-3">
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            <Input name="name" placeholder="STOCKS_API_KEY" classes="w-56" />
            <Input type="password" name="value" placeholder={Publr.t("Value")} classes="w-72" />
            <Button hierarchy="secondary" size="md" type="submit">
              {Publr.t("Add secret")}
            </Button>
          </form>
        </div>
      }
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Secret")}</TableHead>
            <TableHead>{Publr.t("Used by")}</TableHead>
            <TableHead>{Publr.t("Value")}</TableHead>
            <TableHead>{Publr.t("Set a new value")}</TableHead>
            <TableHead />
          </TableRow>
        </TableHeader>
        <TableBody>
          {secrets.map((secret) => (
            <TableRow>
              <TableCell>
                <Code>{secret.name}</Code>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {secret.used_by}
                </Text>
              </TableCell>
              <TableCell>
                {secret.source === "environment" && <Status tone="success">{Publr.t("From the environment")}</Status>}
                {secret.source === "kept" && <Status tone="success">{Publr.t("Set")}</Status>}
                {secret.source === "missing" && <Status tone="warning">{Publr.t("Missing")}</Status>}
              </TableCell>
              <TableCell>
                <form method="post" action="/admin/settings/secrets/set" class="flex items-center gap-2">
                  <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                  <input type="hidden" name="name" value={secret.name} />
                  <Input type="password" name="value" placeholder={Publr.t("Paste a value")} classes="w-56" />
                  <Button hierarchy="secondary" size="sm" type="submit">
                    {Publr.t("Save")}
                  </Button>
                </form>
              </TableCell>
              <TableCell>
                {secret.remove_action !== "" && (
                  <ConfirmAction
                    inline
                    label={Publr.t("Remove")}
                    title={Publr.t("Remove {name}?", { name: secret.name })}
                    description={Publr.t("The plugins that use it stop being able to call out with it.")}
                    action={secret.remove_action}
                  />
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
