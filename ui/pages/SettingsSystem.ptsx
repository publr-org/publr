import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";

export type SettingsSystemProps = {
  /** Whether the viewer may read the activity and error logs: the menu beside the tabs. */
  can_logs?: boolean;
  /** Plugins' pages that are tabs here, after System settings' own; each draws its own
   * page with these tabs over it. */
  plugin_tabs?: Array<{ label: string; href: string }>;
  /** The languages the admin speaks, the site's default selected; empty while it speaks
   * English alone. */
  languages?: Array<{ locale: string; label: string; selected: boolean }>;
  /** Shown after a save. */
  notice?: string;
};

/** The system's own settings, a tabbed page: General, then the tabs plugins' pages add,
 * each a form the admin draws. */
export function SettingsSystem({
  can_logs = false,
  plugin_tabs = [],
  languages = [],
  notice = "",
}: SettingsSystemProps) {
  return (
    <IndexPage
      title={Publr.t("System settings")}
      description={Publr.t("How this Publr runs, and the conventions the site follows.")}
      tabs={
        <TabNav label={Publr.t("System settings")}>
          <TabNavLink href="/admin/settings/system" active={true}>
            {Publr.t("General")}
          </TabNavLink>
          {plugin_tabs.map((item) => (
            <TabNavLink href={item.href} active={false}>
              {item.label}
            </TabNavLink>
          ))}
        </TabNav>
      }
      tab_menu={
        can_logs && (
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <Button type="button" hierarchy="tertiary" size="sm" label={Publr.t("More")} title={Publr.t("More")}>
                <Icon name="more" size="sm" />
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="right">
              <DropdownMenuItem href="/admin/settings/system/activity">{Publr.t("Activity log")}</DropdownMenuItem>
              <DropdownMenuItem href="/admin/settings/system/errors">{Publr.t("Error log")}</DropdownMenuItem>
            </DropdownMenuContent>
          </DropdownMenu>
        )
      }
      notice={
        languages.length > 0 && (
          <form method="post" action="/admin/settings/system" class="flex flex-col gap-4" data-part="admin-language">
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            {notice !== "" && <Callout title={notice} />}
            <Field>
              <FieldLabel htmlFor="admin-language">{Publr.t("Admin language")}</FieldLabel>
              <NativeSelect id="admin-language" name="language">
                {languages.map((language) => (
                  <option value={language.locale} selected={language.selected}>{language.label}</option>
                ))}
              </NativeSelect>
              <FieldDescription>
                {Publr.t("What the admin speaks to everyone who has not chosen a language in their account menu.")}
              </FieldDescription>
            </Field>
            <div>
              <Button type="submit">{Publr.t("Save")}</Button>
            </div>
          </form>
        )
      }
      empty={
        languages.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("Nothing to configure yet")}</EmptyTitle>
            <EmptyDescription>{Publr.t("The site's own settings live in the sections below Users.")}</EmptyDescription>
          </Empty>
        )
      }
    >
    </IndexPage>
  );
}
