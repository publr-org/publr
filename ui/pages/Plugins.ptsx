import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { UploadPlugin } from "../components/UploadPlugin.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginsProps = {
  /** `installed`: the ones loaded at runtime into the sandbox; `built_in`: the ones built
   * into this binary. */
  tab: string;
  /** The plugins built into this binary: always there, full access, nothing to decide. */
  /** `href`: the plugin's own page. */
  built_in: Array<{ name: string; version: string; summary: string; brings: string; href: string }>;
  /** On the Built-in tab: each built-in plugin's remote that is off (`plugin: remote`), and
   * why. */
  off: Array<{ code: string; text: string }>;
  plugins: Array<{
    href: string;
    name: string;
    version: string;
    summary: string;
    enabled: boolean;
    /** How many requests wait for an administrator, as text; empty for none. */
    pending: string;
    /** The version of a newer module waiting to be applied; empty for none. */
    update: string;
    enable_href: string;
    update_href: string;
    disable_action: string;
  }>;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  previous_href: string;
  next_href: string;
};

/** Every plugin added, running or not: enable one to review what it asks for, update one
 * a newer module was uploaded for, stop one. Removing one is on its own page. */
export function Plugins({ tab, built_in, off, plugins, range, previous_href, next_href }: PluginsProps) {
  return (
    <IndexPage
      title={Publr.t("Plugins")}
      footer={range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
      description={
        tab === "installed"
          ? Publr.t("Installed at runtime. Each runs in a sandbox and can do only what you grant it.")
          : Publr.t("Built into this binary: always running, with full access. A new build changes them.")
      }
      actions={tab === "installed" && <UploadPlugin csrf={Publr.request.session.csrf} />}
      notice={
        off.length > 0 && (
          <Callout tone="warning" title={Publr.t("Switched off")} items={off}>
            {Publr.t("These parts answer as unavailable and their hooks don't run until the other plugin fits. The rest works.")}
          </Callout>
        )
      }
      tabs={
        <TabNav label={Publr.t("Plugins")}>
          <TabNavLink href="/admin/settings/plugins" active={tab === "installed"}>
            {Publr.t("Installed")}
          </TabNavLink>
          <TabNavLink href="/admin/settings/plugins/built-in" active={tab === "built_in"}>
            {Publr.t("Built-in")}
          </TabNavLink>
        </TabNav>
      }
      empty={
        (tab === "built_in" && built_in.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("No built-in plugins")}</EmptyTitle>
            <EmptyDescription>{Publr.t("This binary was built without plugins.")}</EmptyDescription>
          </Empty>
        )) ||
        (tab === "installed" && plugins.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("No plugins yet")}</EmptyTitle>
            <EmptyDescription>{Publr.t("Upload a plugin's .wasm file to add it.")}</EmptyDescription>
          </Empty>
        ))
      }
    >
      {tab === "built_in" && (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>{Publr.t("Plugin")}</TableHead>
              <TableHead>{Publr.t("Version")}</TableHead>
              <TableHead>{Publr.t("Brings")}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {built_in.map((row) => (
              <TableRow>
                <TableCell>
                  <Link href={row.href} variant="body-sm" tone="default">
                    {row.name}
                  </Link>
                  <Text as="p" variant="body-sm" tone="muted">
                    {row.summary}
                  </Text>
                </TableCell>
                <TableCell>
                  <Text as="span" variant="mono-xs" tone="muted">
                    {row.version}
                  </Text>
                </TableCell>
                <TableCell>
                  <Text as="span" variant="body-sm" tone="muted">
                    {row.brings}
                  </Text>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}
      {tab === "installed" && (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>{Publr.t("Plugin")}</TableHead>
              <TableHead>{Publr.t("Version")}</TableHead>
              <TableHead>{Publr.t("Status")}</TableHead>
              <TableHead align="right">{Publr.t("Actions")}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {plugins.map((row) => (
              <TableRow>
                <TableCell>
                  <Link href={row.href} variant="body-sm" tone="default">
                    {row.name}
                  </Link>
                  <Text as="p" variant="body-sm" tone="muted">
                    {row.summary}
                  </Text>
                </TableCell>
                <TableCell>
                  <Text as="span" variant="mono-xs" tone="muted">
                    {row.version}
                  </Text>
                </TableCell>
                <TableCell>
                  <div class="flex flex-col items-start gap-1">
                    {row.enabled ? (
                      <Status tone="success">{Publr.t("Enabled")}</Status>
                    ) : (
                      <Status tone="neutral">{Publr.t("Disabled")}</Status>
                    )}
                    {row.update !== "" && <Status tone="review">{Publr.t("Update to {version} available", { version: row.update })}</Status>}
                    {row.enabled && row.pending !== "" && (
                      <Status tone="warning">{Publr.t("{pending} waiting for approval", { pending: row.pending })}</Status>
                    )}
                  </div>
                </TableCell>
                <TableCell align="right">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    {!row.enabled && (
                      <Button href={row.enable_href} size="sm">
                        {Publr.t("Enable")}
                      </Button>
                    )}
                    {row.update !== "" && (
                      <Button href={row.update_href} size="sm" hierarchy="secondary">
                        {Publr.t("Update")}
                      </Button>
                    )}
                    {row.enabled && (
                      <form method="post" action={row.disable_action}>
                        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                        <input type="hidden" name="next" value="list" />
                        <Button type="submit" size="sm" hierarchy="secondary">
                          {Publr.t("Disable")}
                        </Button>
                      </form>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}
    </IndexPage>
  );
}
