import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Input } from "@publr/ui/Input.ptsx";

export const state = Publr.reactive({ shown: false, kind: "password" as "password" | "text" });

export const toggled = () => {
  state.shown = !state.shown;
  state.kind = state.shown ? "text" : "password";
};

export type FieldSecretProps = {
  id: string;
  name: string;
  value: string;
};

/** A password field: masked, with a button that shows what is typed. */
export function FieldSecret({ id, name, value }: FieldSecretProps) {
  return (
    <div class="flex items-center gap-2" data-part="field-secret">
      <Input id={id} name={name} type={state.kind} value={value} placeholder={value === "" ? Publr.t("Not set") : ""} autocomplete="new-password" classes="flex-1" />
      <Button type="button" hierarchy="tertiary" size="sm" label={state.shown ? Publr.t("Hide") : Publr.t("Show")} title={state.shown ? Publr.t("Hide") : Publr.t("Show")} onClick={toggled}>
        <Icon name="eye" size="sm" />
      </Button>
    </div>
  );
}
