import { FormPage } from "@publr/admin/FormPage.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type SamplerSettingsProps = {
  /** The lines the notes' notices left, oldest first. */
  lines: string[];
  /** The port `serve` got, as the sampler's state noted it. */
  port: string;
};

/** The sampler's settings page: a compiled-in plugin's page in the admin's own layouts. */
export function SamplerSettings({ lines, port }: SamplerSettingsProps) {
  return (
    <FormPage title="Sampler" description={`The notes the sampler kept, served on port ${port}.`}>
      <ul class="flex flex-col gap-2">
        {lines.map((line) => (
          <li>
            <Text variant="body-md">{line}</Text>
          </li>
        ))}
      </ul>
    </FormPage>
  );
}
