export type EditorColumnProps = {
  /** A list page: the column takes the whole pane so its rows run edge to edge, and the
   * page pads its own title band. A form page (the default) centres at a capped width. */
  wide?: boolean;
  children?: JSX.Element;
};

/** The editor's form column: takes the sheet beside the aside and centres its content
 * (the title band, then the form) at a capped width. */
export function EditorColumn({ wide = false, children }: EditorColumnProps) {
  return (
    <div class={["min-w-0 flex-1 py-7", wide ? "" : "px-8"]}>
      <div class={["w-full", wide ? "" : "max-w-2xl"]}>{children}</div>
    </div>
  );
}
