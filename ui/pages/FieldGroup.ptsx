import { FormPage } from "../layouts/FormPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { FieldGroupSettings } from "../components/FieldGroupSettings.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";

export type FieldGroupProps = {
  title: string;
  name: string;
  handle: string;
  fresh: boolean;
  back: string;
  action: string;
  delete_action: string;
  /** The group's fields (FieldList, standalone), drawn by the adapter. */
  fields: JSX.Element;
  active: boolean;
  position: string;
  labels: string;
  instructions: string;
  rules: JSX.Element;
};

/** A field group: its name, its fields, and where and how it appears. */
export function FieldGroup({
  title,
  name,
  fresh,
  back,
  action,
  delete_action,
  fields,
  active,
  position,
  labels,
  instructions,
  rules,
}: FieldGroupProps) {
  return (
    <FormPage
      title={title}
      parents={[
        { label: "Structure", href: "/admin/structure" },
        { label: "Custom Fields", href: "/admin/custom-fields" },
      ]}
      aside={
        <EditorAsideSection>
          <Button type="submit" form="group-settings-form" classes="w-full">
            {fresh ? "Create field group" : "Save changes"}
          </Button>
          <Button href={back} hierarchy="tertiary" classes="w-full">
            Cancel
          </Button>
        </EditorAsideSection>
      }
      danger={
        !fresh && (
          <ConfirmAction
            label="Delete field group"
            title={`Delete ${name}?`}
            description="The group and its fields go for good."
            action={delete_action}
          />
        )
      }
    >
      <Field>
        <FieldLabel htmlFor="group-name">Group name</FieldLabel>
        <Input id="group-name" name="name" value={name} form="group-settings-form" required />
      </Field>
      {!fresh && fields}
      <FieldGroupSettings
        fresh={fresh}
        action={action}
        active={active}
        position={position}
        labels={labels}
        instructions={instructions}
        rules={rules}
      />
    </FormPage>
  );
}
