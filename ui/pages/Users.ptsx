import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";

export type UsersProps = {
  users: Array<{
    href: string;
    name: string;
    email: string;
    /** The labels of the account's roles, comma-separated. */
    roles: string;
    /** Signed in at least once; an invited account is inactive until its link is used. */
    active: boolean;
    /** The signed-in user's own row. */
    me: boolean;
  }>;
};

/** Every account, oldest first, and a way to add one. There is always one: whoever looks. */
export function Users({ users }: UsersProps) {
  return (
    <IndexPage
      title="Users"
      description="Who may sign in, and what they may do."
      actions={<Button href="/admin/settings/users/new">Add user</Button>}
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Name</TableHead>
            <TableHead>Email</TableHead>
            <TableHead>Roles</TableHead>
            <TableHead>Status</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {users.map((user) => (
            <TableRow>
              <TableCell>
                <Link href={user.href} variant="body-sm" tone="default">
                  {user.name}
                </Link>
                {user.me && (
                  <Text as="span" variant="body-sm" tone="muted">
                    {" "}
                    (you)
                  </Text>
                )}
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.email}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.roles}
                </Text>
              </TableCell>
              <TableCell>
                {user.active ? (
                  <Status tone="success">Active</Status>
                ) : (
                  <Status tone="warning">Invited</Status>
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
