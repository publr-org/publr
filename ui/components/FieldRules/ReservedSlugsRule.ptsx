import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Textarea } from "@publr/ui/Textarea.ptsx";

export type ReservedSlugsRuleProps = {
  limit_reserved?: boolean;
  reserved?: string;
  reserved_message?: string;
};

export function ReservedSlugsRule({
  limit_reserved = false,
  reserved = "",
  reserved_message = "",
}: ReservedSlugsRuleProps) {
  return (
    <CheckboxField
      id="limit_reserved"
      name="limit_reserved"
      checked={limit_reserved}
      label="Reserve slugs the site keeps for itself"
      description="A record cannot take any of these slugs"
    >
      <Textarea
        id="reserved"
        name="reserved"
        value={reserved}
        rows={4}
        placeholder={"admin\napi\nsearch"}
      />
      <Field>
        <FieldLabel htmlFor="reserved_message">Custom error message</FieldLabel>
        <Input
          id="reserved_message"
          name="reserved_message"
          value={reserved_message}
          maxLength={255}
        />
      </Field>
    </CheckboxField>
  );
}
