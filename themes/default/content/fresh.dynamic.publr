---
// Forced dynamic by its name: nothing here reads Publr.request — the count
// could be built — but `.dynamic.publr` says "render this route per request,
// no matter what". The route is still /fresh; the marker says when, not where.
import Base from '../layouts/base.publr';
import SignedIn from '../dynamic/signed-in.dynamic.publr';
const posts = Publr.build.getCollection({ type: 'post' });
---
<Base title="Fresh · Publr">
  <section class="mx-auto max-w-prose px-6 pt-16 pb-16">
    <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-accent">A forced-dynamic page</p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight">Counted just now: {posts.length} posts.</h1>
    <p class="mt-5 leading-relaxed text-muted">This is <code>content/fresh.dynamic.publr</code>. It reads only <code>Publr.build</code>, so Publr would happily build it — the <code>.dynamic</code> in its name overrides that, and the route renders on every request. The greeting is a dynamic island, written <code>&lt;SignedIn dynamic /&gt;</code> as always; on a dynamic page it is rendered into the response rather than fetched: <SignedIn dynamic /></p>
  </section>
</Base>
