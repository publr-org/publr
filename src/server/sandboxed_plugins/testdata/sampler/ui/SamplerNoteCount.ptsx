import { Publr } from "publr-jsx";
import type { ViewCtx } from "@publr/admin/Document.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type SamplerNoteCountProps = {
  record: string;
  total: number;
  ctx: ViewCtx;
};

/** Who is looking, and how many notes there are, read again after the box adds one: the
 * view's `ctx` in the browser. */
export function SamplerNoteCount({ record, total, ctx }: SamplerNoteCountProps) {
  const state = Publr.reactive({ total: total });
  const counted = ctx.query("sampler.count", () => ({}), { seeded: true });
  const note = ctx.call("sampler.note");
  Publr.effect(() => {
    const read = counted.value;
    if (read) state.total = read.count;
  });
  const add = () => note({ note: "from the panel" });

  return (
    <div class="flex flex-col items-start gap-2">
      <Text variant="body-sm">
        Note {record}, one of {state.total}, looked at by {ctx.person.name}.
      </Text>
      <Button type="button" size="sm" hierarchy="secondary" onClick={add}>
        Add a note
      </Button>
    </div>
  );
}
