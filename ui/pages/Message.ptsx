import { Layout } from "../layouts/Layout.ptsx";
import { EditorColumn } from "../components/EditorColumn.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

/** Every "something went wrong" page: a heading, a line, the problems when the
 * refused thing was a document or a definition, and a way back. */
export type MessageProps = {
  user_name?: string;
  user_email?: string;
  csrf?: string;
  /** The section the refused page belonged to, so the chrome stays where the user was. */
  section: string;
  nav?: JSX.Element;
  heading: string;
  text: string;
  problems: Array<{ path: string; message: string }>;
  link_href: string;
  link_label: string;
};

export function Message({
  user_name,
  user_email,
  csrf,
  section,
  nav,
  heading,
  text,
  problems,
  link_href,
  link_label,
}: MessageProps) {
  return (
    <Layout
      title={heading}
      section={section}
      user_name={user_name}
      user_email={user_email}
      csrf={csrf}
      sidebar={nav}
    >
      <EditorColumn>
        <div>
          <PageHeader title={heading} description={text.length > 0 ? text : undefined}>
            <Button href={link_href} hierarchy="secondary">
              {link_label}
            </Button>
          </PageHeader>
          {problems.length > 0 && (
            <ul class="mt-6 divide-y divide-border rounded-xl border border-border">
              {problems.map((problem) => (
                <li class="flex items-baseline gap-3 px-4 py-3">
                  <Code classes="shrink-0">{problem.path}</Code>
                  <Text variant="body-sm">{problem.message}</Text>
                </li>
              ))}
            </ul>
          )}
        </div>
      </EditorColumn>
    </Layout>
  );
}
