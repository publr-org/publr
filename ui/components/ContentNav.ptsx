import { Publr } from "publr-jsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { SidebarNavEyebrow } from "@publr/ui/SidebarNavEyebrow.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { SidebarNavSubItem } from "@publr/ui/SidebarNavSubItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { PinButton } from "./PinButton.ptsx";

export type ContentNavProps = {
  all_href: string;
  all_active: boolean;
  recent_href: string;
  recent_active: boolean;
  /** The caller's own views: the two that are always there, locked, then the saved ones. */
  private_views: Array<{ label: string; href: string; active: boolean; locked: boolean }>;
  /** The content under each status, across types. */
  statuses: Array<{ label: string; href: string; active: boolean }>;
  /** The record types, each leading to its records; the settings types to their one page. */
  types: Array<{ label: string; href: string; active: boolean; heading: string }>;
  settings: Array<{ label: string; href: string; active: boolean }>;
  /** Plugins' parts of the admin, each some of its types with a sidebar of their own;
   * pinnable to the viewer's rail. */
  sections: Array<{
    label: string;
    href: string;
    icon: IconName;
    plugin: string;
    page: string;
    pinned: boolean;
  }>;
  /** For the pins' forms: the session's token, and this page to come back to. */
  csrf: string;
  back: string;
};

/** The Content section's sidebar: the ways of looking at the content. Recent first; then
 * the caller's private views, the two built in (locked) and the ones they saved; then the
 * views everyone has, as folders counting what is under them: All, the content by status,
 * the content by type; then plugins' sections; then the settings types, each a single page. Rendered once per page
 * by the adapter and handed to the shell as a node, so no array crosses a component
 * boundary. */
export function ContentNav({
  all_href,
  all_active,
  recent_href,
  recent_active,
  private_views,
  statuses,
  types,
  settings,
  sections,
  csrf,
  back,
}: ContentNavProps) {
  return (
    <div class="flex flex-col">
      <SidebarNavItem href={recent_href} active={recent_active} classes="mt-2">
        <Icon name="clock-rewind" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {Publr.t("Recent")}
        </Text>
      </SidebarNavItem>
      <SidebarNavEyebrow>{Publr.t("Private views")}</SidebarNavEyebrow>
      {private_views.map((item) => (
        <SidebarNavItem href={item.href} active={item.active}>
          <Icon name="bookmark" size="sm" classes="shrink-0" />
          <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
            {item.label}
          </Text>
          {item.locked && <Icon name="lock" size="xs" classes="shrink-0" />}
        </SidebarNavItem>
      ))}
      <SidebarNavEyebrow>{Publr.t("Views")}</SidebarNavEyebrow>
      <SidebarNavItem href={all_href} active={all_active}>
        <Icon name="bookmark" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {Publr.t("All")}
        </Text>
      </SidebarNavItem>
      <SidebarNavItem href={all_href}>
        <Icon name="folder" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {Publr.t("Status")}
        </Text>
        <Text as="span" variant="body-sm" tone="muted" classes="shrink-0">
          {statuses.length}
        </Text>
      </SidebarNavItem>
      <div class="flex flex-col pl-3">
        {statuses.map((item) => (
          <SidebarNavSubItem href={item.href} active={item.active}>
            <Icon name="bookmark" size="sm" classes="shrink-0" />
            <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
              {item.label}
            </Text>
          </SidebarNavSubItem>
        ))}
      </div>
      <SidebarNavItem href={all_href}>
        <Icon name="folder" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {Publr.t("Content type")}
        </Text>
        <Text as="span" variant="body-sm" tone="muted" classes="shrink-0">
          {types.length}
        </Text>
      </SidebarNavItem>
      <div class="flex flex-col pl-3">
        {types.map((item) => (
          <div class="contents">
            {item.heading !== "" && (
              <p class="px-2.5 pb-0.5 pt-2" data-part="type-group">
                <Text as="span" variant="body-xs" tone="muted">
                  {item.heading}
                </Text>
              </p>
            )}
            <SidebarNavSubItem href={item.href} active={item.active}>
              <Icon name="bookmark" size="sm" classes="shrink-0" />
              <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
                {item.label}
              </Text>
            </SidebarNavSubItem>
          </div>
        ))}
        {types.length === 0 && (
          <p class="px-2.5 py-1.5">
            <Text variant="body-sm" tone="muted">
              {Publr.t("None yet.")}
            </Text>
          </p>
        )}
      </div>
      {sections.length > 0 && <SidebarNavEyebrow>{Publr.t("Sections")}</SidebarNavEyebrow>}
      {sections.map((section) => (
        <div class="group flex items-center gap-1">
          <SidebarNavItem href={section.href} classes="min-w-0 flex-1">
            <Icon name={section.icon} size="sm" classes="shrink-0" />
            <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
              {section.label}
            </Text>
          </SidebarNavItem>
          <PinButton plugin={section.plugin} page={section.page} pinned={section.pinned} csrf={csrf} back={back} />
        </div>
      ))}
      {settings.length > 0 && <SidebarNavEyebrow>{Publr.t("Settings")}</SidebarNavEyebrow>}
      {settings.map((item) => (
        <SidebarNavItem href={item.href} active={item.active}>
          <Icon name="settings" size="sm" classes="shrink-0" />
          <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
            {item.label}
          </Text>
        </SidebarNavItem>
      ))}
    </div>
  );
}
