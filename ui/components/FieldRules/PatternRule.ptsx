import { Publr } from "publr-jsx";
import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";

export type PatternRuleProps = {
  limit_pattern?: boolean;
  preset?: string;
  pattern?: string;
  pattern_message?: string;
};

export function PatternRule({
  limit_pattern = false,
  preset = "any",
  pattern = "",
  pattern_message = "",
}: PatternRuleProps) {
  return (
    <CheckboxField
      id="limit_pattern"
      name="limit_pattern"
      checked={limit_pattern}
      label={Publr.t("Match a specific shape")}
      description={Publr.t("Accept only text of a given shape: a preset, a pattern, or both")}
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <Field>
          <FieldLabel htmlFor="preset">{Publr.t("Preset")}</FieldLabel>
          <NativeSelect id="preset" name="preset">
            <option value="any" selected={preset === "any"}>
              {Publr.t("Anything")}
            </option>
            <option value="digits" selected={preset === "digits"}>
              {Publr.t("Digits only")}
            </option>
            <option value="letters" selected={preset === "letters"}>
              {Publr.t("Letters only")}
            </option>
            <option value="alphanumeric" selected={preset === "alphanumeric"}>
              {Publr.t("Letters and digits")}
            </option>
            <option value="no_spaces" selected={preset === "no_spaces"}>
              {Publr.t("No spaces")}
            </option>
            <option value="lowercase" selected={preset === "lowercase"}>
              {Publr.t("Lowercase")}
            </option>
            <option value="uppercase" selected={preset === "uppercase"}>
              {Publr.t("Uppercase")}
            </option>
            <option value="phone" selected={preset === "phone"}>
              {Publr.t("Phone number")}
            </option>
          </NativeSelect>
        </Field>
        <Field>
          <FieldLabel htmlFor="pattern">{Publr.t("Pattern")}</FieldLabel>
          <Input
            id="pattern"
            name="pattern"
            value={pattern}
            placeholder="SKU-####"
            maxLength={255}
          />
          <FieldDescription>
            {Publr.t("* any run of characters, ? one character, # a digit, @ a letter")}
          </FieldDescription>
        </Field>
      </div>
      <Field>
        <FieldLabel htmlFor="pattern_message">{Publr.t("Custom error message")}</FieldLabel>
        <Input
          id="pattern_message"
          name="pattern_message"
          value={pattern_message}
          maxLength={255}
        />
      </Field>
    </CheckboxField>
  );
}
