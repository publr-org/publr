import { Badge } from "@publr/ui/Badge.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { PinButton } from "./PinButton.ptsx";

export type SettingsNavProps = {
  /** Every page under Settings the viewer may see, in order: the admin's own, the pages
   * plugins add, the settings sections. Each pinnable to the viewer's rail. */
  pages: Array<{
    label: string;
    href: string;
    icon: IconName;
    active: boolean;
    plugin: string;
    page: string;
    pinned: boolean;
    /** What waits there, as a number (Site Health's cases); empty when nothing does. */
    count: string;
  }>;
  /** For the pins' forms: the session's token, and this page to come back to. */
  csrf: string;
  back: string;
};

export function SettingsNav({ pages, csrf, back }: SettingsNavProps) {
  return (
    <div data-slot="pages" class="flex flex-col pt-2">
      {pages.map((page) => (
        <div class="group flex items-center gap-1">
          <SidebarNavItem href={page.href} active={page.active} classes="min-w-0 flex-1">
            <Icon name={page.icon} size="sm" classes="shrink-0" />
            <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{page.label}</Text>
            {page.count !== "" && <Badge size="xs">{page.count}</Badge>}
          </SidebarNavItem>
          <PinButton plugin={page.plugin} page={page.page} pinned={page.pinned} csrf={csrf} back={back} />
        </div>
      ))}
    </div>
  );
}
