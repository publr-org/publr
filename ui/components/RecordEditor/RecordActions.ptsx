import { Publr } from "publr-jsx";
import { state, onSubmit, cancel_destroy, onPreview } from "../RecordEditor.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { EditorAside } from "../EditorAside.ptsx";
import { EditorAsideSection } from "../EditorAsideSection.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { DropdownMenuSeparator } from "@publr/ui/DropdownMenuSeparator.ptsx";
import { SplitButton } from "@publr/ui/SplitButton.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";

export type RecordActionsProps = {
  in_drawer: boolean;
  is_new: boolean;
  action_route: string;
  csrf: string;
  expected_version: string;
  id: string;
  versions_href: string;
  /** The record's page as it will read once published; empty when no app shows the type. */
  preview_href: string;
  /** Sections the adapter draws for the thing being edited: a record's terms (RecordTerms),
   * a term's parent (TermParent). */
  aside?: JSX.Element;
  /** The dependency dialog (RecordImpact), present under `serve --dev` only. */
  impact?: JSX.Element;
  /** Under the form in one column (a visual record's panel in the block editor). */
  stacked?: boolean;
  /** Offer Schedule: a transition made later (`record.transition_at`). */
  may_schedule?: boolean;

  /** The site's time zone, schedules are typed and shown in: `Europe/Warsaw`. */
  time_zone?: string;
  /** What Schedule… offers (the changes made, the status moves), and the scheduled change
   * it builds on (empty: what is live). */
  schedule_options?: Array<{ value: string; label: string }>;
  schedule_base?: string;
  /** What of the record goes live (RecordLive), at the top of its Publishing section. */
  live?: JSX.Element;
  has_live?: boolean;
};

export function RecordActions({
  in_drawer,
  is_new,
  action_route,
  csrf,
  expected_version,
  id,
  versions_href,
  preview_href,
  aside,
  impact,
  stacked = false,
  may_schedule = false,
  time_zone = "UTC",
  schedule_options = [],
  schedule_base = "",
  live,
  has_live = false,
}: RecordActionsProps) {
  const schedules = may_schedule && schedule_options.length > 0;
  return (
    <EditorAside in_drawer={in_drawer} stacked={stacked}>
      {!is_new && (
        <EditorAsideSection>
          <Dialog classes="flex w-full flex-col gap-3">
          <DropdownMenu>
            {!state.has_primary && (
              <DropdownMenuTrigger asChild>
                <Button type="button" hierarchy="secondary" classes="w-full" disabled={state.submitting}>
                  {Publr.t("Actions")}
                  <Icon name="chevron-down" size="sm" />
                </Button>
              </DropdownMenuTrigger>
            )}
            {state.has_primary && (
            <SplitButton classes="w-full">
              {state.actions.map(
                (item) =>
                  item.primary && (
                    <form
                      method="post"
                      action={action_route}
                      onSubmit={onSubmit}
                      class="flex min-w-0 flex-1"
                    >
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <Button type="submit" attach="start" classes="w-full" disabled={state.submitting}>
                        {item.label}
                      </Button>
                    </form>
                  ),
              )}
              <DropdownMenuTrigger asChild>
                <Button type="button" attach="end" label={Publr.t("More actions")} title={Publr.t("More actions")} disabled={state.submitting}>
                  <Icon name="chevron-down" size="sm" />
                </Button>
              </DropdownMenuTrigger>
            </SplitButton>
            )}
            <DropdownMenuContent align="right">
              {state.actions.map(
                (item) =>
                  !item.primary &&
                  !item.destructive && (
                    <form method="post" action={action_route} onSubmit={onSubmit}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <DropdownMenuItem type="submit" disabled={state.submitting}>{item.label}</DropdownMenuItem>
                    </form>
                  ),
              )}
              {schedules && (
                <DialogTrigger asChild>
                  <DropdownMenuItem>{Publr.t("Schedule…")}</DropdownMenuItem>
                </DialogTrigger>
              )}
              {state.has_destructive && <DropdownMenuSeparator />}
              {state.actions.map(
                (item) =>
                  item.destructive && (
                    <form method="post" action={action_route} onSubmit={onSubmit}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <DropdownMenuItem type="submit" variant="destructive" disabled={state.submitting}>
                        {item.label}
                      </DropdownMenuItem>
                    </form>
                  ),
              )}
            </DropdownMenuContent>
          </DropdownMenu>
          {state.destroy_armed && (
            <Callout tone="error" title={Publr.t("Destroy “{title}” for good?", { title: state.title })}>
              <div class="flex flex-col gap-3">
                <Text as="p" variant="body-sm">
                  {Publr.t("It goes with its changes and versions, and can never be restored.")}
                </Text>
                <form method="post" action={action_route} onSubmit={onSubmit} data-confirmed="true" class="flex gap-2">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="expected_version" value={state.version} />
                  <input type="hidden" name="transition" value="destroy" />
                  <Button type="submit" size="sm" intent="destructive" disabled={state.submitting}>
                    {Publr.t("Destroy for good")}
                  </Button>
                  <Button type="button" size="sm" hierarchy="secondary" onClick={cancel_destroy}>
                    {Publr.t("Cancel")}
                  </Button>
                </form>
              </div>
            </Callout>
          )}
          {schedules && (
            <DialogContent>
              <DialogTitle>{Publr.t("Schedule")}</DialogTitle>
              <DialogDescription>
                {Publr.t("Made then as you, with the rights you hold then. Publish changes takes the record's unpublished changes; only the fields they change go live then.")}
              </DialogDescription>
              {schedules && (
                <form method="post" action={action_route} class="mt-5 flex flex-col gap-4">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="expected_version" value={state.version} />
                  <input type="hidden" name="do" value="schedule" />
                  <input type="hidden" name="base" value={schedule_base} />
                  <Field>
                    <FieldLabel htmlFor="schedule-transition">{Publr.t("Action")}</FieldLabel>
                    <NativeSelect id="schedule-transition" name="transition" label={Publr.t("Action")}>
                      {schedule_options.map((option) => <option value={option.value}>{option.label}</option>)}
                    </NativeSelect>
                  </Field>
                  <Field>
                    <FieldLabel htmlFor="schedule-at">{Publr.t("When ({zone})", { zone: time_zone })}</FieldLabel>
                    <Input id="schedule-at" name="at" type="datetime-local" />
                  </Field>
                  <div class="flex justify-end gap-2">
                    <DialogClose asChild>
                      <Button type="button" hierarchy="secondary">{Publr.t("Close")}</Button>
                    </DialogClose>
                    <Button type="submit">{Publr.t("Schedule")}</Button>
                  </div>
                </form>
              )}
            </DialogContent>
          )}
          </Dialog>
        </EditorAsideSection>
      )}
      {!is_new && (has_live || versions_href !== "" || preview_href !== "") && (
        <EditorAsideSection title={Publr.t("Publishing")}>
          {live}
          {(versions_href !== "" || preview_href !== "") && (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              {preview_href !== "" && (
                <Link href={preview_href} tone="quiet" external
                  classes="inline-flex items-center gap-1.5" onClick={onPreview}>
                  <Icon name="external" size="xs" />
                  {Publr.t("Preview")}
                </Link>
              )}
              {versions_href !== "" && (
                <Link href={versions_href} tone="quiet" classes="inline-flex items-center gap-1.5">
                  <Icon name="clock-rewind" size="xs" />
                  {Publr.t("Versions")}
                </Link>
              )}

            </div>
          )}
        </EditorAsideSection>
      )}
      {is_new && preview_href !== "" && (
        <EditorAsideSection>
          <Link href={preview_href} tone="quiet" external
            classes="inline-flex items-center gap-1.5" onClick={onPreview}>
            <Icon name="external" size="xs" />
            {Publr.t("Preview")}
          </Link>
        </EditorAsideSection>
      )}
      {aside}
      {impact}
    </EditorAside>
  );
}
