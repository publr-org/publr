import { Editor } from "../layouts/Editor.ptsx";
import { EditorAside } from "../components/EditorAside.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { EditorColumn } from "../components/EditorColumn.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { TypeHead } from "../components/TypeHead.ptsx";

export type TypeFormProps = {
  user_name: string;
  user_email: string;
  /** The rail sections the viewer may open besides Content: set by the server from what
   * the viewer's roles grant. */
  can_structure?: boolean;
  can_settings?: boolean;
  top_bar?: JSX.Element;
  csrf: string;
  title: string;
  /** The list the page belongs to: "Content types" at /admin/types, or "Taxonomies". */
  crumb_label: string;
  crumb_href: string;
  /** "content type" or "taxonomy", for the buttons and the dialog. */
  noun: string;
  /** What the page under an existing definition is called: "Fields" or "Terms". */
  back_label: string;
  /** A taxonomy: no kind, no URL; hierarchical or flat, public or not. */
  is_taxonomy: boolean;
  hierarchical: boolean;
  /** A taxonomy: records take one term, not several. */
  single: boolean;
  /** A taxonomy: the record types it may apply to, the ticked ones selected: those with an
   * address on the site, and the others, shown on request (or when one is ticked). */
  applies_routed: Array<{ value: string; label: string; selected: boolean }>;
  applies_other: Array<{ value: string; label: string; selected: boolean }>;
  show_all_types: boolean;
  /** Where the form posts: create, or update of an existing type. */
  action: string;
  is_new: boolean;
  choose_kind: boolean;
  /** What was refused, by path, when the last post did not go through. */
  problems: Array<{ path: string; message: string }>;
  /** The fields page of an existing type, where the settings page leads back. */
  back_href?: string;
  /** Declared by a plugin: the head is fixed, only fields of your own can be added. */
  system: boolean;
  owner: string;
  handle: string;
  name: string;
  description: string;
  /** The counts as the server printed them, and what the last post was refused for per
   * field (empty when nothing was); the rest of the problems are listed above the form. */
  name_count: string;
  handle_count: string;
  description_count: string;
  name_error: string;
  handle_error: string;
  description_error: string;
  /** The type's place on the site (`posts`), and whether it has one. */
  url: string;
  has_url: boolean;
  /** Which kind is chosen; exactly one is true. */
  is_record: boolean;
  is_settings: boolean;
  is_component: boolean;
  base_url: string;
  visibility: string;
  is_public: boolean;
  /** The delete form's action; absent for a new type. */
  delete_action?: string;
};

/** A content type's head: what it is called, what kind it is, who may read it. A new
 * type is created here and continues to its fields; an existing one edits its settings. */
export function TypeForm({
  user_name,
  user_email, can_structure = true, can_settings = true, top_bar,
  csrf,
  title,
  crumb_label,
  crumb_href,
  noun,
  back_label,
  is_taxonomy,
  hierarchical,
  single,
  applies_routed,
  applies_other,
  show_all_types,
  action,
  is_new,
  choose_kind,
  problems,
  back_href,
  system,
  owner,
  handle,
  name,
  description,
  name_count,
  handle_count,
  description_count,
  name_error,
  handle_error,
  description_error,
  url,
  has_url,
  is_record,
  is_settings,
  is_component,
  base_url,
  visibility,
  is_public,
  delete_action,
}: TypeFormProps) {
  return (
    <Editor
      title={title}
      section="types"
      crumb_label={crumb_label}
      crumb_href={crumb_href}
      user_name={user_name}
      user_email={user_email}
      can_structure={can_structure}
      can_settings={can_settings} top_bar={top_bar}
      csrf={csrf}
    >
      <EditorColumn>
        <PageHeader
          title={title}
          back_label={back_href != null ? back_label : undefined}
          back_href={back_href}
        />
        {problems.length > 0 && (
          <div class="mt-6 rounded-xl border border-destructive/30 bg-destructive/5 px-5 py-4">
            <Text as="p" variant="body-sm" tone="error" classes="font-medium">
              The {noun} was not saved.
            </Text>
            <ul class="mt-2 flex flex-col gap-1">
              {problems.map((problem) => (
                <li class="flex items-baseline gap-2">
                  {problem.path !== "" && <Code>{problem.path}</Code>}
                  <Text as="span" variant="body-sm">
                    {problem.message}
                  </Text>
                </li>
              ))}
            </ul>
          </div>
        )}
        {system ? (
          <div class="mt-8 rounded-xl border border-border bg-muted/40 px-5 py-4">
            <Text variant="body-sm" tone="muted">
              Declared by the <strong>{owner}</strong> plugin: handle <Code>{handle}</Code>,{" "}
              {visibility}. Its settings are fixed in code; its declared fields are locked, and you
              can add fields of your own.
            </Text>
          </div>
        ) : (
          <form id="type" method="post" action={action} class="mt-8 space-y-5">
            <input type="hidden" name="csrf" value={csrf} />
            <TypeHead
              is_record={is_record}
              is_settings={is_settings}
              is_component={is_component}
              name={name}
              handle={handle}
              description={description}
              name_count={name_count}
              handle_count={handle_count}
              description_count={description_count}
              name_error={name_error}
              handle_error={handle_error}
              description_error={description_error}
              url={url}
              has_url={has_url}
              base_url={base_url}
              is_new={is_new}
              choose_kind={choose_kind}
              is_taxonomy={is_taxonomy}
              hierarchical={hierarchical}
              is_public={is_public}
              single={single}
              applies_routed={applies_routed}
              applies_other={applies_other}
              show_all_types={show_all_types}
            />
          </form>
        )}
      </EditorColumn>
      <EditorAside>
        {!system && (
          <EditorAsideSection>
            <Button type="submit" form="type" classes="w-full">
              {is_new ? (is_taxonomy ? "Create and add terms" : "Create and add fields") : "Save settings"}
            </Button>
            <Button href={back_href ?? crumb_href} hierarchy="tertiary" classes="w-full">
              Cancel
            </Button>
          </EditorAsideSection>
        )}
        {delete_action && (
          <EditorAsideSection>
            <Dialog>
              <DialogTrigger asChild>
                <Button hierarchy="secondary" intent="destructive" classes="w-full">
                  Delete {noun}
                </Button>
              </DialogTrigger>
              <DialogContent>
                <DialogTitle>Delete {name}?</DialogTitle>
                <DialogDescription>
                  {is_taxonomy
                    ? "The taxonomy goes for good. Its terms stay unless you delete them too; with terms kept, the taxonomy cannot be deleted."
                    : "The type goes for good. Its records stay unless you delete them too; with records kept, the type cannot be deleted."}
                </DialogDescription>
                <form method="post" action={delete_action ?? "#"} class="mt-5 space-y-5">
                  <input type="hidden" name="csrf" value={csrf} />
                  <CheckboxField
                    id="force"
                    name="force"
                    label={is_taxonomy ? "Also delete its terms" : "Also delete its records"}
                  />
                  <div class="flex justify-end gap-2">
                    <DialogClose asChild>
                      <Button hierarchy="secondary">Cancel</Button>
                    </DialogClose>
                    <Button type="submit" intent="destructive">
                      Delete {noun}
                    </Button>
                  </div>
                </form>
              </DialogContent>
            </Dialog>
          </EditorAsideSection>
        )}
      </EditorAside>
    </Editor>
  );
}
