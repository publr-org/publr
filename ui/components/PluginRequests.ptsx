import { Button } from "@publr/ui/Button.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginRequestsProps = {
  csrf: string;
  /** Where Grant, Revoke and Deny post; empty for a list without buttons. */
  action: string;
  requests: Array<{
    key: string;
    sentence: string;
    /** The plugin's own reason, as it wrote it. */
    reason: string;
    /** `low`, `medium` or `high`. */
    tier: string;
    /** `granted`, `pending`, `denied` or `unavailable`; empty on an install page. */
    state: string;
    /** A line under the key: the domains a fetch may reach, what an unavailable key needs. */
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
};

/** What a plugin wants to do, one request a row of a table under its section's heading: what
 * it would do, why ("because it: ..."), the permission's key; then how risky it is, where it
 * stands, and a button for each change an administrator may make. */
export function PluginRequests({ csrf, action, requests }: PluginRequestsProps) {
  return (
    <Table>
      <TableBody>
        {requests.map((request) => (
          <TableRow>
            <TableCell>
              <div class="flex min-w-0 flex-col gap-1 py-1.5" data-key={request.key}>
                <Text as="p" variant="body-md" classes="font-medium">{request.sentence}</Text>
                {request.reason !== "" && (
                  <Text as="p" variant="body-sm" tone="muted">{`because it: “${request.reason}”`}</Text>
                )}
                <div class="flex flex-wrap items-center gap-2 pt-1">
                  <Code>{request.key}</Code>
                  {request.note !== "" && <Text as="span" variant="body-xs" tone="muted">{request.note}</Text>}
                </div>
              </div>
            </TableCell>
            <TableCell align="right">
              <div class="flex flex-wrap items-center justify-end gap-3">
                {request.tier === "high" ? (
                  <Status tone="error">High risk</Status>
                ) : request.tier === "medium" ? (
                  <Status tone="warning">Medium risk</Status>
                ) : (
                  <Status tone="neutral">Low risk</Status>
                )}
                {request.state === "granted" && <Status tone="success">Granted</Status>}
                {request.state === "pending" && <Status tone="review">Pending</Status>}
                {request.state === "denied" && <Status tone="error">Denied</Status>}
                {request.state === "unavailable" && <Status tone="neutral">Unavailable</Status>}
                {action !== "" && request.can_grant && (
                  <form method="post" action={action}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="key" value={request.key} />
                    <input type="hidden" name="change" value="grant" />
                    <Button type="submit" size="sm" hierarchy="secondary">Grant</Button>
                  </form>
                )}
                {action !== "" && request.can_revoke && (
                  <form method="post" action={action}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="key" value={request.key} />
                    <input type="hidden" name="change" value="revoke" />
                    <Button type="submit" size="sm" hierarchy="secondary">Revoke</Button>
                  </form>
                )}
                {action !== "" && request.can_deny && (
                  <form method="post" action={action}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="key" value={request.key} />
                    <input type="hidden" name="change" value="deny" />
                    <Button type="submit" size="sm" hierarchy="tertiary">Deny</Button>
                  </form>
                )}
              </div>
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
