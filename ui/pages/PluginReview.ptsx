import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { ContentAccess } from "../components/ContentAccess.ptsx";
import { IndexSection } from "../components/IndexSection.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";

export type PluginReviewProps = {
  title: string;
  summary: string;
  /** Where Allow posts, and what it says: Allow & Enable, or Allow & Update. */
  action: string;
  allow_label: string;
  /** Where Cancel goes, leaving everything as it is. */
  cancel_href: string;
  /** On an update: a post that drops the newer version; empty otherwise. */
  discard_action: string;
  /** The heading over `requests`: what installing asks, or an update's new permissions. */
  requests_title: string;
  /** What the plugin asks for that it does not hold, low to high. */
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  /** On an update, what it holds already. */
  granted: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  /** What allowing grants, in a sentence. */
  note_text: string;
  /** Whether it asks for content: then the content access choice comes with enabling. */
  show_access: boolean;
  scope: string;
  recommend: string;
  note: string;
  types: Array<{ handle: string; name: string; checked: boolean }>;
};

/** What enabling or updating a plugin grants, before it is done: every request with the
 * plugin's reason and risk, low to high; allowed from the title band. */
export function PluginReview({
  title,
  summary,
  action,
  allow_label,
  cancel_href,
  discard_action,
  requests_title,
  requests,
  granted,
  note_text,
  show_access,
  scope,
  recommend,
  note,
  types,
}: PluginReviewProps) {
  return (
    <IndexPage
      title={title}
      parents={[{ label: "Plugins", href: "/admin/settings/plugins" }]}
      description={summary}
      actions={
        <div class="contents">
          {discard_action !== "" && (
            <ConfirmAction
              inline
              label="Discard this version"
              title="Discard this version?"
              description="The uploaded version goes; the one running stays as it is."
              action={discard_action}
            />
          )}
          {cancel_href !== "" && (
            <Button href={cancel_href} hierarchy="secondary">Cancel</Button>
          )}
          <Button type="submit" form="plugin-review">{allow_label}</Button>
        </div>
      }
      notice={<Callout title="Nothing changes until you allow it">{note_text}</Callout>}
    >
      <IndexSection
        title={requests_title}
        empty={requests.length === 0 ? "Nothing beyond its own operations and content types." : undefined}
      >
        <PluginRequests csrf={Publr.request.session.csrf} action="" requests={requests} />
      </IndexSection>
      {granted.length > 0 && (
        <IndexSection title="It already may">
          <PluginRequests csrf={Publr.request.session.csrf} action="" requests={granted} />
        </IndexSection>
      )}
      <form id="plugin-review" method="post" action={action} class="contents">
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        {show_access && (
          <IndexSection padded title="Content access">
            <ContentAccess scope={scope} recommend={recommend} note={note} types={types} />
          </IndexSection>
        )}
      </form>
    </IndexPage>
  );
}
