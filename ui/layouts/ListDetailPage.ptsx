import { Chrome } from "./Chrome.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { ListDetailBand } from "../components/ListDetailBand.ptsx";
import { ListDetailColumns } from "../components/ListDetailColumns.ptsx";
import { ListDetailDetail } from "../components/ListDetailDetail.ptsx";
import { ListDetailList } from "../components/ListDetailList.ptsx";

export type ListDetailPageProps = {
  title: string;
  parents?: Array<{ label: string; href: string }>;
  /** The band across the top of the detail: what the whole page is about. */
  header?: JSX.Element;
  /** What the list is: its heading where it takes the sidebar's place, and its name for
   * assistive tech: `Conflicts`, `Media`. */
  list_label?: string;
  /** The icon in the list's heading. */
  list_icon?: IconName;
  /** The things worked through, grouped, each leading to its detail (ListDetailGroup,
   * ListDetailItem). Left out when band, list and detail are one island, which draws them
   * itself from the layout's parts (ListDetailBand, ListDetailColumns, ListDetailList,
   * ListDetailDetail) and is the page's only child. */
  list?: JSX.Element;
  /** The one thing open, beside the list; or, without `list`, the whole island. */
  children?: JSX.Element;
  /** Keeps the area's sidebar, as every other page of the area does: a media library on a
   * Settings page. Without it the list takes the sidebar's place. */
  sidebar?: boolean;
};

/** A page that works through a set of things one at a time: the things listed on the left
 * (grouped, the open one marked, done ones checked), the open one's detail on the right
 * under a band. No section sidebar unless asked for: the list takes its place, drawn as a
 * sidebar. A merge's conflicts are worked through this way, and a media library browsed. */
export function ListDetailPage({
  title,
  parents = [],
  header,
  list_label = "",
  list_icon = "list-unordered",
  list,
  children,
  sidebar = false,
}: ListDetailPageProps) {
  return (
    <Chrome title={title} parents={parents} focus={!sidebar}>
      <div class="flex flex-1 flex-col" data-part="list-detail-page">
        {list ? (
          <div class="contents">
            <ListDetailColumns>
              <ListDetailList label={list_label} heading={sidebar ? "" : list_label} heading_icon={list_icon}>
                {list}
              </ListDetailList>
              <ListDetailDetail>
                {header && <ListDetailBand>{header}</ListDetailBand>}
                {children}
              </ListDetailDetail>
            </ListDetailColumns>
          </div>
        ) : (
          children
        )}
      </div>
    </Chrome>
  );
}
