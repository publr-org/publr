import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { CodeBlock } from "@publr/ui/CodeBlock.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";

export type ActivityProps = {
  /** The log shown: `activity`, or `errors`. */
  tab: string;
  /** The entries, newest first. */
  entries: Array<{
    /** The day, `YYYY-MM-DD`, UTC. */
    date: string;
    /** The time of day, `HH:MM:SS`, UTC. */
    time: string;
    who: string;
    operation: string;
    /** What it changed and set off, or the error and its message. */
    what: string;
    /** The input as sent, secrets masked. */
    input: string;
    /** What plugins logged during the call (`ctx.log`), in order. */
    lines: Array<{
      plugin: string;
      /** `info`, `warn` or `err`. */
      level: string;
      line: string;
    }>;
    /** The whole entry as indented JSON, for its dialog. */
    json: string;
  }>;
  /** The next page back, or empty at the oldest. */
  older_href: string;
};

/** One of the two logs, read only: what was done, or what was refused or failed. Reached
 * from the menu beside System settings' tabs. */
export function Activity({ tab, entries, older_href }: ActivityProps) {
  return (
    <IndexPage
      title={Publr.t("Logs")}
      parents={[{ label: Publr.t("System settings"), href: "/admin/settings/system" }]}
      description={Publr.t("Every change made, and every call refused or failed, kept for good. Nothing here can be changed.")}
      tabs={
        <TabNav label={Publr.t("Logs")}>
          <TabNavLink href="/admin/settings/system/activity" active={tab === "activity"}>
            {Publr.t("Activity log")}
          </TabNavLink>
          <TabNavLink href="/admin/settings/system/errors" active={tab === "errors"}>
            {Publr.t("Error log")}
          </TabNavLink>
        </TabNav>
      }
      empty={
        entries.length === 0 && (
          <Empty>
            <EmptyTitle>{tab === "errors" ? Publr.t("No errors") : Publr.t("No activity yet")}</EmptyTitle>
            <EmptyDescription>
              {tab === "errors" ? Publr.t("Nothing has been refused or failed.") : Publr.t("Nothing has been done yet.")}
            </EmptyDescription>
          </Empty>
        )
      }
      footer={
        older_href !== "" && (
          <Button href={older_href} hierarchy="secondary" size="sm">
            {Publr.t("Older")}
          </Button>
        )
      }
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Date")}</TableHead>
            <TableHead>{Publr.t("Time")}</TableHead>
            <TableHead>{Publr.t("Who")}</TableHead>
            <TableHead>{Publr.t("Operation")}</TableHead>
            <TableHead>{tab === "errors" ? Publr.t("Error") : Publr.t("Changed")}</TableHead>
            <TableHead>{Publr.t("Input")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {entries.map((entry) => (
            <TableRow classes="relative cursor-pointer">
              <TableCell classes="whitespace-nowrap">
                <Dialog>
                  <DialogTrigger asChild>
                    <button
                      type="button"
                      aria-label={Publr.t("Open {operation} at {date} {time}", { operation: entry.operation, date: entry.date, time: entry.time })}
                      class="absolute inset-0 cursor-pointer"
                    />
                  </DialogTrigger>
                  <DialogContent classes="max-w-2xl">
                    <DialogTitle>{entry.operation}</DialogTitle>
                    <DialogDescription>{Publr.t("{date} {time} UTC, {who}", { date: entry.date, time: entry.time, who: entry.who })}</DialogDescription>
                    <CodeBlock classes="mt-4 max-h-[60vh] overflow-y-auto">{entry.json}</CodeBlock>
                    <div class="mt-5 flex justify-end">
                      <DialogClose asChild>
                        <Button type="button" hierarchy="secondary">
                          {Publr.t("Close")}
                        </Button>
                      </DialogClose>
                    </div>
                  </DialogContent>
                </Dialog>
                <Text variant="body-sm" tone="muted">
                  {entry.date}
                </Text>
              </TableCell>
              <TableCell classes="whitespace-nowrap">
                <Text variant="body-sm" tone="muted">
                  {entry.time}
                </Text>
              </TableCell>
              <TableCell>
                <Text variant="body-sm">{entry.who}</Text>
              </TableCell>
              <TableCell>
                <Code>{entry.operation}</Code>
              </TableCell>
              <TableCell>
                <Text variant="body-sm">{entry.what}</Text>
                {entry.lines.map((logged) => (
                  <Text variant="body-sm" tone={logged.level === "err" ? "error" : logged.level === "warn" ? "warning" : "muted"}>
                    <Code>{logged.plugin}</Code> {logged.level === "err" ? Publr.t("Error") : logged.level === "warn" ? Publr.t("Warning") : ""} {logged.line}
                  </Text>
                ))}
              </TableCell>
              <TableCell>
                <Code classes="break-all">{entry.input}</Code>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
