import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { ChoiceCard } from "@publr/ui/ChoiceCard.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type DeviceApproveProps = {
  /** What the device calls itself. */
  name: string;
  /** The code it showed its person, `WXYZ-BCDF`, so they can tell it is the same. */
  code: string;
  /** Who it would act for. */
  email: string;
  /** What it asked for, preselected; anything more is not offered. */
  asked: string;
};

/** A device asking to act for the signed-in account: what it is, which code it showed, and
 * what it may do, at most what it asked. Approve or deny, here and nowhere else. */
export function DeviceApprove({ name, code, email, asked }: DeviceApproveProps) {
  return (
    <FormPage
      title={Publr.t("Approve a device")}
      parents={[{ label: Publr.t("Devices"), href: "/admin/settings/devices" }]}
      description={Publr.t("{name} asks to act for {email}. Approve it only if you just started it and it shows the code {code}.", { name, email, code })}
      actions={
        <div class="contents">
          <Button type="submit" form="device-approve" name="decision" value="deny" hierarchy="secondary">
            {Publr.t("Deny")}
          </Button>
          <Button type="submit" form="device-approve" name="decision" value="approve">
            {Publr.t("Approve")}
          </Button>
        </div>
      }
      notice={
        <Callout title={Publr.t("A device never deletes anything for good")}>
          {Publr.t("Deleting a content type, a user or a plugin, or purging content, is done here by a person, whatever the device may do.")}
        </Callout>
      }
    >
      <form id="device-approve" method="post" action="/admin/settings/devices/approve" class="space-y-3">
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        <input type="hidden" name="code" value={code} />
        <Text as="p" variant="body-sm">{Publr.t("What it may do")}</Text>
        <div class="grid gap-3 sm:grid-cols-3">
          <ChoiceCard
            name="scope"
            value="read"
            checked={asked === "read"}
            title={Publr.t("Read")}
            description={Publr.t("See what you can see. It changes nothing.")}
          />
          <ChoiceCard
            name="scope"
            value="drafts"
            checked={asked === "drafts"}
            disabled={asked === "read"}
            title={Publr.t("Save drafts")}
            description={Publr.t("Change content as you could, but nothing goes live until you publish it.")}
          />
          <ChoiceCard
            name="scope"
            value="write"
            checked={asked === "write"}
            disabled={asked !== "write"}
            title={Publr.t("Write and publish")}
            description={Publr.t("Everything you could do, including publishing.")}
          />
        </div>
      </form>
    </FormPage>
  );
}
