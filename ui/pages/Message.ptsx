import { FormPage } from "../layouts/FormPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";

/** Every "something went wrong" page: a heading, a line, the problems when the refused
 * thing was a document or a definition, and a way back. The chrome stays in the area of
 * the address that failed. */
export type MessageProps = {
  heading: string;
  text: string;
  problems: Array<{ code: string; text: string }>;
  link_href: string;
  link_label: string;
};

export function Message({ heading, text, problems, link_href, link_label }: MessageProps) {
  return (
    <FormPage
      title={heading}
      description={text.length > 0 ? text : undefined}
      problems={problems}
      problems_title="What was refused"
      actions={
        <Button href={link_href} hierarchy="secondary">
          {link_label}
        </Button>
      }
    />
  );
}
