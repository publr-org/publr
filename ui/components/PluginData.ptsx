import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { IndexSection } from "./IndexSection.ptsx";

export type PluginDataProps = {
  /** Where a piece in the trash is brought back from. */
  restore_action: string;
  /** What the plugin manages, as the database holds it; `trash` names the entry of a piece
   * in the trash. */
  pieces: Array<{ key: string; label: string; detail: string; trash: string }>;
};

/** A plugin's data: what it manages where it is, and what of it waits in the trash from
 * when it was uninstalled before, each restorable on its own. What happens to each piece
 * is chosen when it is uninstalled. */
export function PluginData({ restore_action, pieces }: PluginDataProps) {
  return (
    <IndexSection padded title={Publr.t("Its data")}>
      {pieces.length === 0 && (
        <Text as="p" variant="body-sm" tone="muted">
          {Publr.t("It keeps no content types, internal records or field groups of its own.")}
        </Text>
      )}
      {pieces.length > 0 && (
        <div class="flex flex-col gap-3">
          {pieces.map((piece) => (
            <div class="flex items-center justify-between gap-4" data-piece={piece.key}>
              <div class="flex min-w-0 flex-col gap-0.5">
                <Text as="p" variant="body-md">{piece.label}</Text>
                <Text as="p" variant="body-sm" tone="muted">{piece.detail}</Text>
              </div>
              {piece.trash !== "" && (
                <form method="post" action={restore_action}>
                  <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                  <input type="hidden" name="piece" value={piece.key} />
                  <Button type="submit" size="sm" hierarchy="secondary">{Publr.t("Restore")}</Button>
                </form>
              )}
            </div>
          ))}
        </div>
      )}
    </IndexSection>
  );
}
