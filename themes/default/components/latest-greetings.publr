---
const greetings = Publr.build.getCollection({ type: 'greeting', limit: 5 });
---
<section class="rounded-lg border border-line bg-card px-6 py-5">
  <h2 class="text-xs font-semibold tracking-[0.18em] uppercase text-accent">{props.heading ?? "Latest greetings"}</h2>
  {greetings.length === 0 ? (
    <p class="mt-3 text-sm text-muted">Nobody has said hello yet.</p>
  ) : null}
  <ul class="mt-3 divide-y divide-line">
    {greetings.map((greeting) => (
      <li class="py-2"><a href={`/greetings/${greeting.slug ?? ""}`} class="font-serif text-lg font-semibold hover:text-accent">{greeting.title}</a> <span class="ml-2 text-xs text-muted">{greeting.created_at}</span></li>
    ))}
  </ul>
  <slot />
</section>
