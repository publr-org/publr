.{
    .name = .publr,
    .version = "0.2.0",
    .fingerprint = 0x5f016c89bf65ce5c,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Sibling checkouts, never URLs: the build fetches nothing.
        .publr_sqlite = .{ .path = "../lib/sqlite" },
        .publr_http = .{ .path = "../lib/http" },
        .publr_auth = .{ .path = "../lib/auth" },
        .publr_deps = .{ .path = "../lib/deps" },
        .publr_wasm = .{ .path = "../lib/wasm" },
        // Build-time: the PJSX compiler lowers ui/ and the design system to Zig; the JIT
        // compiles their classes to the admin stylesheet and merges class stacks at render.
        .pjsx = .{ .path = "../pjsx" },
        .publr_jit = .{ .path = "../jit" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "ui",
        "themes",
        "scripts",
        "vendor",
        "LICENSE",
    },
}
