import { Layout } from "../layouts/Layout.ptsx";
import { EditorColumn } from "../components/EditorColumn.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type SettingsSystemProps = {
  user_name: string;
  user_email: string;
  /** The rail sections the viewer may open besides Content: set by the server from what
   * the viewer's roles grant. */
  can_structure?: boolean;
  can_settings?: boolean;
  top_bar?: JSX.Element;
  csrf: string;
  nav: JSX.Element;
};

/** The system's own settings: a placeholder until there is something to configure. */
export function SettingsSystem({ user_name, user_email, can_structure = true, can_settings = true, top_bar, csrf, nav }: SettingsSystemProps) {
  return (
    <Layout title="System settings" section="settings" sidebar={nav}
      user_name={user_name} user_email={user_email} can_structure={can_structure} can_settings={can_settings} top_bar={top_bar} csrf={csrf}>
      <EditorColumn>
        <PageHeader title="System settings" description="How this Publr runs." />
        <p class="mt-6">
          <Text variant="body-md" tone="muted">
            Nothing to configure yet. The site's own settings live in the sections below Users.
          </Text>
        </p>
      </EditorColumn>
    </Layout>
  );
}
