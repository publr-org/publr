import { SidebarNavEyebrow } from "@publr/ui/SidebarNavEyebrow.ptsx";

export type ListDetailGroupProps = {
  /** What the group's things are: `Content types`, `Lesson`. */
  label: string;
  children?: JSX.Element;
};

/** One group of a ListDetailPage's list: its name, then its items. */
export function ListDetailGroup({ label, children }: ListDetailGroupProps) {
  return (
    <div class="flex flex-col" data-part="list-detail-group">
      <SidebarNavEyebrow>{label}</SidebarNavEyebrow>
      <ul class="flex flex-col">{children}</ul>
    </div>
  );
}
