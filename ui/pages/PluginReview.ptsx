import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { ContentAccess } from "../components/ContentAccess.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { IndexSection } from "../components/IndexSection.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginReviewProps = {
  title: string;
  summary: string;
  /** Where Allow posts, and what it says: Allow & Enable, or Allow & Update. */
  action: string;
  allow_label: string;
  /** Where Cancel goes, leaving everything as it is. */
  cancel_href: string;
  /** On an update: a post that drops the newer version; empty otherwise. */
  discard_action: string;
  /** The heading over `requests`: what installing asks, or an update's new permissions. */
  requests_title: string;
  /** What the plugin asks for that it does not hold, low to high. */
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  /** On an update, what it holds already. */
  granted: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  /** What allowing grants, in a sentence. */
  note_text: string;
  /** Whether it asks for content: then the content access choice comes with enabling. */
  show_access: boolean;
  scope: string;
  recommend: string;
  note: string;
  types: Array<{ handle: string; name: string; checked: boolean }>;
};

/** What enabling or updating a plugin grants, before it is done: every request with the
 * plugin's reason and tier, low to high; allowed from the aside. */
export function PluginReview({
  title,
  summary,
  action,
  allow_label,
  cancel_href,
  discard_action,
  requests_title,
  requests,
  granted,
  note_text,
  show_access,
  scope,
  recommend,
  note,
  types,
}: PluginReviewProps) {
  return (
    <FormPage
      title={title}
      parents={[{ label: "Plugins", href: "/admin/settings/plugins" }]}
      description={summary}
      notice={<Callout title="Nothing changes until you allow it">{note_text}</Callout>}
      aside={
        <EditorAsideSection>
          <Button type="submit" form="plugin-review" classes="w-full">
            {allow_label}
          </Button>
          {cancel_href !== "" && (
            <Button href={cancel_href} hierarchy="tertiary" classes="w-full">
              Cancel
            </Button>
          )}
        </EditorAsideSection>
      }
      danger={
        discard_action !== "" && (
          <ConfirmAction
            label="Discard this version"
            title="Discard this version?"
            description="The uploaded version goes; the one running stays as it is."
            action={discard_action}
          />
        )
      }
    >
      <IndexSection boxed padded title={requests_title}>
        {requests.length > 0 ? (
          <PluginRequests csrf={Publr.request.session.csrf} action="" requests={requests} />
        ) : (
          <Text as="p" variant="body-sm" tone="muted">
            Nothing beyond its own operations and content types.
          </Text>
        )}
      </IndexSection>
      {granted.length > 0 && (
        <IndexSection boxed padded title="Already granted">
          <PluginRequests csrf={Publr.request.session.csrf} action="" requests={granted} />
        </IndexSection>
      )}
      <form id="plugin-review" method="post" action={action} class="flex flex-col gap-5">
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        {show_access && <ContentAccess scope={scope} recommend={recommend} note={note} types={types} />}
      </form>
    </FormPage>
  );
}
