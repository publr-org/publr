import { Publr } from "publr-jsx";
import { state, onSubmit, cancel_destroy, onPreview } from "../RecordEditor.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { EditorAside } from "../EditorAside.ptsx";
import { EditorAsideSection } from "../EditorAsideSection.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { DropdownMenuSeparator } from "@publr/ui/DropdownMenuSeparator.ptsx";
import { SplitButton } from "@publr/ui/SplitButton.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type RecordActionsProps = {
  in_drawer: boolean;
  is_new: boolean;
  action_route: string;
  csrf: string;
  expected_version: string;
  id: string;
  versions_href: string;
  /** The record's page as it will read once published; empty when no app shows the type. */
  preview_href: string;
  /** Sections the adapter draws for the thing being edited: a record's terms (RecordTerms),
   * a term's parent (TermParent). */
  aside?: JSX.Element;
  /** The dependency dialog (RecordImpact), present under `serve --dev` only. */
  impact?: JSX.Element;
  /** Under the form in one column (a visual record's panel in the block editor). */
  stacked?: boolean;
};

export function RecordActions({
  in_drawer,
  is_new,
  action_route,
  csrf,
  expected_version,
  id,
  versions_href,
  preview_href,
  aside,
  impact,
  stacked = false,
}: RecordActionsProps) {
  return (
    <EditorAside in_drawer={in_drawer} stacked={stacked}>
      {!is_new && (
        <EditorAsideSection>
          <DropdownMenu>
            {!state.has_primary && (
              <DropdownMenuTrigger asChild>
                <Button type="button" hierarchy="secondary" classes="w-full" disabled={state.submitting}>
                  {Publr.t("Actions")}
                  <Icon name="chevron-down" size="sm" />
                </Button>
              </DropdownMenuTrigger>
            )}
            {state.has_primary && (
            <SplitButton classes="w-full">
              {state.actions.map(
                (item) =>
                  item.primary && (
                    <form
                      method="post"
                      action={action_route}
                      onSubmit={onSubmit}
                      class="flex min-w-0 flex-1"
                    >
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <Button type="submit" attach="start" classes="w-full" disabled={state.submitting}>
                        {item.label}
                      </Button>
                    </form>
                  ),
              )}
              <DropdownMenuTrigger asChild>
                <Button type="button" attach="end" label={Publr.t("More actions")} title={Publr.t("More actions")} disabled={state.submitting}>
                  <Icon name="chevron-down" size="sm" />
                </Button>
              </DropdownMenuTrigger>
            </SplitButton>
            )}
            <DropdownMenuContent align="right">
              {state.actions.map(
                (item) =>
                  !item.primary &&
                  !item.destructive && (
                    <form method="post" action={action_route} onSubmit={onSubmit}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <DropdownMenuItem type="submit" disabled={state.submitting}>{item.label}</DropdownMenuItem>
                    </form>
                  ),
              )}
              {state.has_destructive && <DropdownMenuSeparator />}
              {state.actions.map(
                (item) =>
                  item.destructive && (
                    <form method="post" action={action_route} onSubmit={onSubmit}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="expected_version" value={state.version} />
                      <input type="hidden" name={item.name} value={item.value} />
                      <DropdownMenuItem type="submit" variant="destructive" disabled={state.submitting}>
                        {item.label}
                      </DropdownMenuItem>
                    </form>
                  ),
              )}
            </DropdownMenuContent>
          </DropdownMenu>
          {state.destroy_armed && (
            <Callout tone="error" title={Publr.t("Destroy “{title}” for good?", { title: state.title })}>
              <div class="flex flex-col gap-3">
                <Text as="p" variant="body-sm">
                  {Publr.t("It goes with its changes and versions, and can never be restored.")}
                </Text>
                <form method="post" action={action_route} onSubmit={onSubmit} data-confirmed="true" class="flex gap-2">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="expected_version" value={state.version} />
                  <input type="hidden" name="transition" value="destroy" />
                  <Button type="submit" size="sm" intent="destructive" disabled={state.submitting}>
                    {Publr.t("Destroy for good")}
                  </Button>
                  <Button type="button" size="sm" hierarchy="secondary" onClick={cancel_destroy}>
                    {Publr.t("Cancel")}
                  </Button>
                </form>
              </div>
            </Callout>
          )}
          {state.parks && (
            <Text as="p" variant="body-xs" tone="muted">
              {Publr.t("Edits are saved as pending changes; the live version stays until you publish.")}
            </Text>
          )}
          {(versions_href !== "" || preview_href !== "") && (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              {preview_href !== "" && (
                <Link href={preview_href} tone="quiet" external
                  classes="inline-flex items-center gap-1.5" onClick={onPreview}>
                  <Icon name="external" size="xs" />
                  {Publr.t("Preview")}
                </Link>
              )}
              {versions_href !== "" && (
                <Link href={versions_href} tone="quiet" classes="inline-flex items-center gap-1.5">
                  <Icon name="clock-rewind" size="xs" />
                  {Publr.t("Versions")}
                </Link>
              )}
            </div>
          )}
        </EditorAsideSection>
      )}
      {is_new && preview_href !== "" && (
        <EditorAsideSection>
          <Link href={preview_href} tone="quiet" external
            classes="inline-flex items-center gap-1.5" onClick={onPreview}>
            <Icon name="external" size="xs" />
            {Publr.t("Preview")}
          </Link>
        </EditorAsideSection>
      )}
      {aside}
      {impact}
    </EditorAside>
  );
}
