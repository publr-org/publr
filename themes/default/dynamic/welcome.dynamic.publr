---
// Dynamic: reads the session, and the newest post through the dynamic API.
// With `prerender`, the build renders this as a visitor nobody knows: the
// posts resolve (the store is there at build), the session is null, and a
// prop from the call site stands in for what the build cannot know.
const session = Publr.request.session;
const latest = Publr.request.getCollection({ type: 'post', limit: 1 });
---
<p class="text-sm text-muted">Tailored for <strong class="font-medium text-ink">{session.email ?? props.fallbackWho ?? "a guest"}</strong> · the newest post: {latest.map((post) => (<a href={`/posts/${post.slug ?? ""}`} class="underline hover:text-accent">{post.title}</a>))}</p>
