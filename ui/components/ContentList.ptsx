import { DataTable } from "@publr/ui/DataTable.ptsx";
import type { DataTableProps } from "@publr/ui/DataTable.ptsx";
import { onNavigate } from "@publr/ui/DataTable.ptsx";
import { BulkActions } from "@publr/ui/BulkActions.ptsx";
import { BulkActionsClear } from "@publr/ui/BulkActionsClear.ptsx";
import { BulkActionsItem } from "@publr/ui/BulkActionsItem.ptsx";
import { BulkActionsSeparator } from "@publr/ui/BulkActionsSeparator.ptsx";
import { Toast } from "@publr/ui/Toast.ptsx";
import { Publr } from "publr-jsx";
import { send } from "publr/operations";
import { IndexHeader } from "./IndexHeader.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuSeparator } from "@publr/ui/DropdownMenuSeparator.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { DropdownMenuSearch } from "@publr/ui/DropdownMenuSearch.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";

export type ContentListProps = {
  csrf: string;
  /** The view's name: a saved view's, a type's, a built-in view's, or the whole content. */
  title: string;
  /** The list's own address, the filters in force written one way, for the history. */
  address: string;
  shown_text: string;
  /** The view menu: a saved view of the caller's own, whether the filters in force differ
   * from it (or from the built-in view), and where each of its actions goes. */
  is_saved: boolean;
  view_id: string;
  view_changed: boolean;
  base_href: string;
  filters_query: string;
  copy_name: string;
  save_href: string;
  delete_href: string;
  rename_href: string;
  /** A type's default view is open (its handle): saving changes saves where its list
   * starts. Whether the caller saved their own, whether administrators saved everyone's. */
  default_type: string;
  own_default: boolean;
  everyone_default: boolean;
  /** Administrators save, copy and reset for everyone too. */
  is_admin: boolean;
  /** The saved view open was made for everyone: only administrators change it. */
  view_shared: boolean;
  /** One record type in scope: a button; several: a menu of them. */
  new_href: string;
  new_label: string;
  new_targets: Array<{ label: string; href: string }>;
  show_type: boolean;
  columns: Required<DataTableProps>["columns"];
  rows: Required<DataTableProps>["rows"];
  filters: Required<DataTableProps>["filters"];
  hidden: Required<DataTableProps>["hidden"];
  search: string;
  add_filters: Required<DataTableProps>["add_filters"];
  empty_text: string;
  /** How many records the filters match, every page together. */
  total: number;
  /** The filters in force as `record.transition_many` takes them, to transition every match. */
  match_type: string;
  match_types: string[];
  match_filters: string[];
  match_search: string;
  /** The statuses records can change to, for the selection's actions: the action's name
   * and the status's. */
  transitions: Array<{ name: string; label: string; status: string }>;
  pages: Required<DataTableProps>["pages"];
  previous_href: string;
  next_href: string;
  range_text: string;
  sort_options: Required<DataTableProps>["sort_options"];
  direction_options: Required<DataTableProps>["direction_options"];
  page_size_options: Required<DataTableProps>["page_size_options"];
  properties: Required<DataTableProps>["properties"];
};

type Conditions = { type: string; types: string[]; filters: string[]; search: string };

type Transitioned = {
  moved: number;
  not_moved: number;
  failed: Array<{ id: string; title: string; why: string }>;
};

export const state = Publr.reactive({
  title: "",
  shown_text: "",
  is_saved: false,
  view_changed: false,
  base_href: "",
  filters_query: "",
  copy_name: "",
  save_href: "",
  delete_href: "",
  rename_href: "",
  default_type: "",
  own_default: false,
  everyone_default: false,
  is_admin: false,
  view_shared: false,
  new_href: "",
  new_label: "",
  new_targets: [] as ContentListProps["new_targets"],
  conditions: { type: "", types: [], filters: [], search: "" } as Conditions,
  transitions: [] as ContentListProps["transitions"],
  transitioning: false,
  note: "",
  /** The table's selection, as its `datatableselectionchange` reports it. */
  selected_ids: [] as string[],
  all_matching: false,
});

export const onDatatableload = (event: Event) => {
  if (
    !(event instanceof CustomEvent) ||
    !(event.target instanceof HTMLElement) ||
    event.target.dataset.part !== "data-table" ||
    !event.detail
  )
    return;
  state.title = event.detail.title;
  state.shown_text = event.detail.shown_text;
  state.is_saved = event.detail.is_saved;
  state.view_changed = event.detail.view_changed;
  state.base_href = event.detail.base_href;
  state.filters_query = event.detail.filters_query;
  state.copy_name = event.detail.copy_name;
  state.save_href = event.detail.save_href;
  state.delete_href = event.detail.delete_href;
  state.rename_href = event.detail.rename_href;
  state.default_type = event.detail.default_type;
  state.own_default = event.detail.own_default;
  state.everyone_default = event.detail.everyone_default;
  state.is_admin = event.detail.is_admin;
  state.view_shared = event.detail.view_shared;
  state.new_href = event.detail.new_href;
  state.new_label = event.detail.new_label;
  state.new_targets = event.detail.new_targets;
  state.conditions = event.detail.conditions;
};

export const onDatatableselectionchange = (event: Event) => {
  if (!(event instanceof CustomEvent) || !event.detail) return;
  state.selected_ids = event.detail.selectedRowIds;
  state.all_matching = event.detail.allMatching;
};

/** The selection's records in one call: the ones ticked, or every match when the whole
 * of it is selected. */
const transition_selection = async (transition: string): Promise<Transitioned> => {
  if (!state.all_matching) {
    return (await send("record.transition_many", { transition, ids: [...state.selected_ids] })) as Transitioned;
  }
  const { type, types, filters, search } = state.conditions;
  return (await send("record.transition_many", {
    transition,
    matching: true,
    type: type || undefined,
    types,
    filters,
    search: search || undefined,
  })) as Transitioned;
};

let note_timer: ReturnType<typeof setTimeout> | undefined;

export const transitionSelected = async (event: Event) => {
  const button = event.currentTarget as HTMLButtonElement;
  const name = button.value;
  const label = state.transitions.find((transition) => transition.name === name)?.status ?? name;
  if (!name || state.transitioning) return;
  state.transitioning = true;
  clearTimeout(note_timer);
  try {
    state.note = Publr.t("Changing status…");
    const done = await transition_selection(name);
    state.note =
      done.not_moved === 0
        ? Publr.tn("{count} changed to {status}", "{count} changed to {status}", done.moved, { status: label })
        : Publr.tn("{count} changed to {status}, {failed} could not change: {why}", "{count} changed to {status}, {failed} could not change: {why}", done.moved, {
            status: label,
            failed: done.not_moved,
            why: done.failed[0]?.why ?? "",
          });
  } catch (error) {
    state.note = Publr.t("Not done: {reason}", { reason: (error as Error).message });
  } finally {
    state.transitioning = false;
  }
  button.dispatchEvent(new CustomEvent("datatablereload", { bubbles: true }));
  clearTimeout(note_timer);
  note_timer = setTimeout(() => (state.note = ""), 5000);
};

Publr.effect(() => {
  if (typeof document !== "undefined") document.title = `${state.title} · ${document.title.split(" · ").pop() ?? "Publr"}`;
});

export function ContentList({
  csrf,
  title,
  address,
  shown_text,
  is_saved,
  view_id,
  view_changed,
  base_href,
  filters_query,
  copy_name,
  save_href,
  delete_href,
  rename_href,
  default_type,
  own_default,
  everyone_default,
  is_admin,
  view_shared,
  new_href,
  new_label,
  new_targets,
  show_type,
  columns,
  rows,
  filters,
  hidden,
  search,
  add_filters,
  empty_text,
  total,
  match_type,
  match_types,
  match_filters,
  match_search,
  transitions,
  pages,
  previous_href,
  next_href,
  range_text,
  sort_options,
  direction_options,
  page_size_options,
  properties,
}: ContentListProps) {
  state.title = title;
  state.shown_text = shown_text;
  state.is_saved = is_saved;
  state.view_changed = view_changed;
  state.base_href = base_href;
  state.filters_query = filters_query;
  state.copy_name = copy_name;
  state.save_href = save_href;
  state.delete_href = delete_href;
  state.rename_href = rename_href;
  state.default_type = default_type;
  state.own_default = own_default;
  state.everyone_default = everyone_default;
  state.is_admin = is_admin;
  state.view_shared = view_shared;
  state.new_href = new_href;
  state.new_label = new_label;
  state.new_targets = new_targets;
  state.conditions = {
    type: match_type,
    types: match_types,
    filters: match_filters,
    search: match_search,
  };
  state.transitions = transitions;

  return (
    <div
      data-part="content-list"
      class="flex flex-1 flex-col"
      onDatatableload={onDatatableload}
      onDatatableselectionchange={onDatatableselectionchange}
    >
      <DataTable
        address={address}
        columns={columns}
        rows={rows}
        filters={filters}
        hidden={hidden}
        search={search}
        add_filters={add_filters}
        empty_text={empty_text}
        total={total}
        pages={pages}
        previous_href={previous_href}
        next_href={next_href}
        range_text={range_text}
        sort_options={sort_options}
        direction_options={direction_options}
        page_size_options={page_size_options}
        properties={properties}
        selectable
        bulk={
          <BulkActions>
            {state.transitions.map((transition) => (
              <span key={transition.name} class="contents">
                {transition.name !== "trash" && (
                  <BulkActionsItem value={transition.name} onClick={transitionSelected} disabled={state.transitioning}>
                    {transition.label}
                  </BulkActionsItem>
                )}
              </span>
            ))}
            <BulkActionsSeparator />
            {state.transitions.some((transition) => transition.name === "trash") && (
              <BulkActionsItem variant="destructive" value="trash" onClick={transitionSelected} disabled={state.transitioning}>
                <Icon name="trash" size="xs" />
                {Publr.t("Delete")}
              </BulkActionsItem>
            )}
            <BulkActionsClear />
          </BulkActions>
        }
      >
        <IndexHeader
          title={state.title}
          description={state.shown_text}
          actions={
            <div class="contents">
              {state.is_saved && (
                <Dialog>
                  <DialogTrigger asChild>
                    <Button
                      type="button"
                      hierarchy="tertiary"
                      size="md"
                      label={Publr.t("Rename view")}
                      title={Publr.t("Rename view")}
                    >
                      <Icon name="edit" size="sm" />
                    </Button>
                  </DialogTrigger>
                  <DialogContent>
                    <DialogTitle>{Publr.t("Rename view")}</DialogTitle>
                    <DialogDescription>
                      {Publr.t("The name is yours alone: views are private.")}
                    </DialogDescription>
                    <form method="post" action={state.rename_href}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <Field classes="mt-4">
                        <FieldLabel htmlFor="rename-view-name">{Publr.t("Name")}</FieldLabel>
                        <Input
                          id="rename-view-name"
                          name="name"
                          value={state.title}
                          required
                          maxLength={80}
                        />
                      </Field>
                      <div class="mt-5 flex justify-end gap-2">
                        <DialogClose asChild>
                          <Button type="button" hierarchy="secondary">
                            {Publr.t("Cancel")}
                          </Button>
                        </DialogClose>
                        <Button type="submit">{Publr.t("Rename")}</Button>
                      </div>
                    </form>
                  </DialogContent>
                </Dialog>
              )}
              <Dialog>
                <DropdownMenu>
                  <DropdownMenuTrigger asChild>
                    <Button type="button" hierarchy="secondary">
                      {state.view_changed && (
                        <span
                          aria-hidden="true"
                          data-part="button-mark"
                          class="absolute -top-1 -right-1 size-2.5 rounded-full border-2 border-card bg-primary"
                        />
                      )}
                      <Icon name="bookmark" size="sm" />
                      <span>{Publr.t("View")}</span>
                      <Icon name="chevron-down" size="xs" />
                    </Button>
                  </DropdownMenuTrigger>
                  <DropdownMenuContent align="right">
                    {state.is_saved && state.view_changed && (!state.view_shared || state.is_admin) && (
                      <form method="post" action={state.save_href}>
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="filters" value={state.filters_query} />
                        <DropdownMenuItem type="submit">
                          <Icon name="bookmark" size="sm" />
                          {Publr.t("Save changes to this view")}
                        </DropdownMenuItem>
                      </form>
                    )}
                    {state.default_type !== "" && state.view_changed && (
                      <form method="post" action="/admin/default-views/save">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="type" value={state.default_type} />
                        <input type="hidden" name="filters" value={state.filters_query} />
                        <DropdownMenuItem type="submit">
                          <Icon name="bookmark" size="sm" />
                          {state.is_admin ? Publr.t("Save changes just for me") : Publr.t("Save changes")}
                        </DropdownMenuItem>
                      </form>
                    )}
                    {state.default_type !== "" && state.view_changed && state.is_admin && (
                      <form method="post" action="/admin/default-views/save">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="type" value={state.default_type} />
                        <input type="hidden" name="filters" value={state.filters_query} />
                        <input type="hidden" name="for_everyone" value="1" />
                        <DropdownMenuItem type="submit">
                          <Icon name="users" size="sm" />
                          {Publr.t("Save changes for everyone")}
                        </DropdownMenuItem>
                      </form>
                    )}
                    <DialogTrigger asChild>
                      <DropdownMenuItem>
                        <Icon name="plus" size="sm" />
                        {state.is_saved ? Publr.t("Create new view") : Publr.t("Copy view")}
                      </DropdownMenuItem>
                    </DialogTrigger>
                    <DropdownMenuSeparator />
                    {state.view_changed ? (
                      <DropdownMenuItem onClick={onNavigate} href={state.base_href}>
                        <Icon name="reset" size="sm" />
                        {Publr.t("Clear changes")}
                      </DropdownMenuItem>
                    ) : (
                      <DropdownMenuItem disabled>
                        <Icon name="reset" size="sm" />
                        {Publr.t("Clear changes")}
                      </DropdownMenuItem>
                    )}
                    {state.default_type !== "" && state.own_default && (
                      <form method="post" action="/admin/default-views/reset">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="type" value={state.default_type} />
                        <DropdownMenuItem type="submit">
                          <Icon name="reset" size="sm" />
                          {Publr.t("Reset to default")}
                        </DropdownMenuItem>
                      </form>
                    )}
                    {state.default_type !== "" && state.everyone_default && state.is_admin && (
                      <form method="post" action="/admin/default-views/reset">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="type" value={state.default_type} />
                        <input type="hidden" name="for_everyone" value="1" />
                        <DropdownMenuItem type="submit">
                          <Icon name="reset" size="sm" />
                          {Publr.t("Reset to default for everyone")}
                        </DropdownMenuItem>
                      </form>
                    )}
                    {state.is_saved && (!state.view_shared || state.is_admin) && (
                      <form method="post" action={state.delete_href}>
                        <input type="hidden" name="csrf" value={csrf} />
                        <DropdownMenuItem type="submit" variant="destructive">
                          <Icon name="trash" size="sm" />
                          {Publr.t("Delete view")}
                        </DropdownMenuItem>
                      </form>
                    )}
                  </DropdownMenuContent>
                </DropdownMenu>
                <DialogContent>
                  <DialogTitle>{state.is_saved ? Publr.t("New view") : Publr.t("Copy view")}</DialogTitle>
                  <DialogDescription>
                    {state.is_admin
                      ? Publr.t("The view as it is now is saved under this name, for you or for everyone.")
                      : Publr.t("The view as it is now is saved under this name, for you alone.")}
                  </DialogDescription>
                  <form method="post" action="/admin/views/create">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="filters" value={state.filters_query} />
                    <Field classes="mt-4">
                      <FieldLabel htmlFor="new-view-name">{Publr.t("Name")}</FieldLabel>
                      <Input
                        id="new-view-name"
                        name="name"
                        value={state.copy_name}
                        required
                        maxLength={80}
                      />
                    </Field>
                    {state.is_admin && (
                      <Field classes="mt-4">
                        <FieldLabel htmlFor="new-view-for">{Publr.t("Who sees it")}</FieldLabel>
                        <NativeSelect id="new-view-for" name="for_everyone" size="md">
                          <option value="0">{Publr.t("Just for me")}</option>
                          <option value="1">{Publr.t("For everyone")}</option>
                        </NativeSelect>
                      </Field>
                    )}
                    <div class="mt-5 flex justify-end gap-2">
                      <DialogClose asChild>
                        <Button type="button" hierarchy="secondary">
                          {Publr.t("Cancel")}
                        </Button>
                      </DialogClose>
                      <Button type="submit">{Publr.t("Save view")}</Button>
                    </div>
                  </form>
                </DialogContent>
              </Dialog>

              <>
                {state.new_href !== "" && (
                  <Button href={state.new_href}>
                    <Icon name="plus" size="sm" />
                    <span>{state.new_label}</span>
                  </Button>
                )}
                {state.new_targets.length > 0 && (
                  <DropdownMenu>
                    <DropdownMenuTrigger asChild>
                      <Button type="button">
                        <Icon name="plus" size="sm" />
                        <span>{state.new_label}</span>
                        <Icon name="chevron-down" size="xs" />
                      </Button>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent align="right">
                      {state.new_targets.length >= 8 && (
                        <DropdownMenuSearch placeholder={Publr.t("Search types")} />
                      )}
                      {state.new_targets.map((target) => (
                        <DropdownMenuItem key={target.href} href={target.href}>
                          <Icon name="file" size="sm" />
                          {target.label}
                        </DropdownMenuItem>
                      ))}
                    </DropdownMenuContent>
                  </DropdownMenu>
                )}
              </>
            </div>
          }
        />
      </DataTable>
      {state.note && (
        <div class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4">
          <Toast>{state.note}</Toast>
        </div>
      )}
    </div>
  );
}
