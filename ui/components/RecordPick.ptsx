import { Publr } from "publr-jsx";
import { onBack, onClose, onPick, submitted } from "./ReferenceDrawer.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export const state = Publr.reactive({ title: "" });
export const root_ref = Publr.ref<HTMLElement>();
Publr.effect(() => {
  const title = state.title;
  Publr.stores.navigation.rename(root_ref.current, title);
});

/** The drawer's picker: the target type's records, searched, each with a Link button that
 * hands its id back to the editor that opened the drawer. Back and Close sit beside the
 * title, as in an editor drawn for the drawer. The search form is a GET the drawer
 * fetches and draws again in place. */
export type RecordPickProps = {
  type: string;
  type_name: string;
  /** The field the picked record goes into, carried back with the pick. */
  field: string;
  search: string;
  /** Only live records are offered: the field takes nothing else. */
  live: boolean;
  /** Opened from a virtual field: the reference field it reads, and the record it lists
   * for. A record held elsewhere is moved here only after a confirmation. */
  via: string;
  parent: string;
  rows: Array<{ id: string; title: string; status: string; published: boolean; moves_from: string }>;
  /** Where the next page starts, 0 when this is the last; the previous one's, -1 on the first. */
  next_offset: number;
  previous_offset: number;
};

export function RecordPick({
  type,
  type_name,
  field,
  search,
  live,
  via,
  parent,
  rows,
  next_offset,
  previous_offset,
}: RecordPickProps) {
  state.title = Publr.t("Link a {type}", { type: type_name });
  return (
    <div class="flex flex-col" data-part="record-pick" ref={root_ref}>
      <div class="px-8 py-7">
        <div class="flex items-center gap-4">
          <Button
            type="button"
            hierarchy="secondary"
            size="md"
            label={Publr.t("Back")}
            title={Publr.t("Back")}
            data-part="drawer-back"
            onClick={onBack}
          >
            <Icon name="arrow-left" size="sm" />
          </Button>
          <PageHeader title={Publr.t("Link a {type}", { type: type_name })} classes="min-w-0 flex-1">
            <Button
              type="button"
              hierarchy="tertiary"
              size="sm"
              label={Publr.t("Close")}
              title={Publr.t("Close")}
              data-part="drawer-close"
              onClick={onClose}
            >
              <Icon name="x-close" size="sm" />
            </Button>
          </PageHeader>
        </div>
        <form
          method="get"
          action="/admin/content/pick"
          class="mt-5 flex items-center gap-2"
          data-part="pick-search"
          onSubmit={submitted}
        >
          {live && <input type="hidden" name="live" value="1" />}
          <input type="hidden" name="type" value={type} />
          <input type="hidden" name="field" value={field} />
          {via !== "" && <input type="hidden" name="via" value={via} />}
          {parent !== "" && <input type="hidden" name="parent" value={parent} />}
          <Input type="search" name="q" value={search} placeholder={Publr.t("Search")} classes="w-80" />
          <Button type="submit" hierarchy="secondary">
            {Publr.t("Search")}
          </Button>
        </form>
      </div>
      {rows.length === 0 ? (
        <div class="mx-8">
          <Empty compact>
            <EmptyTitle size="xs">{Publr.t("Nothing to link")}</EmptyTitle>
            <EmptyDescription>{Publr.t("No {type} records match.", { type: type_name })}</EmptyDescription>
          </Empty>
        </div>
      ) : (
        <div class="border-t border-border">
          <Table>
            <TableBody>
              {rows.map((row) => (
                <TableRow>
                  <TableCell>
                    <Text as="span" variant="heading-xs">
                      {row.title}
                    </Text>
                  </TableCell>
                  <TableCell>
                    {row.published ? (
                      <Status tone="success">{row.status}</Status>
                    ) : (
                      <Status tone="neutral">{row.status}</Status>
                    )}
                  </TableCell>
                  <TableCell>
                    {row.moves_from !== "" && (
                      <Text as="span" variant="body-sm" tone="muted">
                        {Publr.t("In {parent}", { parent: row.moves_from })}
                      </Text>
                    )}
                  </TableCell>
                  <TableCell align="right">
                    {row.moves_from === "" ? (
                      <Button
                        type="button"
                        hierarchy="secondary"
                        size="sm"
                        data-link-id={row.id}
                        onClick={onPick}
                        data-field={field}
                      >
                        <Icon name="link" size="sm" />
                        <span>{Publr.t("Link")}</span>
                      </Button>
                    ) : (
                      <Dialog>
                        <DialogTrigger asChild>
                          <Button type="button" hierarchy="secondary" size="sm">
                            <Icon name="link" size="sm" />
                            <span>{Publr.t("Link")}</span>
                          </Button>
                        </DialogTrigger>
                        <DialogContent>
                          <DialogTitle>{Publr.t("Move {title} here?", { title: row.title })}</DialogTitle>
                          <DialogDescription>
                            {Publr.t("This {type} belongs to {parent}. Linking it here removes it from {parent}.", { type: type_name, parent: row.moves_from })}
                          </DialogDescription>
                          <div class="mt-5 flex justify-end gap-2">
                            <DialogClose asChild>
                              <Button type="button" hierarchy="secondary">
                                {Publr.t("Cancel")}
                              </Button>
                            </DialogClose>
                            <Button
                              type="button"
                              data-link-id={row.id}
                              onClick={onPick}
                              data-field={field}
                            >
                              {Publr.t("Move it here")}
                            </Button>
                          </div>
                        </DialogContent>
                      </Dialog>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      )}
      {(next_offset > 0 || previous_offset >= 0) && (
        <div class="flex justify-end gap-2 border-t border-border px-8 py-4" data-part="pick-pages">
          {previous_offset >= 0 && (
            <form method="get" action="/admin/content/pick" onSubmit={submitted}>
              {live && <input type="hidden" name="live" value="1" />}
              <input type="hidden" name="type" value={type} />
              <input type="hidden" name="field" value={field} />
              {via !== "" && <input type="hidden" name="via" value={via} />}
              {parent !== "" && <input type="hidden" name="parent" value={parent} />}
              <input type="hidden" name="q" value={search} />
              <input type="hidden" name="offset" value={`${previous_offset}`} />
              <Button type="submit" hierarchy="secondary" size="sm">
                {Publr.t("Previous")}
              </Button>
            </form>
          )}
          {next_offset > 0 && (
            <form method="get" action="/admin/content/pick" onSubmit={submitted}>
              {live && <input type="hidden" name="live" value="1" />}
              <input type="hidden" name="type" value={type} />
              <input type="hidden" name="field" value={field} />
              {via !== "" && <input type="hidden" name="via" value={via} />}
              {parent !== "" && <input type="hidden" name="parent" value={parent} />}
              <input type="hidden" name="q" value={search} />
              <input type="hidden" name="offset" value={`${next_offset}`} />
              <Button type="submit" hierarchy="secondary" size="sm">
                {Publr.t("Next")}
              </Button>
            </form>
          )}
        </div>
      )}
    </div>
  );
}
