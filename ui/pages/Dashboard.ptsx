import { HubPage } from "../layouts/HubPage.ptsx";
import { AgentSetup } from "../components/AgentSetup.ptsx";
import { PluginAbout } from "../components/PluginAbout.ptsx";
import { Publr } from "publr-jsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Card } from "@publr/ui/Card.ptsx";
import { CardBody } from "@publr/ui/CardBody.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { IsoField } from "@publr/ui/IsoField.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { AskBox } from "../components/AskBox.ptsx";
import { ProviderKey } from "../components/ProviderKey.ptsx";
import { OfferedProviders } from "../components/OfferedProviders.ptsx";
import { SectionTitle } from "@publr/ui/SectionTitle.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type DashboardProps = {
  /** `keys`: a model on the person's own key builds here; `agents`: their own agent does. */
  mode: string;
  /** Whether a model provider is connected, so the prompt can build. */
  connected: boolean;
  /** Not connected yet: the providers installed, each waiting for its key. */
  providers?: Array<{
    plugin: string;
    label: string;
    key_secret: string;
    key_set: boolean;
    key_url: string;
    key_steps: string;
  }>;
  /** `cd` into the project's folder; empty unless the admin is open on this machine. */
  folder_command: string;
  /** The project's own binary installing the skill, run from its folder. */
  install_command: string;
  /** Signing an agent in at this site's address; empty when it works in the folder. */
  login_command: string;
  /** Away from the folder: the one command that sets the agent's computer up. */
  agent_command: string;
  /** Away from the folder: the same for an agent to run itself, explained. */
  agent_prompt: string;
  /** The person's earlier conversations, newest first. */
  earlier: Array<{ id: string; prompt: string; label: string; href: string }>;
  /** A plugin's own "Your agent" tab, sanitized, shown instead of the commands; absent when none. */
  agents_tab?: JSX.Element;
  /** The plugin that tab comes from, named on its box. */
  agents_tab_from?: string;
  /** The site's host sends an agent's changes to a branch (`registry.work_start`). */
  branch_work?: boolean;
  /** Words handed over from a site page (`?ask=`), in the prompt for the person to send. */
  asked?: string;
  /** The page they were said on (`?page=`), sent with them. */
  asked_on?: string;
};

/** The overview: building this site with AI, on the person's own key or with their own agent. */
export function Dashboard({
  mode,
  connected,
  providers = [],
  folder_command,
  install_command,
  login_command,
  agent_command,
  agent_prompt,
  earlier,
  agents_tab,
  agents_tab_from,
  branch_work = false,
  asked = "",
  asked_on = "",
}: DashboardProps) {
  return (
    <HubPage title={Publr.t("Overview")} hero>
      <div class="relative flex flex-1 flex-col">
        <IsoField />
        <div class="relative mx-auto flex w-full max-w-2xl flex-1 flex-col items-center gap-8 px-5 pt-24 pb-16">
          <div class="flex flex-col items-center gap-3">
            <Heading level={1} size="2xl" classes="text-center">
              {Publr.t("What do you want to build?")}
            </Heading>
            <Text as="p" variant="body-lg" tone="muted" classes="text-center">
              {Publr.t("Describe it, and it is built here.")}
            </Text>
          </div>
          <TabNav label={Publr.t("How to build")}>
            <TabNavLink href="/admin?mode=keys" active={mode === "keys"}>
              {Publr.t("Your keys")}
            </TabNavLink>
            <TabNavLink href="/admin?mode=agents" active={mode === "agents"}>
              {Publr.t("Your agent")}
            </TabNavLink>
          </TabNav>
          {mode === "agents" && agents_tab && (
            <PluginAbout name={agents_tab_from ?? ""}>{agents_tab}</PluginAbout>
          )}
          {mode === "agents" && !agents_tab && (
            <AgentSetup
              folder_command={folder_command}
              install_command={install_command}
              login_command={login_command}
              agent_command={agent_command}
              agent_prompt={agent_prompt}
              branch_work={branch_work}
            />
          )}
          {mode === "keys" && connected && !Publr.request.admin.framed && (
            <AskBox csrf={Publr.request.session.csrf} prompt={asked} page={asked_on} />
          )}
          {mode === "keys" && !connected && (
            <Card>
              <CardBody>
                <div class="flex flex-col gap-5">
                  <Text as="p" variant="body-md">
                    {providers.length > 0
                      ? Publr.t("Paste a key for one of them, and describe what to build here.")
                      : Publr.t("Pick the model providers to build with, on keys of your own. Their bills are yours; Publr charges nothing.")}
                  </Text>
                  {providers.map((provider) => (
                    <div key={provider.plugin} class="flex flex-col gap-2">
                      <Heading level={2} size="sm">
                        {provider.label}
                      </Heading>
                      <ProviderKey
                        key_secret={provider.key_secret}
                        key_set={provider.key_set}
                        key_url={provider.key_url}
                        key_steps={provider.key_steps}
                        from="overview"
                      />
                    </div>
                  ))}
                  {providers.length === 0 && <OfferedProviders from="overview" />}
                  {providers.length > 0 && (
                    <Link href="/admin/settings/ai" variant="body-sm">
                      {Publr.t("Add another provider")}
                    </Link>
                  )}
                </div>
              </CardBody>
            </Card>
          )}
          {mode === "keys" && earlier.length > 0 && !Publr.request.admin.framed && (
            <div class="flex w-full flex-col gap-3">
              <SectionTitle title={Publr.t("Earlier")} classes="px-0" />
              {earlier.map((item) => (
                <div key={item.id} class="flex items-center justify-between gap-4">
                  <Link href={item.href} variant="body-md" classes="min-w-0 truncate">
                    {item.prompt}
                  </Link>
                  <Status tone="neutral">{item.label}</Status>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </HubPage>
  );
}
