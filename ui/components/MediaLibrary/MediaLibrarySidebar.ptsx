import { Publr } from "publr-jsx";
import {
  chose_delete,
  chose_inside,
  chose_move,
  chose_rename,
  dated,
  folder_deleted,
  folder_made,
  folder_moved,
  folder_renamed,
  follow,
  server_checked,
  server_taken,
  state,
  tag_made,
} from "./MediaLibrary.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuSeparator } from "@publr/ui/DropdownMenuSeparator.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { FilterChip } from "@publr/ui/FilterChip.ptsx";
import { FolderNav } from "@publr/ui/FolderNav.ptsx";
import { FolderNavItem } from "@publr/ui/FolderNavItem.ptsx";
import { FolderNavItemActions } from "@publr/ui/FolderNavItemActions.ptsx";
import { FolderNavItemCount } from "@publr/ui/FolderNavItemCount.ptsx";
import { FolderNavItemLink } from "@publr/ui/FolderNavItemLink.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { SidebarNavEyebrow } from "@publr/ui/SidebarNavEyebrow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

/** A media library's explorer: every file, the unsorted and unreviewed ones and the folder
 * tree (each with what it holds under the rest of the filter), the tags (choosing several
 * narrows to files carrying them all), the upload month, and the media folder on the
 * server. Folders, tags and the server's folder are the library's own. */
export function MediaLibrarySidebar() {
  return (
    <div class="contents">
      <div class="flex flex-col">
        <div class="flex items-end justify-between pr-1">
          <SidebarNavEyebrow>{state.filed ? Publr.t("Folders") : Publr.t("Files")}</SidebarNavEyebrow>
          {state.filed && (
            <Dialog>
              <DialogTrigger asChild>
                <Button type="button" hierarchy="tertiary" size="xs" label={Publr.t("New folder")} title={Publr.t("New folder")}>
                  <Icon name="folder-plus" size="sm" />
                </Button>
              </DialogTrigger>
              <DialogContent>
                <DialogTitle>{Publr.t("New folder")}</DialogTitle>
                <form class="mt-4 flex flex-col gap-4" data-parent="" onSubmit={folder_made}>
                  <Input name="name" placeholder={Publr.t("Name")} required maxLength={64} />
                  <div class="flex justify-end gap-2">
                    <DialogClose asChild><Button type="button" hierarchy="secondary">{Publr.t("Cancel")}</Button></DialogClose>
                    <DialogClose asChild><Button type="submit">{Publr.t("Create")}</Button></DialogClose>
                  </div>
                </form>
              </DialogContent>
            </Dialog>
          )}
        </div>
        <FolderNav label={Publr.t("Folders")}>
          <FolderNavItem>
            <FolderNavItemLink href={state.all_href} current={state.folder === ""} onClick={follow}>
              <Icon name="grid" size="sm" />
              <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{Publr.t("All files")}</Text>
            </FolderNavItemLink>
            <FolderNavItemCount persistent>{`${state.all}`}</FolderNavItemCount>
          </FolderNavItem>
          {state.filed && (
            <FolderNavItem>
              <FolderNavItemLink href={state.unsorted_href} current={state.folder === "unsorted"} onClick={follow}>
                <Icon name="file" size="sm" />
                <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{Publr.t("Unsorted")}</Text>
              </FolderNavItemLink>
              <FolderNavItemCount persistent>{`${state.unsorted}`}</FolderNavItemCount>
            </FolderNavItem>
          )}
          {state.unreviewed_shown && (
            <FolderNavItem>
              <FolderNavItemLink href={state.unreviewed_href} current={state.folder === "unreviewed"} onClick={follow}>
                <Icon name="search" size="sm" />
                <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{Publr.t("Unreviewed")}</Text>
              </FolderNavItemLink>
              <FolderNavItemCount persistent>{`${state.unreviewed}`}</FolderNavItemCount>
            </FolderNavItem>
          )}
          {state.folders.map((entry) => (
            <FolderNavItem level={entry.level} key={entry.id}>
              <FolderNavItemLink href={entry.href} current={entry.current} onClick={follow}>
                <Icon name="folder" size="sm" />
                <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{entry.name}</Text>
              </FolderNavItemLink>
              <FolderNavItemCount>{`${entry.count}`}</FolderNavItemCount>
              <FolderNavItemActions>
                <Dialog>
                  <DropdownMenu>
                    <DropdownMenuTrigger asChild>
                      <Button type="button" hierarchy="tertiary" size="xs" label={Publr.t("More for {name}", { name: entry.name })} title={Publr.t("More")}>
                        <Icon name="more" size="sm" />
                      </Button>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent align="right">
                      {entry.nests && (
                        <DialogTrigger asChild>
                          <DropdownMenuItem onClick={chose_inside}>
                            <Icon name="folder-plus" size="sm" />
                            {Publr.t("New folder inside")}
                          </DropdownMenuItem>
                        </DialogTrigger>
                      )}
                      <DialogTrigger asChild>
                        <DropdownMenuItem onClick={chose_rename}>
                          <Icon name="edit" size="sm" />
                          {Publr.t("Rename")}
                        </DropdownMenuItem>
                      </DialogTrigger>
                      <DialogTrigger asChild>
                        <DropdownMenuItem onClick={chose_move}>
                          <Icon name="folder" size="sm" />
                          {Publr.t("Move")}
                        </DropdownMenuItem>
                      </DialogTrigger>
                      <DropdownMenuSeparator />
                      <DialogTrigger asChild>
                        <DropdownMenuItem variant="destructive" onClick={chose_delete}>
                          <Icon name="trash" size="sm" />
                          {Publr.t("Delete")}
                        </DropdownMenuItem>
                      </DialogTrigger>
                    </DropdownMenuContent>
                  </DropdownMenu>
                  <DialogContent>
                    {state.folder_action === "inside" && (
                      <div class="contents">
                        <DialogTitle>{Publr.t("New folder in {name}", { name: entry.name })}</DialogTitle>
                        <form class="mt-4 flex flex-col gap-4" data-parent={entry.id} onSubmit={folder_made}>
                          <Input name="name" placeholder={Publr.t("Name")} required maxLength={64} />
                          <div class="flex justify-end gap-2">
                            <DialogClose asChild><Button type="button" hierarchy="secondary">{Publr.t("Cancel")}</Button></DialogClose>
                            <DialogClose asChild><Button type="submit">{Publr.t("Create")}</Button></DialogClose>
                          </div>
                        </form>
                      </div>
                    )}
                    {state.folder_action === "rename" && (
                      <div class="contents">
                        <DialogTitle>{Publr.t("Rename {name}", { name: entry.name })}</DialogTitle>
                        <form class="mt-4 flex flex-col gap-4" data-folder={entry.id} onSubmit={folder_renamed}>
                          <Input name="name" value={entry.name} required maxLength={64} />
                          <div class="flex justify-end gap-2">
                            <DialogClose asChild><Button type="button" hierarchy="secondary">{Publr.t("Cancel")}</Button></DialogClose>
                            <DialogClose asChild><Button type="submit">{Publr.t("Rename")}</Button></DialogClose>
                          </div>
                        </form>
                      </div>
                    )}
                    {state.folder_action === "move" && (
                      <div class="contents">
                        <DialogTitle>{Publr.t("Move {name}", { name: entry.name })}</DialogTitle>
                        <DialogDescription>{Publr.t("Not into itself or a folder inside it.")}</DialogDescription>
                        <form class="mt-4 flex flex-col gap-4" data-folder={entry.id} onSubmit={folder_moved}>
                          <NativeSelect name="parent" label={Publr.t("Into")}>
                            <option value="">{Publr.t("The top level")}</option>
                            {state.folders.map((home) => (
                              <option value={home.id} selected={home.id === entry.parent}>{home.label}</option>
                            ))}
                          </NativeSelect>
                          <div class="flex justify-end gap-2">
                            <DialogClose asChild><Button type="button" hierarchy="secondary">{Publr.t("Cancel")}</Button></DialogClose>
                            <DialogClose asChild><Button type="submit">{Publr.t("Move")}</Button></DialogClose>
                          </div>
                        </form>
                      </div>
                    )}
                    {state.folder_action === "delete" && (
                      <div class="contents">
                        <DialogTitle>{Publr.t("Delete {name}?", { name: entry.name })}</DialogTitle>
                        <DialogDescription>
                          {Publr.t("Its files and folders move up a level; files in a top-level folder become unsorted.")}
                        </DialogDescription>
                        <form class="mt-4 flex justify-end gap-2" data-folder={entry.id} onSubmit={folder_deleted}>
                          <DialogClose asChild><Button type="button" hierarchy="secondary">{Publr.t("Cancel")}</Button></DialogClose>
                          <DialogClose asChild><Button type="submit" intent="destructive">{Publr.t("Delete folder")}</Button></DialogClose>
                        </form>
                      </div>
                    )}
                  </DialogContent>
                </Dialog>
              </FolderNavItemActions>
            </FolderNavItem>
          ))}
        </FolderNav>
      </div>
      {state.filed && (
        <div class="flex flex-col gap-2">
          <SidebarNavEyebrow classes="-mb-2">{Publr.t("Tags")}</SidebarNavEyebrow>
          <div class="flex flex-wrap gap-1.5 px-2.5">
            {state.tag_list.map((tag) => (
              tag.enabled ? (
                <FilterChip href={tag.href} onClick={follow} count={`${tag.count}`} selected={tag.selected}>
                  {tag.name}
                </FilterChip>
              ) : (
                <FilterChip count="0" disabled>{tag.name}</FilterChip>
              )
            ))}
          </div>
          <form class="flex items-center gap-1 pl-2.5 pr-1" onSubmit={tag_made}>
            <Input name="name" size="sm" placeholder={Publr.t("New tag")} maxLength={64} classes="min-w-0 flex-1" />
            <Button type="submit" hierarchy="tertiary" size="sm" label={Publr.t("Add tag")} title={Publr.t("Add tag")}>
              <Icon name="plus" size="sm" />
            </Button>
          </form>
        </div>
      )}
      <div class="flex flex-col gap-2">
        <SidebarNavEyebrow classes="-mb-2">{Publr.t("Uploaded")}</SidebarNavEyebrow>
        <div class="flex flex-col gap-2 px-2.5">
          <NativeSelect name="year" label={Publr.t("Year")} size="sm" onChange={dated} classes="flex-1">
            {state.years.map((option) => (
              <option value={option.value} selected={option.selected}>{option.label}</option>
            ))}
          </NativeSelect>
          <NativeSelect name="month" label={Publr.t("Month")} size="sm" onChange={dated} disabled={state.year === 0} classes="flex-1">
            {state.months.map((option) => (
              <option value={option.value} selected={option.selected}>{option.label}</option>
            ))}
          </NativeSelect>
        </div>
      </div>
      {state.filed && state.on_server && (
        <div class="flex flex-col gap-2" data-part="media-server">
          <SidebarNavEyebrow classes="-mb-2">{Publr.t("On the server")}</SidebarNavEyebrow>
          <Text as="p" variant="body-sm" tone="muted" classes="px-2.5">{state.server_note}</Text>
          {state.server_skipped.map((line) => (
            <Text as="p" variant="body-xs" tone="muted" classes="break-all px-2.5">{line}</Text>
          ))}
          <div class="flex gap-2 px-2.5">
            <Button type="button" hierarchy="secondary" size="sm" disabled={state.server_busy} onClick={server_checked}>
              <Icon name="sync" size="sm" />
              <span>{Publr.t("Check")}</span>
            </Button>
            {state.server_new > 0 && (
              <Button type="button" size="sm" disabled={state.server_busy} onClick={server_taken}>
                {Publr.t("Add {count}", { count: state.server_new })}
              </Button>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
