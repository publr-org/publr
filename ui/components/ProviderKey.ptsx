import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type ProviderKeyProps = {
  /** The secret the key is kept under. */
  key_secret: string;
  key_set: boolean;
  key_url: string;
  /** What to do to get a key, one sentence after another. */
  key_steps: string;
  /** `overview` when it sits on the Overview, which the form comes back to. */
  from?: string;
};

/** A provider's key: where to get one, and a field to paste it, kept as its secret. */
export function ProviderKey({ key_secret, key_set, key_url, key_steps, from = "" }: ProviderKeyProps) {
  return (
    <form method="post" action="/admin/settings/ai/key" class="flex flex-col gap-2">
      <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
      <input type="hidden" name="name" value={key_secret} />
      {from !== "" && <input type="hidden" name="from" value={from} />}
      <Text as="p" variant="body-sm" tone="muted">
        {key_steps}{" "}
        <Link href={key_url} external variant="body-sm">
          {Publr.t("Get a key")}
        </Link>
      </Text>
      <div class="flex items-center gap-2">
        <Input
          type="password"
          name="value"
          placeholder={key_set ? Publr.t("Paste a new key to replace it") : Publr.t("Paste your key")}
          classes="flex-1"
        />
        <Button hierarchy="secondary" size="md" type="submit">
          {Publr.t("Save key")}
        </Button>
      </div>
    </form>
  );
}
