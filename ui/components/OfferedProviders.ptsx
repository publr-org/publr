import { Publr } from "publr-jsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { SectionTitle } from "@publr/ui/SectionTitle.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { ProviderPicker } from "./ProviderPicker.ptsx";
import { asked_in, landed, reload_without, Waiting } from "./QueuedWork.ptsx";

type Offered = {
  offered: Array<{ name: string; label: string; summary: string }>;
  reached: boolean;
  looking: boolean;
};

/** Filled once the page is drawn: Publr's plugin server is never waited on to draw it. */
export const state = Publr.reactive({
  looked: false,
  reached: true,
  offered: [] as Offered["offered"],
  /** The providers ticked are installing in the background (`?setting_up=<id>`). */
  installing: false,
  problem: "",
});

/** The list as Publr last read it, asked again while its first read is on its way. */
const look = async () => {
  try {
    const response = await fetch(Publr.url("/admin/settings/ai/offered"), {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    });
    const value: Offered = await response.json();
    if (value.looking) {
      window.setTimeout(look, 1000);
      return;
    }
    state.reached = value.reached;
    state.offered = value.offered;
  } catch {
    state.reached = false;
  }
  state.looked = true;
};

Publr.effect(() => {
  void look();
  const asked = asked_in("setting_up");
  if (asked === "") return;
  state.installing = true;
  void landed(asked).then((found) => {
    if (found.state === "done") return reload_without("setting_up");
    state.installing = false;
    state.problem = found.problem ?? "";
  });
});

export type OfferedProvidersProps = {
  /** `overview` when it sits on the Overview, which the form comes back to. */
  from?: string;
  /** A heading over the providers, shown only when there are some. */
  title?: string;
};

/** The official model providers not installed yet, asked of Publr's plugin server after the
 * page is drawn, ready to install in one go. */
export function OfferedProviders({ from = "", title = "" }: OfferedProvidersProps) {
  return (
    <div class="flex flex-col gap-4" data-part="offered-providers">
      {state.installing && <Waiting title={Publr.t("Installing the providers…")} />}
      {state.problem !== "" && (
        <Callout tone="error" title={Publr.t("The providers could not be installed")}>
          {state.problem}
        </Callout>
      )}
      {!state.looked && (
        <Text as="p" variant="body-sm" tone="muted">
          {Publr.t("Looking up the official providers…")}
        </Text>
      )}
      {state.offered.length > 0 && title !== "" && <SectionTitle title={title} />}
      {state.offered.length > 0 && <ProviderPicker offered={state.offered} from={from} />}
      {state.looked && !state.reached && (
        <Callout tone="warning" title={Publr.t("Publr's plugin server could not be reached")}>
          {Publr.t("Try again later, or upload a provider's .wasm under Plugins.")}
        </Callout>
      )}
    </div>
  );
}
