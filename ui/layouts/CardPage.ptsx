import { Document } from "./Document.ptsx";
import { Mark } from "../components/Mark.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type CardPageProps = {
  title: string;
  description: string;
  /** What went wrong last time: shown above the form. */
  notice?: string;
  /** Under the form, behind a rule: other ways in. */
  footer?: JSX.Element;
  /** The form. */
  children?: JSX.Element;
};

/** A page before sign-in: one card in the middle of the window, with the mark, the title,
 * a line, a notice, the form and an optional footer. No chrome. */
export function CardPage({ title, description, notice, footer, children }: CardPageProps) {
  return (
    <Document title={title}>
      <main class="flex min-h-screen items-center justify-center px-5 py-10">
        <div class="flex w-full max-w-sm flex-col gap-6 rounded-2xl border border-border bg-card p-8 shadow-sheet">
          <div class="inline-flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground">
            <Mark classes="size-[22px]" />
          </div>
          <div class="flex flex-col gap-1.5">
            <Heading level={1} size="lg">
              {title}
            </Heading>
            <Text as="p" variant="body-sm" tone="muted">
              {description}
            </Text>
          </div>
          {notice && <Status tone="error">{notice}</Status>}
          {children}
          {footer && <div class="flex flex-col gap-2 border-t border-border pt-6">{footer}</div>}
        </div>
      </main>
    </Document>
  );
}
