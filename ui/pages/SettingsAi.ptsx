import { FormPage } from "../layouts/FormPage.ptsx";
import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Card } from "@publr/ui/Card.ptsx";
import { CardBody } from "@publr/ui/CardBody.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { SectionTitle } from "@publr/ui/SectionTitle.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { TalkKey } from "../components/TalkKey.ptsx";
import { ProviderKey } from "../components/ProviderKey.ptsx";
import { ProviderPicker } from "../components/ProviderPicker.ptsx";

export type SettingsAiProps = {
  /** The providers installed, the one in use first. */
  providers: Array<{
    plugin: string;
    label: string;
    chosen: boolean;
    /** The secret its key is kept under; empty for a provider with no key. */
    key_secret: string;
    key_set: boolean;
    key_url: string;
    /** What to do to get a key, one sentence after another. */
    key_steps: string;
    models: Array<{ id: string; label: string; selected: boolean }>;
    permissions_href: string;
    /** What it asks for (sending requests out, its key) waits for approval. */
    pending: boolean;
  }>;
  /** The official providers that can be set up in a click. */
  offered: Array<{ name: string; label: string; summary: string }>;
  /** Whether Publr's plugin server answered with its list. */
  reached: boolean;
  notice: string;
  problem: string;
};

/** Models on the project's own keys: the providers installed, each with its key, its
 * model and a test; the one conversations use; and the ones that can be set up. */
export function SettingsAi({ providers, offered, reached, notice, problem }: SettingsAiProps) {
  return (
    <FormPage
      title={Publr.t("AI")}
      description={Publr.t("Build with a model on your own key: its bill is yours, and Publr charges nothing. Conversations use the provider marked In use.")}
      notice={
        <div class="flex flex-col gap-3">
          {problem !== "" && (
            <Callout tone="error" title={Publr.t("That did not work")}>
              {problem}
            </Callout>
          )}
          {notice !== "" && <Callout title={notice} />}
          {!reached && (
            <Callout tone="warning" title={Publr.t("Publr's plugin server could not be reached")}>
              {Publr.t("Try again later, or upload a provider's .wasm under Plugins.")}
            </Callout>
          )}
        </div>
      }
    >
      <div class="flex flex-col gap-6">
        {providers.map((provider) => (
          <Card key={provider.plugin}>
            <CardBody>
              <div class="flex flex-col gap-5">
                <div class="flex items-center justify-between gap-4">
                  <Heading level={2} size="sm">
                    {provider.label}
                  </Heading>
                  <div class="flex items-center gap-3">
                    {provider.pending && <Status tone="warning">{Publr.t("Waiting for approval")}</Status>}
                    {provider.chosen && <Status tone="accent">{Publr.t("In use")}</Status>}
                    {provider.key_set ? (
                      <Status tone="success">{Publr.t("Key set")}</Status>
                    ) : (
                      <Status tone="warning">{Publr.t("Needs a key")}</Status>
                    )}
                  </div>
                </div>
                {provider.key_secret !== "" && (
                  <ProviderKey
                    key_secret={provider.key_secret}
                    key_set={provider.key_set}
                    key_url={provider.key_url}
                    key_steps={provider.key_steps}
                  />
                )}
                {provider.pending && (
                  <div class="flex items-center justify-between gap-4">
                    <Text as="p" variant="body-sm" tone="muted">
                      {Publr.t("It can call out only once you approve what it asks for: sending requests to its API, and using its key.")}
                    </Text>
                    <Button hierarchy="primary" size="md" href={provider.permissions_href}>
                      {Publr.t("Approve")}
                    </Button>
                  </div>
                )}
                <div class="flex flex-wrap items-center gap-2">
                  <form method="post" action="/admin/settings/ai/choose" class="flex items-center gap-2">
                    <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                    <input type="hidden" name="provider" value={provider.plugin} />
                    <NativeSelect name="model" size="sm" label={Publr.t("Model")}>
                      {provider.models.map((model) => (
                        <option value={model.id} selected={model.selected}>
                          {model.label}
                        </option>
                      ))}
                    </NativeSelect>
                    <Button hierarchy={provider.chosen ? "secondary" : "primary"} size="md" type="submit">
                      {provider.chosen ? Publr.t("Save model") : Publr.t("Use this provider")}
                    </Button>
                  </form>
                  <form method="post" action="/admin/settings/ai/test">
                    <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                    <input type="hidden" name="provider" value={provider.plugin} />
                    <Button hierarchy="secondary" size="md" type="submit">
                      {Publr.t("Test")}
                    </Button>
                  </form>
                  <Link href={provider.permissions_href} variant="body-sm">
                    {Publr.t("Permissions")}
                  </Link>
                </div>
              </div>
            </CardBody>
          </Card>
        ))}
        {providers.length > 0 && <TalkKey />}
        {offered.length > 0 && (
          <div class="flex flex-col gap-3">
            <SectionTitle title={providers.length === 0 ? Publr.t("Pick your providers") : Publr.t("Add another")} />
            <ProviderPicker offered={offered} />
          </div>
        )}
      </div>
    </FormPage>
  );
}
