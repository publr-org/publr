import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type TermsProps = {
  /** The taxonomy: its name, handle, whether terms nest, and where its head is edited. */
  title: string;
  handle: string;
  hierarchical: boolean;
  settings_href: string;
  new_href: string;
  /** A page of the terms in tree order: parents before children, each with its depth. */
  terms: Array<{
    href: string;
    title: string;
    slug: string;
    status: string;
    published: boolean;
    depth: number;
    indent: string;
    add_child_href: string;
  }>;
  /** How many terms there are in all. */
  total: number;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  previous_href: string;
  next_href: string;
};

/** A taxonomy's page: its terms as a tree, one row each, with a way to add a term at the
 * root or under any term of a hierarchical taxonomy. */
export function Terms({
  title,
  handle,
  hierarchical,
  settings_href,
  new_href,
  terms,
  total,
  range,
  previous_href,
  next_href,
}: TermsProps) {
  return (
    <IndexPage
      title={title}
      parents={[
        { label: Publr.t("Structure"), href: "/admin/structure" },
        { label: Publr.t("Taxonomies"), href: "/admin/structure/taxonomies" },
      ]}
      description={
        hierarchical
          ? Publr.tn("{handle} · hierarchical · {count} term", "{handle} · hierarchical · {count} terms", total, { handle })
          : Publr.tn("{handle} · flat · {count} term", "{handle} · flat · {count} terms", total, { handle })
      }
      footer={range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
      actions={
        <div class="contents">
          <Button href={settings_href} hierarchy="secondary">
            <Icon name="settings" size="sm" />
            <span>{Publr.t("Settings")}</span>
          </Button>
          <Button href={new_href}>
            <Icon name="plus" size="sm" />
            <span>{Publr.t("New term")}</span>
          </Button>
        </div>
      }
      empty={
        terms.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("No terms yet")}</EmptyTitle>
            <EmptyDescription>
              {Publr.t("A term is what records get filed under. Create the first one.")}
            </EmptyDescription>
          </Empty>
        )
      }
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Term")}</TableHead>
            <TableHead>{Publr.t("Slug")}</TableHead>
            <TableHead>{Publr.t("Status")}</TableHead>
            <TableHead align="right">{Publr.t("Children")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {terms.map((term) => (
            <TableRow>
              <TableCell>
                <div class={["flex items-center gap-2", term.indent]}>
                  {term.depth > 0 && <Icon name="chevron-right" size="xs" />}
                  <Link href={term.href} variant="body-sm" tone="default">
                    {term.title}
                  </Link>
                </div>
              </TableCell>
              <TableCell>
                <Text as="span" variant="mono-xs" tone="muted">
                  {term.slug}
                </Text>
              </TableCell>
              <TableCell>
                {term.published ? (
                  <Status tone="success">{term.status}</Status>
                ) : (
                  <Status tone="neutral">{term.status}</Status>
                )}
              </TableCell>
              <TableCell align="right">
                {term.add_child_href !== "" && (
                  <Button href={term.add_child_href} hierarchy="secondary" size="sm">
                    <Icon name="plus" size="xs" />
                    <span>{Publr.t("Add child")}</span>
                  </Button>
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
