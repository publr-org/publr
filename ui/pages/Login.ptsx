import { Layout } from "../layouts/Layout.ptsx";
import { Mark } from "../components/Mark.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type LoginProps = {
  /** A failed attempt, a throttle delay: shown above the form. */
  notice?: string;
  /** The sign-in providers the site offers, one button each, under the form. */
  providers?: Array<{
    label: string;
    /** The provider's mark: one SVG path on a 24 by 24 canvas, drawn in the text colour. */
    icon: string;
    href: string;
  }>;
};

export function Login({ notice, providers = [] }: LoginProps) {
  return (
    <Layout title="Log in" section="">
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 shadow-sheet">
        <div class="mb-6 inline-flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground">
          <Mark classes="size-[22px]" />
        </div>
        <Heading level={1} size="lg">
          Log in
        </Heading>
        <p class="mt-1.5">
          <Text variant="body-sm" tone="muted">
            Welcome back to Publr.
          </Text>
        </p>
        {notice && (
          <div class="mt-4">
            <Status tone="error">{notice}</Status>
          </div>
        )}
        <form method="post" action="/admin/login" class="mt-6 space-y-4">
          <Field>
            <FieldLabel htmlFor="email">Email</FieldLabel>
            <Input id="email" type="email" name="email" required autocomplete="username" />
          </Field>
          <Field>
            <FieldLabel htmlFor="password">Password</FieldLabel>
            <Input
              id="password"
              type="password"
              name="password"
              required
              autocomplete="current-password"
            />
          </Field>
          <Button type="submit" size="lg" classes="mt-2 w-full">
            Log in
          </Button>
        </form>
        {providers.length > 0 && (
          <div class="mt-6 space-y-2 border-t border-border pt-6">
            {providers.map((provider) => (
              <Button href={provider.href} hierarchy="secondary" size="lg" classes="w-full">
                <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor" aria-hidden="true">
                  <path d={provider.icon} />
                </svg>
                Continue with {provider.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </Layout>
  );
}
