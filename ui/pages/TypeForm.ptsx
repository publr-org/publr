import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { TypeHead } from "../components/TypeHead.ptsx";
import { TypeNames } from "../components/TypeNames.ptsx";
import { TypeEditor } from "../components/TypeEditor.ptsx";
import { TypePlacement } from "../components/TypePlacement.ptsx";
import { TypeWorkflow } from "../components/TypeWorkflow.ptsx";

export type TypeFormProps = {
  title: string;
  /** Structure, the list the type belongs to, and the type's own page once it exists. */
  parents: Array<{ label: string; href: string }>;
  /** Where Cancel goes: the type's page, or the list for a new one. */
  cancel_href: string;
  /** "content type" or "taxonomy", for the buttons and the dialog. */
  noun: string;
  /** A taxonomy: no kind, no URL; hierarchical or flat, public or not. */
  is_taxonomy: boolean;
  hierarchical: boolean;
  /** A taxonomy: records take one term, not several. */
  single: boolean;
  /** A taxonomy: the record types it may apply to, the ticked ones selected: those with an
   * address on the site, and the others, shown on request (or when one is ticked). */
  applies_routed: Array<{ value: string; label: string; selected: boolean }>;
  applies_other: Array<{ value: string; label: string; selected: boolean }>;
  show_all_types: boolean;
  /** Where the form posts: create, or update of an existing type. */
  action: string;
  is_new: boolean;
  choose_kind: boolean;
  /** What was refused, by path, when the last post did not go through. */
  problems: Array<{ code: string; text: string }>;
  /** Declared by a plugin: the head is fixed, only fields of your own can be added. */
  system: boolean;
  owner: string;
  handle: string;
  name: string;
  description: string;
  /** The counts as the server printed them, and what the last post was refused for per
   * field (empty when nothing was); the rest of the problems are listed above the form. */
  name_count: string;
  handle_count: string;
  description_count: string;
  name_error: string;
  handle_error: string;
  description_error: string;
  /** The type's place on the site (`posts`), and whether it has one. */
  url: string;
  has_url: boolean;
  /** Which kind is chosen; exactly one is true. */
  is_record: boolean;
  is_settings: boolean;
  is_component: boolean;
  base_url: string;
  visibility: string;
  is_public: boolean;
  /** Where it lives, who it is shared with: see TypePlacement. */
  has_apps: boolean;
  is_global: boolean;
  home: string;
  apps: Array<{ value: string; label: string; selected: boolean }>;
  share_all: boolean;
  shares: Array<{ value: string; label: string; checked: boolean }>;
  roles: Array<{ value: string; label: string; checked: boolean }>;
  untranslated_label?: string;
  keep_label?: string;
  keep_help?: string;
  omit_label?: string;
  omit_help?: string;
  falls_back?: boolean;
  /** The name for more than one, and the name declined in the admin's other languages. */
  plural_name?: string;
  noun_languages?: Array<{
    locale: string;
    label: string;
    genders: Array<{ key: string; label: string; selected: boolean }>;
    cases: Array<{ key: string; label: string; singular: string; plural: string }>;
  }>;
  /** A record type: edited as a form, or visually over one of `rich_fields`. */
  visual: boolean;
  rich_fields: Array<{ value: string; label: string; selected: boolean }>;
  /** The delete form's action; absent for a new type. */
  delete_action?: string;
  /** The type whose Workflow section is drawn: an existing record type's handle, plugins'
   * too; empty for none. */
  workflow_type: string;
};

/** A content type's head: what it is called, what kind it is, who may read it. A new
 * type is created here and continues to its fields; an existing one edits its settings. */
export function TypeForm({
  title,
  parents,
  cancel_href,
  noun,
  is_taxonomy,
  hierarchical,
  single,
  applies_routed,
  applies_other,
  show_all_types,
  action,
  is_new,
  choose_kind,
  problems,
  system,
  owner,
  handle,
  name,
  description,
  name_count,
  handle_count,
  description_count,
  name_error,
  handle_error,
  description_error,
  url,
  has_url,
  is_record,
  is_settings,
  is_component,
  base_url,
  visibility,
  is_public,
  has_apps,
  is_global,
  home,
  apps,
  share_all,
  shares,
  roles,
  plural_name = "",
  noun_languages = [],
  untranslated_label = "",
  keep_label = "",
  keep_help = "",
  omit_label = "",
  omit_help = "",
  falls_back = true,
  visual,
  rich_fields,
  delete_action,
  workflow_type,
}: TypeFormProps) {
  return (
    <FormPage
      title={title}
      parents={parents}
      problems={problems}
      problems_title={Publr.t("The {noun} was not saved.", { noun })}
      notice={
        system && (
          <Callout title={Publr.t("Declared by the {owner} plugin", { owner })}>
            {Publr.t("Handle {handle}, {visibility}. Its settings are fixed in code; its declared fields are locked, and you can add fields of your own.", { handle, visibility })}
          </Callout>
        )
      }
      aside={
        !system && (
          <EditorAsideSection>
            <Button type="submit" form="type" classes="w-full">
              {is_new ? (is_taxonomy ? Publr.t("Create and add terms") : Publr.t("Create and add fields")) : Publr.t("Save settings")}
            </Button>
            <Button href={cancel_href} hierarchy="tertiary" classes="w-full">
              {Publr.t("Cancel")}
            </Button>
          </EditorAsideSection>
        )
      }
      danger={
        delete_action && (
          <ConfirmAction
            label={Publr.t("Delete {noun}", { noun })}
            title={Publr.t("Delete {name}?", { name })}
            description={
              is_taxonomy
                ? Publr.t("The taxonomy goes for good. Its terms stay unless you delete them too; with terms kept, the taxonomy cannot be deleted.")
                : Publr.t("The type goes for good. Its records stay unless you delete them too; with records kept, the type cannot be deleted.")
            }
            action={delete_action ?? "#"}
          >
            <CheckboxField
              id="force"
              name="force"
              label={is_taxonomy ? Publr.t("Also delete its terms") : Publr.t("Also delete its records")}
            />
          </ConfirmAction>
        )
      }
    >
      {!system && (
        <form id="type" method="post" action={action} class="flex flex-col gap-5">
          <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
          <TypeHead
            is_record={is_record}
            is_settings={is_settings}
            is_component={is_component}
            name={name}
            handle={handle}
            description={description}
            name_count={name_count}
            handle_count={handle_count}
            description_count={description_count}
            name_error={name_error}
            handle_error={handle_error}
            description_error={description_error}
            url={url}
            has_url={has_url}
            base_url={base_url}
            is_new={is_new}
            choose_kind={choose_kind}
            is_taxonomy={is_taxonomy}
            hierarchical={hierarchical}
            single={single}
            applies_routed={applies_routed}
            applies_other={applies_other}
            show_all_types={show_all_types}
          />
          <TypeNames name={name} plural_name={plural_name} languages={noun_languages} />
          <TypePlacement
            noun={noun}
            has_apps={has_apps}
            is_global={is_global}
            home={home}
            apps={apps}
            share_all={share_all}
            shares={shares}
            roles={roles}
            show_access={!is_component}
            is_public={is_public}
            untranslated_label={is_record ? untranslated_label : ""}
            keep_label={keep_label}
            keep_help={keep_help}
            omit_label={omit_label}
            omit_help={omit_help}
            falls_back={falls_back}
          />
          {!is_taxonomy && is_record && (
            <TypeEditor visual={visual} is_new={is_new} rich_fields={rich_fields} />
          )}
        </form>
      )}
      {workflow_type !== "" && (
        <section class="flex flex-col gap-2" data-part="workflow">
          <Heading level={2} size="md">{Publr.t("Workflow")}</Heading>
          <TypeWorkflow type={workflow_type} />
        </section>
      )}
    </FormPage>
  );
}
