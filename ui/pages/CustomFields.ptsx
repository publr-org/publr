import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";

export type CustomFieldsProps = {
  groups: Array<{ name: string; handle: string; href: string; status: string }>;
};

/** The field groups that extend users and media, and a way to add one. */
export function CustomFields({ groups }: CustomFieldsProps) {
  return (
    <IndexPage
      title={Publr.t("Custom Fields")}
      parents={[{ label: Publr.t("Structure"), href: "/admin/structure" }]}
      description={Publr.t("Create field groups and choose where they appear.")}
      actions={
        <Button href="/admin/custom-fields/new">
          <Icon name="plus" size="sm" />
          <span>{Publr.t("Add field group")}</span>
        </Button>
      }
      empty={
        groups.length === 0 && (
          <Empty>
            <EmptyTitle>{Publr.t("No field groups yet")}</EmptyTitle>
            <EmptyDescription>{Publr.t("Add a group to extend users or media.")}</EmptyDescription>
          </Empty>
        )
      }
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Name")}</TableHead>
            <TableHead>{Publr.t("Handle")}</TableHead>
            <TableHead>{Publr.t("Status")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {groups.map((group) => (
            <TableRow>
              <TableCell>
                <Link href={group.href} variant="body-sm" tone="default">
                  {group.name}
                </Link>
              </TableCell>
              <TableCell>
                <Text as="span" variant="mono-xs" tone="muted">
                  {group.handle}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {group.status}
                </Text>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
