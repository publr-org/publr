import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Drawer } from "@publr/ui/Drawer.ptsx";
import { DrawerClose } from "@publr/ui/DrawerClose.ptsx";
import { DrawerContent } from "@publr/ui/DrawerContent.ptsx";
import { DrawerHeader } from "@publr/ui/DrawerHeader.ptsx";
import { DrawerTitle } from "@publr/ui/DrawerTitle.ptsx";
import { DrawerTrigger } from "@publr/ui/DrawerTrigger.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { StatusButton } from "@publr/ui/StatusButton.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

type Choice = {
  /** What the form sends: empty for everything, else an app's name. */
  value: string;
  label: string;
  current: boolean;
  /** The app's site, opened beside the choice; empty for everything. */
  href: string;
};

export type AppSwitcherProps = {
  /** What the admin shows now: "All apps" or an app's label. */
  current: string;
  /** The site of the app shown now; empty when it is not one app. */
  current_href: string;
  /** Everything, the project's own, then each app. */
  choices: Choice[];
  csrf: string;
  /** The page to come back to, narrowed. */
  back: string;
  /** What plugins join to the picker, after it (`app_picker_segment`). */
  after?: JSX.Element;
  /** Whether anything is joined after it. */
  extended: boolean;
  /** The project's only app's site: nothing to switch, so the picker is a link to it. Empty
   * with several apps. */
  only_href: string;
  /** The apps as a phone's drawer lists them (AppsPanel); empty when a joined segment's
   * drawer holds them, which on a phone then stands for the whole picker. */
  apps?: JSX.Element;
};

/** Which app the admin shows, top right: every record, or one app's, with a way to that
 * app's site. It only narrows what is listed; picking one reloads the
 * page. Plugins may join their own segments to it, one control. On a phone it is one
 * button: the site's icon for the only app, else the apps' opening a drawer of them, and
 * with a segment joined only the segment's, whose drawer lists the apps too. */
export function AppSwitcher({ current, current_href, choices, csrf, back, after, extended, only_href, apps }: AppSwitcherProps) {
  const linked = current_href !== "";

  return (
    <div class="inline-flex items-stretch" data-part="app-picker">
      {only_href !== "" && (
        <StatusButton
          stripe={false}
          href={only_href}
          target="_blank"
          icon_name="external"
          attach={extended ? "start" : "none"}
          label={Publr.t("View site")}
          compact={!extended}
          classes={extended ? "max-md:hidden" : ""}
        >
          {Publr.t("View site")}
        </StatusButton>
      )}
      {only_href === "" && (
      <DropdownMenu>
        <DropdownMenuTrigger asChild>
          <StatusButton
            stripe={false}
            prefix={linked ? Publr.t("App") : undefined}
            attach={linked || extended ? "start" : "none"}
            merge={linked ? "next" : "none"}
            label={Publr.t("Showing: {current}. Switch app", { current })}
            classes="max-md:hidden"
          >
            {current}
          </StatusButton>
        </DropdownMenuTrigger>
        <DropdownMenuContent align="right" classes="min-w-64">
          {choices.map((choice) => (
            <div class="contents" key={choice.value}>
              <div class="flex items-center gap-1" data-part="app-choice">
                <form method="post" action="/admin/app" class="min-w-0 flex-1">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="app" value={choice.value} />
                  <input type="hidden" name="back" value={back} />
                  <DropdownMenuItem type="submit">
                    <Text as="span" variant="body-md" classes="flex-1 truncate">
                      {choice.label}
                    </Text>
                    {choice.current && <Icon name="check" size="sm" />}
                  </DropdownMenuItem>
                </form>
                {choice.href !== "" && (
                  <Button
                    size="sm"
                    hierarchy="tertiary"
                    href={choice.href}
                    target="_blank"
                    label={Publr.t("Open {name}", { name: choice.label })}
                    title={Publr.t("Open {name}", { name: choice.label })}
                  >
                    <Icon name="external" size="sm" />
                  </Button>
                )}
              </div>
            </div>
          ))}
        </DropdownMenuContent>
      </DropdownMenu>
      )}
      {only_href === "" && linked && (
        <StatusButton
          stripe={false}
          href={current_href}
          target="_blank"
          icon_name="external"
          attach={extended ? "middle" : "end"}
          merge="previous"
          label={Publr.t("Open {name}", { name: current })}
          classes="max-md:hidden"
        />
      )}
      {only_href === "" && !extended && (
        <Drawer classes="md:hidden">
          <DrawerTrigger asChild>
            <StatusButton stripe={false} icon_name="layout-grid" label={Publr.t("Showing: {current}. Switch app", { current })} />
          </DrawerTrigger>
          <DrawerContent label={Publr.t("Apps")} classes="sm:max-w-sm">
            <DrawerHeader>
              <DrawerTitle>{Publr.t("Apps")}</DrawerTitle>
              <DrawerClose asChild>
                <Button hierarchy="tertiary" size="sm" label={Publr.t("Close")}>
                  <Icon name="x-close" size="sm" />
                </Button>
              </DrawerClose>
            </DrawerHeader>
            <div class="p-4">{apps}</div>
          </DrawerContent>
        </Drawer>
      )}
      {after}
    </div>
  );
}
