import { Layout } from "../layouts/Layout.ptsx";
import { UploadPlugin } from "../components/UploadPlugin.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginsProps = {
  user_name: string;
  user_email: string;
  can_structure?: boolean;
  can_settings?: boolean;
  csrf: string;
  nav: JSX.Element;
  /** `installed`: the ones loaded at runtime into the sandbox; `built_in`: the ones built
   * into this binary. */
  tab: string;
  /** The plugins built into this binary: always there, full access, nothing to decide. */
  built_in: Array<{ name: string; version: string; summary: string; brings: string }>;
  plugins: Array<{
    href: string;
    name: string;
    version: string;
    summary: string;
    enabled: boolean;
    /** How many requests wait for an administrator, as text; empty for none. */
    pending: string;
    /** The version of a newer module waiting to be applied; empty for none. */
    update: string;
    enable_href: string;
    update_href: string;
    disable_action: string;
    remove_action: string;
  }>;
};

/** Every plugin added, running or not: enable one to review what it asks for, update one
 * a newer module was uploaded for, stop or remove one. */
export function Plugins({ user_name, user_email, can_structure = true, can_settings = true, csrf, nav, tab, built_in, plugins }: PluginsProps) {
  return (
    <Layout title="Plugins" section="settings" sidebar={nav}
      user_name={user_name} user_email={user_email} can_structure={can_structure} can_settings={can_settings} csrf={csrf}>
      <div class="px-8 pt-7 pb-6">
        <PageHeader title="Plugins"
          description={tab === "installed"
            ? "Installed at runtime. Each runs in a sandbox and can do only what you grant it."
            : "Built into this binary: always running, with full access. A new build changes them."}>
          {tab === "installed" && <UploadPlugin csrf={csrf} />}
        </PageHeader>
        <TabNav label="Plugins" classes="mt-5">
          <TabNavLink href="/admin/settings/plugins" active={tab === "installed"}>Installed</TabNavLink>
          <TabNavLink href="/admin/settings/plugins/built-in" active={tab === "built_in"}>Built-in</TabNavLink>
        </TabNav>
      </div>
      {tab === "built_in" && (
        <div class="border-t border-border">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Plugin</TableHead>
                <TableHead>Version</TableHead>
                <TableHead>Brings</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {built_in.map((row) => (
                <TableRow>
                  <TableCell>
                    <Text as="p" variant="body-md">{row.name}</Text>
                    <Text as="p" variant="body-sm" tone="muted">{row.summary}</Text>
                  </TableCell>
                  <TableCell>{row.version}</TableCell>
                  <TableCell>{row.brings}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
          {built_in.length === 0 && (
            <div class="px-8 py-6">
              <Text as="p" variant="body-sm" tone="muted">This binary was built without plugins.</Text>
            </div>
          )}
        </div>
      )}
      {tab === "installed" && (
      <div class="border-t border-border">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Plugin</TableHead>
              <TableHead>Version</TableHead>
              <TableHead>Status</TableHead>
              <TableHead></TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {plugins.map((row) => (
              <TableRow>
                <TableCell>
                  <Link href={row.href}>{row.name}</Link>
                  <Text as="p" variant="body-sm" tone="muted">{row.summary}</Text>
                </TableCell>
                <TableCell>{row.version}</TableCell>
                <TableCell>
                  <div class="flex flex-col gap-1">
                    {row.enabled ? <Status tone="success">Enabled</Status> : <Status tone="neutral">Disabled</Status>}
                    {row.update !== "" && <Status tone="review">Update to {row.update} available</Status>}
                    {row.enabled && row.pending !== "" && <Status tone="warning">{row.pending} waiting for approval</Status>}
                  </div>
                </TableCell>
                <TableCell>
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    {!row.enabled && <Button href={row.enable_href} size="sm">Enable</Button>}
                    {row.update !== "" && <Button href={row.update_href} size="sm" hierarchy="secondary">Update</Button>}
                    {row.enabled && (
                      <form method="post" action={row.disable_action}>
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="next" value="list" />
                        <Button type="submit" size="sm" hierarchy="secondary">Disable</Button>
                      </form>
                    )}
                    <form method="post" action={row.remove_action}>
                      <input type="hidden" name="csrf" value={csrf} />
                      <Button type="submit" size="sm" hierarchy="tertiary" intent="destructive">Remove</Button>
                    </form>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
        {plugins.length === 0 && (
          <div class="px-8 py-6">
            <Text as="p" variant="body-sm" tone="muted">No plugin yet. Upload a plugin's .wasm file to add it.</Text>
          </div>
        )}
      </div>
      )}
    </Layout>
  );
}
