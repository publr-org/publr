import { Layout } from "../layouts/Layout.ptsx";
import { EditorColumn } from "../components/EditorColumn.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { ContentAccess } from "../components/ContentAccess.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { SectionTitle } from "@publr/ui/SectionTitle.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginProps = {
  user_name: string;
  user_email: string;
  can_structure?: boolean;
  can_settings?: boolean;
  top_bar?: JSX.Element;
  csrf: string;
  nav: JSX.Element;
  name: string;
  version: string;
  summary: string;
  enabled: boolean;
  /** The version of a newer module waiting to be applied, and its review; empty for none. */
  update: string;
  update_href: string;
  /** The version the last update replaced, to roll back to; empty for none. */
  previous: string;
  enable_href: string;
  disable_action: string;
  rollback_action: string;
  decide_action: string;
  access_action: string;
  remove_action: string;
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  operations: Array<{ name: string }>;
  show_access: boolean;
  scope: string;
  recommend: string;
  note: string;
  types: Array<{ handle: string; name: string; checked: boolean }>;
};

/** One plugin: whether it runs, its versions (an update waiting, the previous one to roll
 * back to), every permission it asked for, granted or revoked one at a time, its content
 * access, and what it brings. Revoking takes effect on its next call. */
export function Plugin({
  user_name, user_email, can_structure = true, can_settings = true, top_bar, csrf, nav, name, version, summary, enabled, update,
  update_href, previous, enable_href, disable_action, rollback_action, decide_action, access_action,
  remove_action, requests, operations, show_access, scope, recommend, note, types,
}: PluginProps) {
  return (
    <Layout title={name} section="settings" crumb_label="Plugins" crumb_href="/admin/settings/plugins"
      sidebar={nav} user_name={user_name} user_email={user_email} can_structure={can_structure} can_settings={can_settings} top_bar={top_bar} csrf={csrf}>
      <EditorColumn>
        <PageHeader title={name} description={summary} back_label="Plugins" back_href="/admin/settings/plugins">
          {enabled ? (
            <form method="post" action={disable_action}>
              <input type="hidden" name="csrf" value={csrf} />
              <Button type="submit" hierarchy="secondary">Disable</Button>
            </form>
          ) : (
            <Button href={enable_href}>Enable</Button>
          )}
        </PageHeader>
        <div class="mt-6 space-y-6">
          <div class="flex flex-wrap items-center gap-3">
            {enabled ? <Status tone="success">Enabled</Status> : <Status tone="neutral">Disabled</Status>}
            <Text as="span" variant="body-sm" tone="muted">Version {version}</Text>
          </div>
          {update !== "" && (
            <Callout title={`Version ${update} is available`} tone="info">
              <Text as="p" variant="body-sm">This version keeps running until you review and apply it.</Text>
              <Button href={update_href} size="sm" hierarchy="secondary" classes="mt-2">Review update</Button>
            </Callout>
          )}
          {previous !== "" && (
            <form method="post" action={rollback_action} class="flex flex-wrap items-center gap-3">
              <input type="hidden" name="csrf" value={csrf} />
              <Text as="span" variant="body-sm" tone="muted">Previous version {previous} is kept.</Text>
              <Button type="submit" size="sm" hierarchy="secondary">Roll back to {previous}</Button>
            </form>
          )}
          <SectionTitle title="Permissions" />
          {requests.length > 0 ? (
            <PluginRequests csrf={csrf} action={decide_action} requests={requests} />
          ) : (
            <Text as="p" variant="body-sm" tone="muted">It asks for nothing beyond its own operations and content types.</Text>
          )}
          {show_access && (
            <form method="post" action={access_action} class="space-y-4">
              <input type="hidden" name="csrf" value={csrf} />
              <ContentAccess scope={scope} recommend={recommend} note={note} types={types} />
              <Button type="submit" hierarchy="secondary">Save content access</Button>
            </form>
          )}
          <SectionTitle title="Operations" />
          <div class="flex flex-wrap gap-2">
            {operations.map((operation) => <Code>{operation.name}</Code>)}
          </div>
          <div class="border-t border-border pt-6">
            <Dialog>
              <DialogTrigger asChild>
                <Button hierarchy="secondary" intent="destructive">Remove plugin</Button>
              </DialogTrigger>
              <DialogContent>
                <DialogTitle>Remove {name}?</DialogTitle>
                <DialogDescription>
                  Its operations and hooks stop and its grants go. Its content types and their records stay.
                </DialogDescription>
                <form method="post" action={remove_action} class="mt-5 flex justify-end gap-2">
                  <input type="hidden" name="csrf" value={csrf} />
                  <DialogClose asChild>
                    <Button hierarchy="secondary">Cancel</Button>
                  </DialogClose>
                  <Button type="submit" intent="destructive">Remove plugin</Button>
                </form>
              </DialogContent>
            </Dialog>
          </div>
        </div>
      </EditorColumn>
    </Layout>
  );
}
