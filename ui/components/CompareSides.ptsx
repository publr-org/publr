export type CompareSidesProps = {
  /** What heads each column: the version on the left and the one on the right. */
  left: JSX.Element;
  right: JSX.Element;
};

/** The heads of a comparison's two columns, over its `CompareField` rows. */
export function CompareSides({ left, right }: CompareSidesProps) {
  return (
    <div class="grid grid-cols-2 border-b border-border" data-part="compare-sides">
      <div class="px-8 py-3">{left}</div>
      <div class="border-l border-border px-8 py-3">{right}</div>
    </div>
  );
}
