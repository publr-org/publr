import { Badge } from "@publr/ui/Badge.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import type { IconName } from "@publr/ui/Icon.ptsx";
import { SidebarNavEyebrow } from "@publr/ui/SidebarNavEyebrow.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { PinButton } from "./PinButton.ptsx";

export type SettingsNavProps = {
  /** Every page under Settings the viewer may see, in order: the admin's own, the pages
   * plugins add, the settings sections. Each pinnable to the viewer's rail. */
  pages: Array<{
    label: string;
    href: string;
    icon: IconName;
    /** A plugin's own icon, in the page's sprite; empty for one of the set. */
    custom_icon: string;
    active: boolean;
    plugin: string;
    page: string;
    pinned: boolean;
    /** Pinned by an administrator for everyone. */
    shared: boolean;
    /** What waits there, as a number (Site Health's cases); empty when nothing does. */
    count: string;
    /** Over the first page of a group, the group's name; empty for the rest. */
    group: string;
    /** Over the first settings section of an app, the app's name; empty for the rest. */
    heading: string;
  }>;
  /** For the pins' forms: the session's token, and this page to come back to. */
  csrf: string;
  back: string;
  /** Administrators pin for everyone too. */
  admin: boolean;
};

export function SettingsNav({ pages, csrf, back, admin }: SettingsNavProps) {
  return (
    <div data-slot="pages" class="flex flex-col">
      {pages.map((page) => (
        <div class="contents">
          {page.group !== "" && <SidebarNavEyebrow>{page.group}</SidebarNavEyebrow>}
          {page.heading !== "" && (
            <p class="px-2.5 pb-0.5 pt-2" data-part="settings-app">
              <Text as="span" variant="body-xs" tone="muted">
                {page.heading}
              </Text>
            </p>
          )}
        <div class="group flex items-center gap-1">
          <SidebarNavItem href={page.href} active={page.active} classes="min-w-0 flex-1">
            <Icon name={page.icon} custom_icon={page.custom_icon} size="sm" classes="shrink-0" />
            <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">{page.label}</Text>
            {page.count !== "" && <Badge size="xs">{page.count}</Badge>}
          </SidebarNavItem>
          {page.page !== "" && (
            <PinButton plugin={page.plugin} page={page.page} pinned={page.pinned} shared={page.shared} admin={admin} csrf={csrf} back={back} />
          )}
        </div>
        </div>
      ))}
    </div>
  );
}
