import { Publr } from "publr-jsx";
import { onOpenReference } from "./RecordEditor.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Checkbox } from "@publr/ui/Checkbox.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { InputGroup } from "@publr/ui/InputGroup.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { ReferenceCard } from "@publr/ui/ReferenceCard.ptsx";
import { Switch } from "@publr/ui/Switch.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Textarea } from "@publr/ui/Textarea.ptsx";
import { RichTextInput } from "@publr/ui/RichTextInput.ptsx";
import { FieldColor } from "./RecordEditor/FieldColor.ptsx";
import { PluginEditor } from "./PluginEditor.ptsx";
import { FieldEmbed } from "./RecordEditor/FieldEmbed.ptsx";
import { FieldMarkdown } from "./RecordEditor/FieldMarkdown.ptsx";
import { RecordMedia } from "./RecordEditor/RecordMedia.ptsx";
import { FieldRange } from "./RecordEditor/FieldRange.ptsx";
import { FieldSecret } from "./RecordEditor/FieldSecret.ptsx";

export type FieldControlProps = {
  /** The form field name: `title`, `tags[1]`, `seo.description`, `faq[0].question`. */
  name: string;
  /** input, number, range, datetime, date, textarea, switch, checkbox, radios, select,
   * slug, card, rich, json, editor (a plugin kind's own, in the plugin frame); `pick` (a reference pointing nowhere) is drawn by the page, which
   * has the target types. Radios and select options come as children. */
  control: string;
  value: string;
  checked: boolean;
  /** Shown, not edited: a slug locked on publish. */
  readonly?: boolean;
  /** Text beside a switch or checkbox: what "on" means. */
  label_on?: string;
  placeholder: string;
  rows: number;
  min: string;
  max: string;
  step: string;
  /** The address a slug completes, `https://site/posts/`, or a number's unit before it. */
  prefix: string;
  /** A number's unit after it: `kg`. */
  suffix?: string;
  /** What a reference card shows about the record it points at. */
  card_type: string;
  card_title: string;
  card_status: string;
  card_tone: string;
  card_href: string;
  /** The formatting a rich text value's editor offers, comma separated; empty for plain. */
  formats?: string;
  /** A plugin kind's editor (`editor`): its frame's address. */
  src?: string;
  /** Set when removing the card deletes its record: why, for the confirmation. */
  delete_note?: string;
  /** The reshape actions of one value in a list; empty when the value stands alone. */
  remove: string;
  up: string;
  down: string;
  /** The options of a select, rendered by the page. */
  children?: JSX.Element;
  /** A media value inside a group or a repeater (`media`): its file, and its field's rules. */
  files?: Array<{
    id: string;
    title: string;
    thumb: string;
    image: boolean;
    kind: string;
    icon: "video" | "audio" | "file";
    facts: string;
    missing: boolean;
    slot: string;
    place: string;
    first: boolean;
    last: boolean;
  }>;
  types?: Array<{ id: string; label: string }>;
  accept?: string;
  can_upload?: boolean;
};

/** One value of one field, drawn by its kind's control, with the move and remove
 * buttons of a value in a list. Every button is a named submit: the form comes back
 * reshaped, nothing is saved. */
export function FieldControl({
  name,
  control,
  value,
  checked,
  readonly = false,
  label_on = "",
  placeholder,
  rows,
  min,
  max,
  step,
  prefix,
  suffix = "",
  card_type,
  card_title,
  card_status,
  card_tone,
  card_href,
  formats = "",
  src = "",
  delete_note = "",
  remove,
  up,
  down,
  children,
  files = [],
  types = [],
  accept = "",
  can_upload = true,
}: FieldControlProps) {
  return (
    <div class="flex items-start gap-2">
      <div class="min-w-0 flex-1">
        {control === "input" && (
          <Input
            id={`field-${name}`}
            name={name}
            value={value}
            placeholder={placeholder}
            readOnly={readonly}
          />
        )}
        {control === "media" && (
          <RecordMedia name={name} many={false} types={types} accept={accept} can_upload={can_upload} files={files} />
        )}
        {control === "color" && <FieldColor id={`field-${name}`} name={name} value={value} label={name} />}
        {control === "time" && <Input id={`field-${name}`} name={name} type="time" value={value} classes="max-w-40" />}
        {control === "password" && <FieldSecret id={`field-${name}`} name={name} value={value} />}
        {control === "number" && prefix === "" && suffix === "" && (
          <Input
            id={`field-${name}`}
            type="number"
            name={name}
            value={value}
            placeholder={placeholder}
            min={min}
            max={max}
            step={step}
          />
        )}
        {control === "number" && prefix !== "" && (
          <InputGroup leading={prefix}>
            <Input
              id={`field-${name}`}
              type="number"
              name={name}
              value={value}
              placeholder={placeholder}
              min={min}
              max={max}
              step={step}
              inset
            />
          </InputGroup>
        )}
        {control === "number" && prefix === "" && suffix !== "" && (
          <InputGroup trailing_text={suffix}>
            <Input
              id={`field-${name}`}
              type="number"
              name={name}
              value={value}
              placeholder={placeholder}
              min={min}
              max={max}
              step={step}
              inset
            />
          </InputGroup>
        )}
        {control === "range" && (
          <FieldRange
            id={`field-${name}`}
            name={name}
            value={Number(value === "" ? min : value)}
            min={Number(min)}
            max={Number(max)}
            step={Number(step === "" ? "1" : step)}
          />
        )}
        {control === "rating" && (
          <div
            id={`field-${name}`}
            role="radiogroup"
            class="flex flex-row-reverse justify-end [&>label:has(input:checked)]:text-warning [&>label:has(input:checked)~label]:text-warning [&>label:has(input:checked)_svg]:fill-current [&>label:has(input:checked)~label_svg]:fill-current [&>label:hover]:text-warning/70"
          >
            {children}
          </div>
        )}
        {control === "datetime" && (
          <InputGroup trailing_text={suffix} classes="max-w-sm">
            <Input id={`field-${name}`} type="datetime-local" name={name} value={value} inset />
          </InputGroup>
        )}
        {control === "date" && <Input id={`field-${name}`} type="date" name={name} value={value} classes="max-w-xs" />}
        {control === "embed" && <FieldEmbed id={`field-${name}`} name={name} value={value} placeholder={placeholder} />}
        {control === "markdown" && <FieldMarkdown id={`field-${name}`} name={name} value={value} rows={rows} />}
        {control === "textarea" && (
          <Textarea id={`field-${name}`} name={name} value={value} rows={rows} />
        )}
        {control === "rich" && (
          <RichTextInput
            id={`field-${name}`}
            name={name}
            value={value}
            rows={rows}
            formats={formats}
            placeholder={placeholder}
          />
        )}
        {control === "editor" && <PluginEditor name={name} value={value} src={src} />}
        {control === "json" && (
          <Textarea
            id={`field-${name}`}
            name={name}
            value={value}
            rows={rows}
            placeholder="JSON"
            mono
          />
        )}
        {control === "switch" && (
          <label class="flex items-center gap-2.5 pt-1">
            <Switch id={`field-${name}`} name={name} value="1" checked={checked} />
            {label_on !== "" && (
              <Text as="span" variant="body-sm">
                {label_on}
              </Text>
            )}
          </label>
        )}
        {control === "checkbox" && (
          <label class="flex items-center gap-2.5 pt-1">
            <Checkbox id={`field-${name}`} name={name} value="1" checked={checked} />
            {label_on !== "" && (
              <Text as="span" variant="body-sm">
                {label_on}
              </Text>
            )}
          </label>
        )}
        {(control === "radios" || control === "buttons") && (
          <div class="flex flex-wrap gap-x-6 gap-y-2 pt-1" id={`field-${name}`}>
            {children}
          </div>
        )}
        {control === "select" && (
          <NativeSelect id={`field-${name}`} name={name}>
            {children}
          </NativeSelect>
        )}
        {control === "slug" && prefix !== "" && (
          <InputGroup leading={prefix}>
            <Input
              id={`field-${name}`}
              name={name}
              value={value}
              placeholder={placeholder}
              readOnly={readonly}
              inset
            />
          </InputGroup>
        )}
        {control === "slug" && prefix === "" && (
          <Input
            id={`field-${name}`}
            name={name}
            value={value}
            placeholder={placeholder}
            readOnly={readonly}
          />
        )}
        {control === "card" && (
          <ReferenceCard
            onOpen={onOpenReference}
            type_label={card_type}
            title={card_title}
            status={card_status}
            tone={card_tone}
            href={card_href}
          >
            <input type="hidden" name={name} value={value} />
            {up !== "" && (
              <Button
                type="submit"
                name="reshape"
                value={up}
                hierarchy="tertiary"
                size="xs"
                label={Publr.t("Move up")}
                title={Publr.t("Move up")}
              >
                <Icon name="chevron-up" size="xs" />
              </Button>
            )}
            {down !== "" && (
              <Button
                type="submit"
                name="reshape"
                value={down}
                hierarchy="tertiary"
                size="xs"
                label={Publr.t("Move down")}
                title={Publr.t("Move down")}
              >
                <Icon name="chevron-down" size="xs" />
              </Button>
            )}
            {remove !== "" && delete_note === "" && (
              <Button
                type="submit"
                name="reshape"
                value={remove}
                hierarchy="tertiary"
                size="xs"
                label={Publr.t("Remove")}
                title={Publr.t("Remove")}
              >
                <Icon name="x-close" size="xs" />
              </Button>
            )}
            {remove !== "" && delete_note !== "" && (
              <Dialog>
                <DialogTrigger asChild>
                  <Button type="button" hierarchy="tertiary" size="xs" label={Publr.t("Delete")} title={Publr.t("Delete")}>
                    <Icon name="trash" size="xs" />
                  </Button>
                </DialogTrigger>
                <DialogContent>
                  <DialogTitle>{Publr.t("Delete {title}?", { title: card_title })}</DialogTitle>
                  <DialogDescription>{delete_note}</DialogDescription>
                  <div class="mt-5 flex justify-end gap-2">
                    <DialogClose asChild>
                      <Button type="button" hierarchy="secondary">
                        {Publr.t("Cancel")}
                      </Button>
                    </DialogClose>
                    <Button type="submit" form="record" name="reshape" value={remove} intent="destructive">
                      {Publr.t("Delete")}
                    </Button>
                  </div>
                </DialogContent>
              </Dialog>
            )}
          </ReferenceCard>
        )}
      </div>
      {remove !== "" && control !== "card" && (
        <span class="inline-flex shrink-0 items-center gap-1 pt-0.5">
          <Button
            type="submit"
            name="reshape"
            value={up}
            hierarchy="tertiary"
            size="sm"
            label={Publr.t("Move up")}
            title={Publr.t("Move up")}
          >
            <Icon name="chevron-up" size="sm" />
          </Button>
          <Button
            type="submit"
            name="reshape"
            value={down}
            hierarchy="tertiary"
            size="sm"
            label={Publr.t("Move down")}
            title={Publr.t("Move down")}
          >
            <Icon name="chevron-down" size="sm" />
          </Button>
          <Button
            type="submit"
            name="reshape"
            value={remove}
            hierarchy="tertiary"
            size="sm"
            label={Publr.t("Remove")}
            title={Publr.t("Remove")}
          >
            <Icon name="x-close" size="sm" />
          </Button>
        </span>
      )}
    </div>
  );
}
