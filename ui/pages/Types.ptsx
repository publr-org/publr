import { Layout } from "../layouts/Layout.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { PageHeader } from "@publr/ui/PageHeader.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type TypesProps = {
  user_name: string;
  user_email: string;
  /** The rail sections the viewer may open besides Content: set by the server from what
   * the viewer's roles grant. */
  can_structure?: boolean;
  can_settings?: boolean;
  csrf: string;
  /** "Content types" or "Taxonomies": the page, its header and its empty state. */
  title: string;
  new_href: string;
  new_label: string;
  empty_title: string;
  empty_description: string;
  /** Content types have a kind; taxonomies do not. */
  show_kind: boolean;
  /** What the last column's button says: "Manage" (records) or "Terms". */
  manage_label: string;
  types: Array<{
    href: string;
    name: string;
    handle: string;
    kind: string;
    visibility: string;
    owner: string;
    fields: number;
    content_href: string;
  }>;
};

export function Types({
  user_name,
  user_email, can_structure = true, can_settings = true,
  csrf,
  title,
  new_href,
  new_label,
  empty_title,
  empty_description,
  show_kind,
  manage_label,
  types,
}: TypesProps) {
  return (
    <Layout
      title={title}
      section="types"
      user_name={user_name}
      user_email={user_email}
      can_structure={can_structure}
      can_settings={can_settings}
      csrf={csrf}
    >
      <div class="px-8 pt-7 pb-6">
        <PageHeader title={title} description={`${types.length} defined`}>
          <Button href={new_href}>
            <Icon name="plus" size="sm" />
            <span>{new_label}</span>
          </Button>
        </PageHeader>
      </div>
      {types.length === 0 ? (
        <div class="mx-8">
          <Empty>
            <EmptyTitle>{empty_title}</EmptyTitle>
            <EmptyDescription>{empty_description}</EmptyDescription>
          </Empty>
        </div>
      ) : (
        <div class="border-t border-border">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Name</TableHead>
                <TableHead>Handle</TableHead>
                {show_kind && <TableHead>Kind</TableHead>}
                <TableHead>Visibility</TableHead>
                <TableHead>Owner</TableHead>
                <TableHead align="right">Fields</TableHead>
                <TableHead align="right">{manage_label}</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {types.map((entry) => (
                <TableRow>
                  <TableCell>
                    <Link href={entry.href} variant="body-md" tone="default">
                      {entry.name}
                    </Link>
                  </TableCell>
                  <TableCell>
                    <Text as="span" variant="mono-xs" tone="muted">
                      {entry.handle}
                    </Text>
                  </TableCell>
                  {show_kind && (
                    <TableCell>
                      <Text as="span" variant="body-md" tone="muted">
                        {entry.kind}
                      </Text>
                    </TableCell>
                  )}
                  <TableCell>
                    <Text as="span" variant="body-md" tone="muted">
                      {entry.visibility}
                    </Text>
                  </TableCell>
                  <TableCell>
                    <Text as="span" variant="body-md" tone="muted">
                      {entry.owner}
                    </Text>
                  </TableCell>
                  <TableCell numeric align="right">
                    <Text as="span" variant="body-md">
                      {entry.fields}
                    </Text>
                  </TableCell>
                  <TableCell align="right">
                    {entry.content_href !== "" && (
                      <Button href={entry.content_href} hierarchy="secondary" size="sm">
                        <span>{manage_label}</span>
                        <Icon name="chevron-right" size="xs" />
                      </Button>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      )}
    </Layout>
  );
}
