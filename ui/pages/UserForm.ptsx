import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { Code } from "@publr/ui/Code.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { FieldSet } from "@publr/ui/FieldSet.ptsx";
import { Input } from "@publr/ui/Input.ptsx";

export type UserFormProps = {
  title: string;
  /** Where the form posts: create, or update of an existing account. */
  action: string;
  is_new: boolean;
  /** The account being edited is the signed-in user's own: its roles are fixed. */
  is_me: boolean;
  name: string;
  email: string;
  /** Every role the project has, ticked when the account holds it. */
  roles: Array<{ name: string; label: string; description: string; checked: boolean }>;
  /** An existing account that has not set its password yet. */
  invited: boolean;
  /** A set-password link just issued, shown exactly once; empty otherwise. */
  link: string;
  link_action: string;
  delete_action: string;
  /** What was refused when the last post did not go through; empty otherwise. */
  problem: string;
  /** The custom field rows (RecordFields): one group per custom field group that applies
   * to the account, each field named `<group>.<field>`; absent for a new account, whose
   * roles are not known yet. */
  fields?: JSX.Element;
  /** The custom field values refused, by path, when the last post did not go through. */
  problems: Array<{ code: string; text: string }>;
};

/** One account: its name, email and roles. A new account is invited with a set-password
 * link unless a password is typed; an existing one can be renamed, given other roles,
 * sent a fresh link, or deleted. */
export function UserForm({
  title,
  action,
  is_new,
  is_me,
  name,
  email,
  roles,
  invited,
  link,
  link_action,
  delete_action,
  problem,
  fields,
  problems,
}: UserFormProps) {
  return (
    <FormPage
      title={title}
      parents={[{ label: "Users", href: "/admin/settings/users" }]}
      problems={problems}
      problems_title="The custom fields were not saved."
      notice={
        (problem !== "" && (
          <Callout tone="error" title="The user was not saved.">
            {problem}
          </Callout>
        )) ||
        (link !== "" && (
          <Callout title="Set-password link">
            Send this link to {name}; it works once, for an hour, and is shown only now. Prefix it
            with the site's address.
          </Callout>
        ))
      }
      aside={
        <div class="contents">
          <EditorAsideSection>
            <Button type="submit" form="user" classes="w-full">
              {is_new ? "Create user" : "Save"}
            </Button>
            <Button href="/admin/settings/users" hierarchy="tertiary" classes="w-full">
              Cancel
            </Button>
          </EditorAsideSection>
          {link !== "" && (
            <EditorAsideSection title="Link">
              <Code classes="break-all">{link}</Code>
            </EditorAsideSection>
          )}
          {!is_new && (
            <EditorAsideSection title="Password">
              <form method="post" action={link_action}>
                <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
                <Button type="submit" hierarchy="secondary" classes="w-full">
                  {invited ? "New set-password link" : "Reset password by link"}
                </Button>
              </form>
            </EditorAsideSection>
          )}
        </div>
      }
      danger={
        !is_new &&
        !is_me && (
          <ConfirmAction
            label="Delete user"
            title={`Delete ${name}?`}
            description="The account goes for good and is signed out everywhere. What they created stays."
            action={delete_action}
          />
        )
      }
    >
      <form id="user" method="post" action={action} class="flex flex-col gap-5">
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        <Field>
          <FieldLabel htmlFor="display_name">Name</FieldLabel>
          <Input id="display_name" name="display_name" value={name} required autocomplete="off" />
        </Field>
        <Field>
          <FieldLabel htmlFor="email">Email</FieldLabel>
          <Input
            id="email"
            type="email"
            name="email"
            value={email}
            required={is_new}
            readOnly={!is_new}
            autocomplete="off"
          />
          {!is_new && <FieldDescription>The email an account signs in with cannot change.</FieldDescription>}
        </Field>
        <FieldSet legend="Roles">
          {roles.map((role) => (
            <CheckboxField
              id={`role-${role.name}`}
              name="roles"
              value={role.name}
              checked={role.checked}
              disabled={is_me}
              label={role.label}
              description={role.description}
            />
          ))}
          {is_me && <FieldDescription>Your own roles are changed by another admin.</FieldDescription>}
        </FieldSet>
        {is_new && (
          <Field>
            <FieldLabel htmlFor="password">Password</FieldLabel>
            <Input id="password" type="password" name="password" autocomplete="new-password" />
            <FieldDescription>
              Leave it empty to invite the person with a set-password link instead.
            </FieldDescription>
          </Field>
        )}
        {fields && (
          <div class="flex flex-col gap-5 border-t border-border pt-6" data-part="user-fields">
            {fields}
          </div>
        )}
      </form>
    </FormPage>
  );
}
