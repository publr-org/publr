import { Code } from "@publr/ui/Code.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type FieldProblemsProps = {
  problems: Array<{
    path: string;
    message: string;
  }>;
};

export function FieldProblems({ problems }: FieldProblemsProps) {
  return (
    <div class="mt-6 rounded-xl border border-destructive/30 bg-destructive/5 px-5 py-4">
      <Text as="p" variant="body-sm" tone="error" classes="font-medium">
        The field was not saved.
      </Text>
      <ul class="mt-2 flex flex-col gap-1">
        {problems.map((problem) => (
          <li class="flex items-baseline gap-2">
            {problem.path !== "" && <Code>{problem.path}</Code>}
            <Text as="span" variant="body-sm">
              {problem.message}
            </Text>
          </li>
        ))}
      </ul>
    </div>
  );
}
