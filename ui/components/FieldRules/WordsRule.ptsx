import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type WordsRuleProps = {
  limit_words?: boolean;
  words_min?: string;
  words_max?: string;
  words_message?: string;
  min?: string;
};

export function WordsRule({
  limit_words = false,
  words_min = "",
  words_max = "",
  words_message = "",
  min = "",
}: WordsRuleProps) {
  return (
    <CheckboxField
      id="limit_words"
      name="limit_words"
      checked={limit_words}
      label="Limit word count"
      description="Specify a minimum and/or maximum allowed number of words"
    >
      <div class="flex flex-wrap items-center gap-3">
        <Input
          id="words_min"
          name="words_min"
          type="number"
          min="0"
          value={words_min}
          placeholder="Min"
          classes="w-32"
        />
        <Text as="span" variant="body-md">
          and
        </Text>
        <Input
          id="words_max"
          name="words_max"
          type="number"
          min="0"
          value={words_max}
          placeholder="Max"
          classes="w-32"
        />
      </div>
      <Field>
        <FieldLabel htmlFor="words_message">Custom error message</FieldLabel>
        <Input id="words_message" name="words_message" value={words_message} maxLength={255} />
      </Field>
    </CheckboxField>
  );
}
