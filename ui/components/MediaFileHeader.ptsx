import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Dialog } from "@publr/ui/Dialog.ptsx";
import { DialogClose } from "@publr/ui/DialogClose.ptsx";
import { DialogContent } from "@publr/ui/DialogContent.ptsx";
import { DialogDescription } from "@publr/ui/DialogDescription.ptsx";
import { DialogTitle } from "@publr/ui/DialogTitle.ptsx";
import { DialogTrigger } from "@publr/ui/DialogTrigger.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type MediaFileHeaderProps = {
  id: string;
  title: string;
  filename: string;
  facts: string;
  uploaded: string;
  url: string;
  saved: boolean;
};

/** The band over one file: its name and facts, Open file, and Delete behind a confirm. */
export function MediaFileHeader({ id, title, filename, facts, uploaded, url, saved }: MediaFileHeaderProps) {
  return (
    <div class="flex flex-wrap items-center gap-3 px-6 py-3" data-part="media-file-header">
      <div class="flex min-w-0 flex-1 flex-col">
        <Heading level={1} size="sm" classes="truncate">{title}</Heading>
        <Text as="span" variant="body-xs" tone="muted" classes="truncate">{`${filename} · ${facts} · uploaded ${uploaded}`}</Text>
      </div>
      {saved && <Status tone="success">Saved</Status>}
      <Button href={url} target="_blank" hierarchy="secondary" size="sm">
        <Icon name="external" size="sm" />
        <span>Open file</span>
      </Button>
      <Dialog>
        <DialogTrigger asChild>
          <Button type="button" hierarchy="secondary" intent="destructive" size="sm">
            <Icon name="trash" size="sm" />
            <span>Delete</span>
          </Button>
        </DialogTrigger>
        <DialogContent>
          <DialogTitle>{`Delete ${title}?`}</DialogTitle>
          <DialogDescription>The file and its resized copies are removed for good.</DialogDescription>
          <form method="post" action={`/admin/media/${id}/delete`} class="mt-4 flex justify-end gap-2">
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            <DialogClose asChild><Button type="button" hierarchy="secondary">Cancel</Button></DialogClose>
            <Button type="submit" intent="destructive">Delete file</Button>
          </form>
        </DialogContent>
      </Dialog>
    </div>
  );
}
