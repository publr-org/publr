import type { NavigationStore } from "./Navigation.ptsx";
import { Publr } from "publr-jsx";
import { Breadcrumb } from "@publr/ui/Breadcrumb.ptsx";
import { BreadcrumbItem } from "@publr/ui/BreadcrumbItem.ptsx";
import { BreadcrumbLink } from "@publr/ui/BreadcrumbLink.ptsx";
import { BreadcrumbList } from "@publr/ui/BreadcrumbList.ptsx";
import { BreadcrumbPage } from "@publr/ui/BreadcrumbPage.ptsx";

export type CrumbsProps = {
  title: string;
  /** The pages between the area and this one. */
  parents: Array<{ label: string; href: string }>;
};

/** Where the page stands: the area (from the request), its parents, the page, then the
 * levels open in a drawer, each a way back. The overview is the area itself. */
export function Crumbs({ title, parents }: CrumbsProps) {
  return (
    <div class="flex min-w-0" data-part="crumbs">
      <Breadcrumb>
        <BreadcrumbList>
          {Publr.request.admin.area === "overview" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbPage>{Publr.t("Overview")}</BreadcrumbPage>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "content" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbLink href="/admin/content">{Publr.t("Content")}</BreadcrumbLink>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "media" && title === "Media" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbPage>{Publr.t("Media")}</BreadcrumbPage>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "media" && title !== "Media" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbLink href="/admin/media">{Publr.t("Media")}</BreadcrumbLink>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "design" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbLink href="/admin/design/system">{Publr.t("Design")}</BreadcrumbLink>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "section" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbLink href={Publr.request.admin.section_href}>{Publr.request.admin.section}</BreadcrumbLink>
            </BreadcrumbItem>
          )}
          {Publr.request.admin.area === "settings" && (
            <BreadcrumbItem classes="shrink-0">
              <BreadcrumbLink href="/admin/settings">{Publr.t("Settings")}</BreadcrumbLink>
            </BreadcrumbItem>
          )}
          {parents.map((parent) => (
            <BreadcrumbItem separated classes="shrink-0">
              <BreadcrumbLink href={parent.href}>{parent.label}</BreadcrumbLink>
            </BreadcrumbItem>
          ))}
          {Publr.request.admin.area !== "overview" && (Publr.request.admin.area !== "media" || title !== "Media") && (
            <BreadcrumbItem separated>
              <span class="flex min-w-0" hidden={(Publr.stores.navigation as NavigationStore).open}>
                <BreadcrumbPage>{title}</BreadcrumbPage>
              </span>
              <span class="flex min-w-0" hidden={!(Publr.stores.navigation as NavigationStore).open}>
                <BreadcrumbLink
                  href="#"
                  onClick={(Publr.stores.navigation as NavigationStore).back}
                  data-depth="0"
                  data-part="drawer-crumb"
                >
                  {title}
                </BreadcrumbLink>
              </span>
            </BreadcrumbItem>
          )}
          {(Publr.stores.navigation as NavigationStore).levels.map((level) => (
            <BreadcrumbItem key={level.depth} separated data-part="drawer-crumb-row">
              <span class="flex min-w-0" hidden={!level.top}>
                <BreadcrumbPage>{level.title}</BreadcrumbPage>
              </span>
              <span class="flex min-w-0" hidden={level.top}>
                <BreadcrumbLink
                  href="#"
                  onClick={(Publr.stores.navigation as NavigationStore).back}
                  data-depth={level.depth}
                  data-part="drawer-crumb"
                >
                  {level.title}
                </BreadcrumbLink>
              </span>
            </BreadcrumbItem>
          ))}
        </BreadcrumbList>
      </Breadcrumb>
    </div>
  );
}
