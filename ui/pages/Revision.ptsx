import { Publr } from "publr-jsx";
import { FormPage } from "../layouts/FormPage.ptsx";
import { EditorAsideSection } from "../components/EditorAsideSection.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { CodeBlock } from "@publr/ui/CodeBlock.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

/** One kept version, field by field, with a way to bring it back. */
export type RevisionProps = {
  title: string;
  versions_title: string;
  versions_href: string;
  record_href: string;
  kind: string;
  at: string;
  by: string;
  fields: Array<{ label: string; value: string }>;
  restore_action: string;
  seq: string;
  expected_version: string;
};

export function Revision({
  title,
  versions_title,
  versions_href,
  record_href,
  kind,
  at,
  by,
  fields,
  restore_action,
  seq,
  expected_version,
}: RevisionProps) {
  return (
    <FormPage
      title={title}
      parents={[{ label: versions_title, href: versions_href }]}
      description={`${kind}, taken ${at} by ${by}`}
      actions={
        <Button href={record_href} hierarchy="secondary">
          The record
        </Button>
      }
      aside={
        <EditorAsideSection>
          <form method="post" action={restore_action}>
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            <input type="hidden" name="seq" value={seq} />
            <input type="hidden" name="expected_version" value={expected_version} />
            <Button type="submit" classes="w-full">
              <Icon name="clock-rewind" size="sm" />
              <span>Restore this version</span>
            </Button>
          </form>
          <Text as="p" variant="body-sm" tone="muted">
            Restoring is a normal save: parked as pending changes when the record is live.
          </Text>
        </EditorAsideSection>
      }
    >
      <dl class="divide-y divide-border border-y border-border">
        {fields.map((field) => (
          <div class="grid gap-1 py-4 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8">
            <Text as="dt" variant="body-sm" tone="muted">
              {field.label}
            </Text>
            <dd class="m-0 min-w-0">
              <CodeBlock>{field.value}</CodeBlock>
            </dd>
          </div>
        ))}
      </dl>
    </FormPage>
  );
}
