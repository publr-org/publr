import { Publr } from "publr-jsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type ListDetailItemProps = {
  label: string;
  href: string;
  /** The one open in the detail. */
  current?: boolean;
  /** `done` (checked), `todo` (still to deal with), or empty for nothing to deal with. */
  marker?: string;
};

/** One thing in a ListDetailPage's list, leading to its detail: the open one marked, a
 * done one checked, one still to do dotted. A sidebar row like any other. */
export function ListDetailItem({ label, href, current = false, marker = "" }: ListDetailItemProps) {
  return (
    <li data-part="list-detail-item">
      <SidebarNavItem href={href} active={current}>
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {label}
        </Text>
        {marker === "done" && (
          <Text as="span" variant="body-sm" tone="success" classes="shrink-0">
            <Icon name="check" size="sm" />
          </Text>
        )}
        {marker === "todo" && <span class="size-2 shrink-0 rounded-full bg-warning" aria-label={Publr.t("To resolve")}></span>}
      </SidebarNavItem>
    </li>
  );
}
