import { Publr } from "publr-jsx";
import { PluginTour } from "./PluginTour.ptsx";

export const frame_ref = Publr.ref<HTMLIFrameElement>();
export const state = Publr.reactive({
  height: 0,
  plugin: "",
  page: "",
  csrf: "",
  operations: [] as string[],
});

/** Another page of the plugin's, or this one with another query: `notes`, `?week=2`,
 * `notes?week=2`; or an address in the admin, `/admin/roles/add`. Nothing else leaves the
 * frame as an address. */
const page_address = /^([a-z0-9-]{1,48})?(\?[^#]*)?$/;
const admin_address = /^\/admin(\/[^\s#]*)?$/;

export function go(to: string, plugin: string, current: string, frame?: HTMLIFrameElement) {
  // The frame's own address (a view asking `ctx.navigate(location.pathname + search)` once
  // a write went through) is the admin page around it, never the bare frame: a panel's
  // page is drawn again, a page's opens with the query asked.
  const own = frame ? own_query(frame, to) : null;
  const same = frame ? new URL(frame.src, window.location.href).search === own : false;
  if (own !== null && (current === "" || same)) {
    window.location.reload();
    return;
  }
  if (own !== null) {
    window.location.href = Publr.url(`/admin/plugin/${plugin}/${current}${own}`);
    return;
  }
  // The frame's links were written under the page's base (`/branches/x/admin/…`).
  to = Publr.path(to);
  if (admin_address.test(to)) {
    window.location.href = Publr.url(to);
    return;
  }
  const match = page_address.exec(to);
  if (to === "" || !match) return;
  const page = match[1] ?? current;
  if (page === "") return;
  window.location.href = Publr.url(`/admin/plugin/${plugin}/${page}${match[2] ?? ""}`);
}

/** When `to` is an absolute path to the frame's own document, its query (`?id=…`, or
 * empty); else null. */
function own_query(frame: HTMLIFrameElement, to: string): string | null {
  if (!to.startsWith("/")) return null;
  const at = new URL(frame.src, window.location.href);
  const asked = new URL(to, at);
  return asked.pathname === at.pathname ? asked.search : null;
}

/** What a frame's reads read, as the change log's keys, and the revision they were read
 * at: while it is on screen the admin asks `/admin/live` every few seconds whether one
 * changed, and tells the frame to read again when one did. */
type Followed = { keys: Set<string>; since: number; timer: number };
const followed = new WeakMap<HTMLIFrameElement, Followed>();
const follow_ms = 3000;

async function look(frame: HTMLIFrameElement, follow: Followed) {
  if (!frame.isConnected) {
    clearInterval(follow.timer);
    followed.delete(frame);
    return;
  }
  if (document.hidden || follow.keys.size === 0) return;
  const keys = Array.from(follow.keys).join(",");
  const asked = `/admin/live?since=${follow.since}&keys=${encodeURIComponent(keys)}`;
  const response = await fetch(Publr.url(asked), { credentials: "same-origin" }).catch(() => null);
  const answer = response && response.ok ? await response.json().catch(() => null) : null;
  if (!answer || !answer.changed) return;
  follow.keys.clear();
  follow.since = Number(answer.revision) || follow.since;
  reply(frame, { kind: "changed" });
}

/** Keeps what a read the frame asked for read, from its answer's headers. */
function follow(frame: HTMLIFrameElement | undefined, response: Response) {
  const keys = response.headers.get("X-Publr-Follows");
  const revision = Number(response.headers.get("X-Publr-Revision"));
  if (!frame || !keys || !Number.isFinite(revision)) return;
  let held = followed.get(frame);
  if (!held) {
    held = { keys: new Set(), since: revision, timer: 0 };
    const kept = held;
    held.timer = setInterval(() => look(frame, kept), follow_ms) as unknown as number;
    followed.set(frame, held);
  }
  held.since = Math.min(held.since, revision);
  for (const key of keys.split(",")) held.keys.add(key);
}

/** What a frame is told of a failed call: the message, and when the server refused it, its
 * code and field problems (`Publr.send` refuses with both). */
export function refusal(id: number, error: unknown): object {
  const refused = error as { message?: string; code?: string; problems?: unknown };
  return {
    id,
    ok: false,
    error: String(refused.message ?? ""),
    code: typeof refused.code === "string" ? refused.code : "",
    problems: Array.isArray(refused.problems) ? refused.problems : [],
  };
}

export async function run(operation: string, input: unknown, csrf: string, frame?: HTMLIFrameElement): Promise<unknown> {
  return Publr.send(operation, input, {
    csrf,
    headers: { "X-Publr-Follow": "1" },
    response: (response) => {
      if (response.ok) follow(frame, response);
    },
  });
}

export function reply(frame: HTMLIFrameElement, answer: object) {
  frame.contentWindow?.postMessage(Object.assign({ publr: 1 }, answer), "*");
}

/** Runs what the frame asks when it is one of the plugin's own operations, as the person
 * looking at it, through the same checks as any call. */
export async function answer(
  frame: HTMLIFrameElement,
  id: number,
  operation: string,
  input: unknown,
  operations: string[],
  csrf: string,
) {
  if (!operations.includes(operation)) {
    reply(frame, { id, ok: false, error: `${operation} is not one of this plugin's operations` });
    return;
  }
  try {
    reply(frame, { id, ok: true, value: await run(operation, input, csrf, frame) });
  } catch (error) {
    reply(frame, refusal(id, error));
  }
}

/** The plugin's own log lines after `after`, newest first: what its code logged as it ran,
 * read as the person looking. Only its own plugin's. */
export async function log(frame: HTMLIFrameElement, id: number, after: number, plugin: string, csrf: string) {
  try {
    const answer = (await run("plugin.log", { name: plugin, limit: 50 }, csrf)) as {
      lines?: Array<{ id: number }>;
    };
    const lines = (answer.lines ?? []).filter((line) => line.id > after);
    reply(frame, { id, ok: true, value: { lines } });
  } catch (error) {
    reply(frame, { id, ok: false, error: (error as Error).message });
  }
}

export const received = (event: MessageEvent) => {
  const frame = frame_ref.current;
  const message = event.data;
  if (!frame || event.source !== frame.contentWindow || !message || message.publr !== 1) return;
  if (message.kind === "hello") reply(frame, { kind: "ready" });
  if (message.kind === "height") state.height = Math.min(Math.max(Number(message.height) || 0, 0), 100000);
  if (message.kind === "navigate") go(String(message.to), state.plugin, state.page, frame);
  const id = Number(message.id);
  if (message.kind === "call") answer(frame, id, String(message.operation), message.input, state.operations, state.csrf);
  if (message.kind === "log") log(frame, id, Number(message.after) || 0, state.plugin, state.csrf);
  // To the tour player beside it: a message to this window, which only the admin sends.
  if (message.kind === "tour") window.postMessage({ publr_tour: message.steps }, location.origin);
};

export type PluginFrameProps = {
  /** The frame's document. */
  src: string;
  title: string;
  plugin: string;
  page: string;
  csrf: string;
  /** The plugin's own operations: the only ones the frame may ask for. */
  operations: string[];
  /** As tall as the window, whatever the frame shows: a page drawn alone. */
  fill?: boolean;
};

/** A plugin's page in the plugin frame: an opaque, sandboxed iframe that grows with what
 * it shows and talks to the admin only through `received`. */
export function PluginFrame({ src, title, plugin, page, csrf, operations, fill = false }: PluginFrameProps) {
  state.plugin = plugin;
  state.page = page;
  state.csrf = csrf;
  state.operations = operations;
  state.height = 0;
  return (
    <div class="contents">
      <iframe
        ref={frame_ref}
        src={src}
        title={title}
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
        class="block min-h-full w-full flex-auto shrink-0 border-0"
        style={fill ? "height:100vh" : state.height > 0 ? `height:${state.height}px` : ""}
        onWindowMessage={received}
      ></iframe>
      <PluginTour />
    </div>
  );
}
