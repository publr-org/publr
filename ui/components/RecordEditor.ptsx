import { PanelTab } from "@publr/ui/PanelTab.ptsx";
import { Heading } from "@publr/ui/Heading.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { ChoiceButton } from "@publr/ui/ChoiceButton.ptsx";
import { RecordSingle } from "./RecordEditor/RecordSingle.ptsx";
import { RecordActions } from "./RecordEditor/RecordActions.ptsx";
import { RecordHeader } from "./RecordEditor/RecordHeader.ptsx";
import { RecordRepeater } from "./RecordEditor/RecordRepeater.ptsx";
import { RecordGroup } from "./RecordEditor/RecordGroup.ptsx";
import type { ItemLine, OpenedCell } from "./RecordEditor/RecordCell.ptsx";
import { RecordMany } from "./RecordEditor/RecordMany.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { mutation } from "publr";
import { invalidate } from "publr/query";
import { Publr } from "publr-jsx";
import { FormBody } from "./FormBody.ptsx";
import { Separator } from "@publr/ui/Separator.ptsx";
import { StatusStrip } from "@publr/ui/StatusStrip.ptsx";
import { Field } from "@publr/ui/Field.ptsx";
import { CheckboxField } from "@publr/ui/CheckboxField.ptsx";
import { FieldDescription } from "@publr/ui/FieldDescription.ptsx";
import { FieldLabel } from "@publr/ui/FieldLabel.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Textarea } from "@publr/ui/Textarea.ptsx";
import { TextToggle } from "@publr/ui/TextToggle.ptsx";

/** The editor's client half. The form autosaves: every input marks it dirty and, after a
 * pause, posts it as JSON, which answers the new version (or why it could not be saved).
 * Every submit inside the editor (a reshape, a status action) is posted with fetch and
 * the answer, the editor drawn again, replaces this one in place; a reference card's open
 * row and the add slot's buttons ask the page's drawer to open instead of navigating. */
export const tabKeys = (event: KeyboardEvent) => {
  const tabs = Array.from((event.currentTarget as HTMLElement).querySelectorAll<HTMLButtonElement>("[role=tab]"));
  const index = tabs.indexOf(event.target as HTMLButtonElement);
  const next = event.key === "ArrowRight" ? (index + 1) % tabs.length
    : event.key === "ArrowLeft" ? (index + tabs.length - 1) % tabs.length
    : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
  if (next < 0) return;
  event.preventDefault();
  tabs[next].click();
  tabs[next].focus();
};

export type RecordAction = {
  name: string;
  value: string;
  label: string;
  destructive: boolean;
  primary: boolean;
};

export const state = Publr.reactive({
  /** "Destroy for good" was chosen: the confirm under the actions waits for a second word. */
  destroy_armed: false,
  /** The record's type handle: what an opened item's fields are looked up in. */
  type: "",
  /** Past the fold, what the browser drew after the page: the fields of items and groups
   * opened (`faq[60]`, `seo`) and the items of runs listed (`faq[59+]`), by path. */
  opened: {} as Record<string, Array<OpenedCell>>,
  listed: {} as Record<string, Array<ItemLine>>,
  opening: "",
  open_failed: "",
  id: "",
  version: "",
  save_url: "",
  submit_url: "",
  create_url: "",
  record_url: "",
  base_url: "",
  csrf: "",
  in_drawer: false,
  saved_text: Publr.t("All changes saved"),
  dirty: false,
  busy: false,
  submitting: false,
  refresh_error: false,
  save_error: false,
  edit_revision: 0,
  title: "",
  status: "",
  status_label: "",
  changed: false,
  parks: false,
  has_destructive: false,
  /** Whether an action is the split button's face; else the menu stands alone. */
  has_primary: false,
  actions: [] as RecordAction[],
  /** How many values the form holds now, and the most an entry may: from three quarters
   * of it, the editor says so, and past it a save is refused. */
  values_count: 0,
  values_max: 0,
  values_near: false,
  values_over: false,
  values_text: "",
  /** The language the translated fields show, by code; empty for the main one. */
  language: "",
  languages: [] as Array<{ code: string; label: string }>,
  /** What the last refused save said, under each top-level field by its name. */
  problems: {} as Record<string, string>,
});

/** Each refused path under its top-level field (`gallery[2].caption` under `gallery`), the
 * first problem a field has. */
const problems_by_field = (list: Array<{ field: string; message: string }>) => {
  const by_field: Record<string, string> = {};
  for (const problem of list) {
    const field = problem.field.split(/[.[]/)[0];
    if (field !== "" && !(field in by_field)) by_field[field] = problem.message;
  }
  return by_field;
};

/** The form's own fields, not values of the entry. */
const form_fields = new Set(["csrf", "type", "expected_version"]);

/** The values the form holds now: every one a save would send, the form's own aside. */
const recount = (form: HTMLFormElement) => {
  let count = 0;
  for (const [name] of new FormData(form)) {
    if (!form_fields.has(name)) count += 1;
  }
  showValues(count);
};

const showValues = (count: number) => {
  const max = state.values_max;
  state.values_count = count;
  state.values_near = max > 0 && count * 4 >= max * 3;
  state.values_over = max > 0 && count > max;
  state.values_text = Publr.t("{count} of {max} values", {
    count: count.toLocaleString(),
    max: max.toLocaleString(),
  });
};

/** Counted again as the person types, picks, adds or removes: a repeater's new item, a
 * list's new row. */
export const form_ref = Publr.ref<HTMLFormElement>((form) => {
  recount(form);
  const again = () => recount(form);
  form.addEventListener("input", again);
  form.addEventListener("change", again);
  const watcher = new MutationObserver(again);
  watcher.observe(form, { childList: true, subtree: true });
  return () => {
    form.removeEventListener("input", again);
    form.removeEventListener("change", again);
    watcher.disconnect();
  };
});
export const root_ref = Publr.ref<HTMLElement>((root) => {
  state.language = languageOfAddress();
  arrangeLayout(root);
  refreshConditions(root);
  // The visual editor switches the language from its own top bar; the form follows.
  const follow = (event: Event) => {
    state.language = String((event as CustomEvent).detail ?? "");
    refreshConditions(root);
  };
  window.addEventListener("publr:language", follow);
  return () => { clearTimeout(timer); disposed = true; window.removeEventListener("publr:language", follow); };
});

export const onLayoutTab = (event: MouseEvent) => {
  const button = event.currentTarget as HTMLElement;
  const root = button.closest<HTMLElement>('[data-part="record-editor"]');
  if (!root) return;
  for (const tab of root.querySelectorAll<HTMLElement>('[data-layout-tabs] [role="tab"]')) {
    const selected = tab === button;
    tab.setAttribute("aria-selected", String(selected));
    tab.tabIndex = selected ? 0 : -1;
    const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`);
    if (panel) panel.hidden = !selected;
  }
};
const arrangeLayout = (root: HTMLElement) => {
  const form = root.querySelector<HTMLFormElement>('[data-part="record-form"]');
  if (!form || form.dataset.layoutReady) return;
  form.dataset.layoutReady = "true";
  const fields = Array.from(form.children).filter((child) => child.hasAttribute("data-layout-kind")) as HTMLElement[];
  let panel: HTMLElement = form;
  let section: HTMLElement = form;
  let tabs: HTMLElement | null = null;
  for (const field of fields) {
    const kind = field.dataset.layoutKind;
    if (kind === "tab") {
      if (!tabs) {
        tabs = document.createElement("div"); tabs.className = "flex flex-wrap gap-1";
        tabs.setAttribute("role", "tablist"); tabs.addEventListener("keydown", tabKeys); tabs.dataset.layoutTabs = "true";
        field.before(tabs);
      }
      const button = field.querySelector<HTMLButtonElement>('[role="tab"]')!;
      const first = tabs.children.length === 0;
      button.setAttribute("aria-selected", String(first)); button.tabIndex = first ? 0 : -1;
      tabs.append(button);
      panel = document.createElement("div"); panel.className = "flex flex-col gap-7";
      panel.id = button.getAttribute("aria-controls")!;
      panel.setAttribute("role", "tabpanel"); panel.setAttribute("aria-labelledby", button.id);
      panel.hidden = !first;
      field.replaceWith(panel); section = panel;
    } else if (kind === "accordion") {
      const details = document.createElement("details"); details.open = true;
      const summary = document.createElement("summary"); summary.className = "cursor-pointer py-3";
      while (field.firstChild) summary.append(field.firstChild);
      details.append(summary);
      section = document.createElement("div"); section.className = "flex flex-col gap-7 py-4";
      details.append(section);
      if (panel === form) field.replaceWith(details);
      else { field.remove(); panel.append(details); }
    } else if (section !== form) section.append(field);
  }
};

const conditionValue = (form: HTMLFormElement, name: string): unknown => {
  const elements = Array.from(form.elements).filter((entry) =>
    (entry as HTMLInputElement).name === name || (entry as HTMLInputElement).name?.startsWith(`${name}[`),
  ) as HTMLInputElement[];
  const wrapper = Array.from(form.querySelectorAll<HTMLElement>("[data-field-path]"))
    .find((element) => element.dataset.fieldPath === name);
  const kind = wrapper?.dataset.valueKind;
  const many = elements.some((entry) => entry.name !== name);
  const values = elements.filter((entry) => entry.type !== "checkbox" && entry.type !== "radio" || entry.checked)
    .map((entry) => kind === "boolean" ? entry.value === "1" || entry.value === "true"
      : kind === "integer" || kind === "number" || entry.type === "number"
        ? (entry.value === "" ? null : Number(entry.value)) : entry.value);
  if (!many && elements.length === 1 && elements[0].type === "checkbox") return elements[0].checked;
  if (!many && kind === "boolean") return values[0] ?? false;
  return many ? values : values[0];
};
/** The language asked for in the address (`?lang=pl`), else the content language chosen
 * top right (`<html data-variant>`), when the site has it. */
const languageOfAddress = () => {
  const asked = new URLSearchParams(location.search).get("lang") ?? document.documentElement.dataset.variant ?? "";
  return state.languages.some((language) => language.code === asked) ? asked : "";
};

/** Switching the language the translated fields show: the address keeps it, so a reload,
 * a link or the editor drawn again stays in it. */
export const onLanguage = (event: MouseEvent) => {
  const label = (event.currentTarget as HTMLElement).textContent?.trim() ?? "";
  state.language = state.languages.find((language) => language.label === label)?.code ?? "";
  const address = new URL(location.href);
  if (state.language === "") address.searchParams.delete("lang");
  else address.searchParams.set("lang", state.language);
  history.replaceState(history.state, "", address);
  const root = root_of();
  if (root) refreshConditions(root);
};

/** A field path's language: `name@pl` is Polish; `name` is none. */
const languageOfPath = (path: string) => {
  const last = path.slice(path.lastIndexOf(".") + 1);
  const at = last.indexOf("@");
  return at < 0 ? null : last.slice(at + 1).replace(/\[.*$/, "");
};

/** Whether a field is out of the language shown: another language's value, or the main
 * value of a translated field while another language is shown. Fields shared by every
 * language stay, marked as shared. */
const outOfLanguage = (element: HTMLElement, translated: Set<string>) => {
  const path = element.dataset.fieldPath ?? "";
  const own = languageOfPath(path);
  const shared = own === null && !translated.has(path);
  const mark = element.querySelector<HTMLElement>(':scope > [data-part="shared-mark"]');
  if (mark) mark.hidden = !(shared && state.language !== "" && state.languages.length > 1);
  if (own !== null) return own !== state.language;
  return !shared && state.language !== "";
};

const translatedPaths = (root: HTMLElement) => {
  const paths = new Set<string>();
  for (const element of root.querySelectorAll<HTMLElement>("[data-field-path]")) {
    const path = element.dataset.fieldPath ?? "";
    if (languageOfPath(path) !== null) paths.add(path.slice(0, path.lastIndexOf("@")));
  }
  return paths;
};

const refreshConditions = (root: HTMLElement) => {
  const form = root.querySelector<HTMLFormElement>('[data-part="record-form"]');
  if (!form) return;
  const translated = translatedPaths(root);
  for (const element of root.querySelectorAll<HTMLElement>("[data-conditions]")) {
    const groups = JSON.parse(element.dataset.conditions ?? "[]") as Array<{
      rules: Array<{ field: string; operator: string; value: string }>
    }>;
    const path = element.dataset.fieldPath ?? "";
    const prefix = path.includes(".") ? path.slice(0, path.lastIndexOf(".") + 1) : "";
    element.hidden = outOfLanguage(element, translated) || element.dataset.groupActive === "false" || groups.length > 0 && !groups.some((group) => group.rules.every((rule) => {
      const value = conditionValue(form, prefix + rule.field);
      const empty = value == null || value === "" || Array.isArray(value) && value.length === 0;
      const expected = typeof value === "number" ? Number(rule.value) : rule.value;
      const equal = typeof value === "boolean" ? String(value) === rule.value : value === expected;
      if (rule.operator === "empty") return empty;
      if (rule.operator === "not_empty") return !empty;
      if (rule.operator === "not_equal") return !equal;
      if (rule.operator === "contains") return typeof value === "string" ? value.includes(rule.value) : Array.isArray(value) && value.some((item) => String(item) === rule.value);
      return equal;
    }));
  }
};

const root_of = () => root_ref.current;

let timer: number | undefined = undefined;
let inflight: Promise<boolean> | null = null;
let disposed = false;
let refresh_after_create = false;

const form_of = () => (form_ref.current as HTMLFormElement | null) ?? null;

const body_of = (form: HTMLFormElement, extra: Record<string, string>) => {
  const params = new URLSearchParams();
  for (const [key, value] of new FormData(form).entries()) {
    if (typeof value === "string") params.append(key, value);
  }
  for (const [key, value] of Object.entries(extra)) params.set(key, value);
  if (state.version !== "") params.set("expected_version", state.version);
  return params;
};

const focused = () => {
  const active = document.activeElement as HTMLInputElement | null;
  if (!active || !root_of()?.contains(active)) return null;
  return { name: active.getAttribute("name") ?? "", at: active.selectionStart ?? null };
};

/** Focus returns to the field it was in; when there was none and it fell to the body (the
 * editor drawn again inside a drawer level, whose Link button is gone), it lands on Back. */
const refocus = (memo: { name: string; at: number | null } | null, root: Element) => {
  const again =
    memo && memo.name !== "" ? root.querySelector<HTMLInputElement>(`[name="${memo.name}"]`) : null;
  if (!again) {
    if (state.in_drawer && document.activeElement === document.body) {
      root.querySelector<HTMLElement>('[data-part="drawer-back"]')?.focus();
    }
    return;
  }
  again.focus();
  if (memo && memo.at !== null && typeof again.setSelectionRange === "function") {
    try {
      again.setSelectionRange(memo.at, memo.at);
    } catch {
      // not every input type takes a caret
    }
  }
};

/** The answer to a fetched submit: the editor drawn again, put in this one's place. A
 * reshape changed the document without saving it, so the new editor is told it is dirty
 * and autosaves. */
const replace = (
  html: string,
  memo: { name: string; at: number | null } | null,
  then_save: boolean,
) => {
  const element = root_of();
  if (!element) return;
  const fragment = document.createRange().createContextualFragment(html);
  const next = fragment.firstElementChild;
  // Drawn again by the server, which draws what was opened (the form's `open` values).
  state.opened = {};
  state.listed = {};
  Publr.destroy(element);
  element.replaceWith(fragment);
  if (!next) return;
  Publr.hydrate(next);
  const form = next.querySelector<HTMLFormElement>('form[data-part="record-form"]');
  if (!form) return;
  queueMicrotask(() => {
    refocus(memo, next);
    if (then_save) form.dispatchEvent(new Event("input", { bubbles: true }));
  });
};

/** Inside the drawer every answer is asked for as a drawer fragment, so the editor drawn
 * again keeps its Back and Close. */
const headers_of = (answer: string) => {
  const headers: Record<string, string> = { "Publr-Fragment": answer };
  if (state.in_drawer) headers["Publr-Drawer"] = "1";
  return headers;
};

const post = async (url: string, params: URLSearchParams, answer: "editor" | "json") =>
  fetch(Publr.url(url), {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded", ...headers_of(answer) },
    body: params.toString(),
    credentials: "same-origin",
  });

/** "Show fields" or "Show all" past the fold: the button's value is the path it opens; the
 * value the form holds for it (saved or not) goes to the server, which answers its fields,
 * or a run's items, for JSX to draw. */
export const onOpen = async (event: Event) => {
  const path = (event.currentTarget as HTMLButtonElement).value;
  const form = form_of();
  if (!form || path === "" || state.opening !== "") return;
  state.opening = path;
  state.open_failed = "";
  try {
    const held = new FormData(form).get(path);
    const params = new URLSearchParams({
      csrf: state.csrf,
      type: state.type,
      path,
      value: typeof held === "string" ? held : "",
    });
    const response = await post(`${state.base_url}/cells`, params, "json");
    if (!response.ok || response.redirected) throw new Error(Publr.t("Could not open"));
    const answer = await response.json() as { cells?: Array<OpenedCell>; lines?: Array<ItemLine> };
    if (answer.lines) state.listed = { ...state.listed, [path]: answer.lines };
    else state.opened = { ...state.opened, [path]: answer.cells ?? [] };
  } catch {
    state.open_failed = path;
  } finally {
    state.opening = "";
  }
};

const save = mutation(async () => {
  const form = form_of();
  if (!form || disposed) return false;
  const revision = state.edit_revision;
  const creating = state.id === "";
  state.saved_text = Publr.t("Saving…");
  const response = await post(
    creating ? state.create_url : state.save_url,
    body_of(form, {}),
    "json",
  );
  if (!response.ok || response.redirected) throw new Error(Publr.t("Could not save"));
  const answer = await response.json() as {
    saved: boolean; id?: string; version?: number; title?: string; reason?: string;
    status?: string; status_label?: string; changed?: boolean; parks?: boolean;
    has_destructive?: boolean; actions?: RecordAction[];
    problems?: Array<{ field: string; message: string }>;
  };
  state.problems = problems_by_field(answer.problems ?? []);
  if (!answer.saved) throw new Error(answer.reason ?? Publr.t("Cannot save yet"));
  if (disposed) return false;
  state.version = String(answer.version ?? "");
  if (answer.actions) {
    state.status = answer.status ?? state.status;
    state.status_label = answer.status_label ?? state.status_label;
    state.changed = answer.changed ?? state.changed;
    state.parks = answer.parks ?? state.parks;
    state.has_destructive = answer.has_destructive ?? state.has_destructive;
    state.actions = answer.actions;
    state.has_primary = answer.actions.some((item) => item.primary);
  }
  state.dirty = state.edit_revision !== revision;
  state.saved_text = state.dirty ? Publr.t("Unsaved changes") : Publr.t("All changes saved");
  // What the record may do now (Publish changes once a live record has some): a host drawing
  // the actions itself, the visual editor's Document tab, reads them from here.
  form.dispatchEvent(new CustomEvent("publr:record-saved", { bubbles: true, detail: { actions: state.actions } }));
  invalidate("content");
  invalidate(`record:${answer.id ?? state.id}`);
  if (creating && answer.id) {
    state.id = answer.id;
    state.save_url = `${state.base_url}/${answer.id}/save`;
    state.submit_url = state.save_url;
    state.record_url = `${state.base_url}/${answer.id}`;
    refresh_after_create = true;
    if (!state.in_drawer) history.replaceState(null, "", Publr.url(state.record_url));
    Publr.stores.navigation.created(root_ref.current, answer.id, answer.title ?? "");
  }
  return true;
});

const drain = async () => {
  while (!disposed) {
    if (state.dirty) {
      if (!await save()) return false;
      continue;
    }
    if (!refresh_after_create) return true;
    const revision = state.edit_revision;
    const memo = focused();
    const fresh = await fetch(Publr.url(`${state.record_url}/editor`), {
      credentials: "same-origin", headers: headers_of("editor"),
    });
    if (!fresh.ok || fresh.redirected) throw new Error(Publr.t("Could not refresh the editor"));
    const html = await fresh.text();
    if (disposed) return false;
    if (state.edit_revision !== revision) continue;
    refresh_after_create = false;
    replace(html, memo, false);
    return true;
  }
  return false;
};

const flush = () => {
  clearTimeout(timer);
  if (!inflight) {
    state.refresh_error = false;
    inflight = drain().catch((error: unknown) => {
      if (!disposed) {
        state.refresh_error = true;
        state.saved_text = error instanceof Error ? error.message : Publr.t("Could not save");
      }
      return false;
    }).finally(() => { inflight = null; });
  }
  return inflight;
};

export const retrySave = () => { void flush(); };

/** Preview draws the form as it stands, saved or not, in a new tab, and nothing is saved. The
 * form goes in session storage, which the tab opened here starts with a copy of; the tab
 * posts it into its frame, so reloading it never asks to send the form again. A new
 * record's form names its type. */
export const onPreview = (event: MouseEvent) => {
  const link = event.currentTarget as HTMLAnchorElement;
  const form = form_of();
  if (!form) return;
  event.preventDefault();
  const pairs = [...new FormData(form)].filter(([, value]) => typeof value === "string");
  try {
    sessionStorage.setItem("publr-preview", JSON.stringify(pairs));
  } catch {
    // Without storage the tab draws what is saved.
  }
  window.open(link.href, "_blank");
};

/** An edit anywhere in the record's form: the form itself, or a control in the aside
 * that posts with it (`form="record"`). The autosave follows after a pause. */
export const markDirty = () => {
  state.edit_revision++;
  state.dirty = true;
  state.saved_text = Publr.t("Unsaved changes");
  clearTimeout(timer);
  timer = window.setTimeout(() => { void flush(); }, 800);
};

/** The combobox of a flat taxonomy (RecordTerms) writes hidden inputs without an input
 * event; its own change event bubbles here instead. */
export const onPicked = () => {
  markDirty();
};

export const onInput = (event: Event) => {
  if (root_of()) refreshConditions(root_of()!);
  const target = event.target as HTMLInputElement | null;
  const form = form_ref.current as HTMLFormElement | null;
  if (!target || !form || target.name === "type-search") return;
  if (!form.contains(target) && target.form !== form) return;
  markDirty();
};

/** A named submit (reshape, status action) posted with fetch; the editor comes back. */
export const onSubmit = async (event: Event) => {
  const form = event.target as HTMLFormElement | null;
  if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return;
  event.preventDefault();
  if (state.submitting) return;
  // Destroying is for good: the menu only arms it; the confirm under the actions does it.
  const destroys = form.querySelector('input[name="transition"][value="destroy"]') !== null;
  if (destroys && form.dataset.confirmed !== "true") {
    state.destroy_armed = true;
    return;
  }
  state.destroy_armed = false;
  const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
  const memo = focused();
  if (!await flush() || disposed) return;
  const extra: Record<string, string> = {};
  if (submitter && submitter.name) extra[submitter.name] = submitter.value;
  const reshaping = submitter !== null && submitter.name === "reshape";
  await submit(
    form.getAttribute("action") ?? state.save_url,
    body_of(form, extra),
    memo,
    reshaping,
  );
};

export const cancel_destroy = () => {
  state.destroy_armed = false;
};

const submit = mutation(async (
  url: string,
  params: URLSearchParams,
  memo: { name: string; at: number | null } | null,
  then_save: boolean,
) => {
  const response = await post(url, params, "editor");
  if (!response.ok || response.redirected) throw new Error(Publr.t("Could not complete the action. Try again."));
  const html = await response.text();
  if (disposed) return;
  const location = response.headers.get("Publr-Location");
  if (html.trim() === "") {
    if (location) window.location.assign(location);
    return;
  }
  if (location && !state.in_drawer) history.replaceState(null, "", location);
  replace(html, memo, then_save);
});

Publr.effect(() => {
  state.submitting = submit.isPending;
  state.busy = save.isPending || submit.isPending;
  state.save_error = save.isError || state.refresh_error;
  const error = submit.isError ? submit.error : save.isError ? save.error : null;
  if (error) state.saved_text = error instanceof Error ? error.message : Publr.t("Could not save");
});

export const onOpenReference = (event: Event) => {
  if (event.defaultPrevented) return;
  if (
    event instanceof MouseEvent &&
    (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
  )
    return;
  const anchor = event.currentTarget as HTMLAnchorElement;
  event.preventDefault();
  Publr.stores.navigation.openReference({
    url: `${anchor.href}/editor`,
    field: "",
    opener: anchor,
    deliver: () => {},
  });
};

export const onReference = (event: Event) => {
  const button = event.currentTarget as HTMLElement;
  const { field = "", type = "", verb = "", live = "", reshape = "", query = "" } = button.dataset;
  const url =
    verb === "link"
      ? `/admin/content/pick?type=${encodeURIComponent(type)}&field=${encodeURIComponent(field)}${live === ":live" ? "&live=1" : ""}${query}`
      : `/admin/content/new/editor?type=${encodeURIComponent(type)}&in_drawer=1${query}`;
  Publr.stores.navigation.openReference({
    url,
    field,
    opener: button,
    deliver: (id: string) => onLinked(id, field, reshape),
  });
};

/** A reshape asked for by name, as a submit button with `name="reshape"` would send it. */
const reshape_by = async (code: string) => {
  const form = form_of();
  if (!form || state.submitting) return;
  const memo = focused();
  if (!await flush() || disposed) return;
  await submit(form.action, body_of(form, { reshape: code }), memo, true);
};
const item_of = (event: Event) => (event.currentTarget as HTMLButtonElement).value;
/** An ItemList's rail: each button carries the item's field name (`chapters[1]`). */
export const onItemUp = (event: Event) => reshape_by(`up:${item_of(event)}`);
export const onItemDown = (event: Event) => reshape_by(`down:${item_of(event)}`);
export const onItemRemove = (event: Event) => reshape_by(`remove:${item_of(event)}`);

const onLinked = async (id: string, field: string, reshape: string) => {
  const form = form_of();
  if (!form || !field) return;
  const memo = focused();
  if (!await flush() || disposed) return;
  await submit(
    form.action,
    body_of(form, {
      [`pick:${field}`]: id,
      reshape: reshape || `set:${field}`,
    }),
    memo,
    true,
  );
};

Publr.effect(() => {
  const title = state.title;
  Publr.stores.navigation.rename(root_ref.current, title);
});

export type RecordEditorProps = {
  group_position?: string;
  csrf: string;
  /** The record's page, its own fragment, and where the form posts. */
  id: string;
  record_url: string;
  save_url: string;
  create_url: string;
  /** `/admin/content` or `/admin/terms`: where a record made by the autosave lives. */
  base_url: string;
  is_new: boolean;
  /** Drawn inside the drawer: Back and Close beside the title, no address to update. */
  in_drawer: boolean;
  /** Where the status actions post; empty for a new record. */
  action_route: string;
  type: string;
  type_name: string;
  /** The type's schema page; empty when the person may not change types. */
  type_href: string;
  title: string;
  expected_version: string;
  status: string;
  status_label: string;
  changed: boolean;
  versions_href: string;
  /** The record's page drawn from its edit copy, for a type an app has a page for; empty
   * otherwise. */
  preview_href: string;
  /** What was refused, by path, when the last post did not go through. */
  problems: Array<{ code: string; text: string }>;
  /** The status actions, each its own form to the record's action route; the primary one
   * is the split button's face, the rest its menu. */
  actions: Array<{
    name: string;
    value: string;
    label: string;
    destructive: boolean;
    primary: boolean;
  }>;
  has_destructive: boolean;
  /** The field rows (RecordFields), drawn by the adapter. */
  fields: JSX.Element;
  /** Saving parks the edit as pending changes while the record is live. */
  parks: boolean;
  /** Drawn as a preview of the type on its fields page: the form alone, no title band,
   * no status strip, no aside; the host makes it inert. */
  preview: boolean;
  /** Centred in the sheet, as a record is edited; a settings section sits at the gutter. */
  focus?: boolean;
  /** Sections of the aside the adapter draws: the record's terms, a term's parent. */
  aside?: JSX.Element;
  /** The dependency dialog for the aside, rendered by the adapter under `serve --dev`. */
  impact?: JSX.Element;
  /** The site's languages, the main one first with an empty code: the switch between the
   * values of translated fields. Fewer than two: no switch. */
  languages?: Array<{ code: string; label: string }>;
  /** One column: the record's editor in a visual record's Entry panel. */
  stacked?: boolean;
  /** The values the entry holds, and the most it may; 0 for no count shown. */
  values_count?: number;
  values_max?: number;
  /** A transition someone who may not publish asked for: who (empty when none waits),
   * its label and name; whether the person may approve it (run it), and the label of
   * dropping it (Decline, Withdraw for the asker; empty when they may not). */
  request_by?: string;
  request_label?: string;
  request_transition?: string;
  request_may_approve?: boolean;
  request_decline_label?: string;
};

export function RecordEditor({
  group_position = "main",
  csrf,
  id,
  record_url,
  save_url,
  create_url,
  base_url,
  is_new,
  in_drawer,
  action_route,
  type,
  type_name,
  type_href,
  title,
  expected_version,
  status,
  status_label,
  changed,
  versions_href,
  preview_href,
  problems,
  actions,
  has_destructive,
  fields,
  parks,
  preview,
  stacked = false,
  focus = true,
  aside,
  impact,
  languages = [],
  values_count = 0,
  values_max = 0,
  request_by = "",
  request_label = "",
  request_transition = "",
  request_may_approve = false,
  request_decline_label = "",
}: RecordEditorProps) {
  state.id = id;
  state.values_max = values_max;
  showValues(values_count);
  state.title = title;
  state.version = expected_version;
  state.save_url = save_url;
  state.submit_url = is_new ? create_url : save_url;
  state.create_url = create_url;
  state.record_url = record_url;
  state.base_url = base_url;
  state.csrf = csrf;
  state.type = type;
  state.in_drawer = in_drawer;
  state.status = status;
  state.status_label = status_label;
  state.changed = changed;
  state.parks = parks;
  state.has_destructive = has_destructive;
  state.actions = actions;
  state.has_primary = actions.some((item) => item.primary);
  state.languages = languages;
  state.problems = problems_by_field(problems.map((problem) => ({ field: problem.code, message: problem.text })));

  return (
    <div
      class="flex grow items-stretch"
      onInput={onInput}
      onSubmit={onSubmit}
      onMultiSelectChange={onPicked}
      ref={root_ref}
      data-title={title}
      data-part="record-editor"
      aria-busy={state.busy}
    >
      <FormBody
        stacked={stacked}
        title={title}
        description={type_name}
        bare={preview}
        focus={focus}
        in_drawer={in_drawer}
        header={<RecordHeader in_drawer={in_drawer} title={title} type_name={type_name} type_href={type_href} />}
        meta={
          <div class="contents">
            <StatusStrip
              status={is_new ? Publr.t("New") : state.status_label}
              tone={is_new ? "neutral" : state.status === "published" ? "success" : "neutral"}
              note={state.saved_text}
            >
              {state.changed && <Status tone="warning">{Publr.t("unpublished changes")}</Status>}
            </StatusStrip>
            <Button hierarchy="tertiary" size="sm" hidden={!state.save_error} onClick={retrySave}>{Publr.t("Retry save")}</Button>
            {state.languages.length > 1 && (
              <div class="ml-auto flex items-center gap-3" role="group" aria-label={Publr.t("Language")} data-part="language-switch">
                {state.languages.map((language) => (
                  <TextToggle label={language.label} pressed={state.language === language.code} onClick={onLanguage} />
                ))}
              </div>
            )}
          </div>
        }
        notice={
          request_by !== "" ? (
            <div class="flex flex-col gap-3" data-part="request">
              <Callout
                tone="info"
                title={Publr.t("{who} asked for “{transition}”", { who: request_by, transition: request_label })}
              >
                {request_may_approve
                  ? Publr.t("Approve it to make it now, or decline it.")
                  : Publr.t("It waits for someone who may publish.")}
              </Callout>
              <div class="flex flex-wrap items-center gap-2">
                {request_may_approve && (
                  <form method="post" action={action_route}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="expected_version" value={state.version} />
                    <input type="hidden" name="transition" value={request_transition} />
                    <Button type="submit" size="sm" hierarchy="primary">{Publr.t("Approve")}</Button>
                  </form>
                )}
                {request_decline_label !== "" && (
                  <form method="post" action={action_route}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="expected_version" value={state.version} />
                    <input type="hidden" name="do" value="decline" />
                    <Button type="submit" size="sm" hierarchy="secondary">{request_decline_label}</Button>
                  </form>
                )}
              </div>
            </div>
          ) : undefined
        }
        problems={problems}
        problems_title={Publr.t("The record was not saved.")}
        side={
          <RecordActions
            in_drawer={in_drawer}
            is_new={is_new}
            action_route={action_route}
            csrf={csrf}
            expected_version={expected_version}
            id={id}
            versions_href={versions_href}
            preview_href={preview_href}
            aside={aside}
            impact={impact}
            stacked={stacked}
          />
        }
      >
        <form
          id="record"
          method="post"
          action={state.submit_url}
          class="flex flex-col gap-7"
          data-group-position={group_position}
          data-part="record-form"
          data-type={type}
          ref={form_ref}
          inert={state.submitting}
        >
          <input type="hidden" name="csrf" value={csrf} />
          {is_new && <input type="hidden" name="type" value={type} />}
          {!is_new && <input type="hidden" name="expected_version" value={state.version} />}
          {state.values_near && (
            <div data-part="values-limit">
              {state.values_over ? (
                <Callout tone="error" title={state.values_text}>
                  {Publr.t("This entry holds more values than an entry may, so it cannot be saved. Remove some, or move a part into an entry of its own.")}
                </Callout>
              ) : (
                <Callout tone="warning" title={state.values_text}>
                  {Publr.t("An entry holds at most {max} values. Past that, it cannot be saved.", {
                    max: state.values_max.toLocaleString(),
                  })}
                </Callout>
              )}
            </div>
          )}
          {fields}
        </form>
      </FormBody>
    </div>
  );
}
