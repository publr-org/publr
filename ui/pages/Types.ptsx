import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type TypesProps = {
  /** "Content types" or "Taxonomies": the page, its header and its empty state. */
  title: string;
  new_href: string;
  new_label: string;
  empty_title: string;
  empty_description: string;
  /** Content types have a kind; taxonomies do not. */
  show_kind: boolean;
  /** What the last column's button says: "Manage" (records) or "Terms". */
  manage_label: string;
  types: Array<{
    href: string;
    name: string;
    handle: string;
    kind: string;
    visibility: string;
    owner: string;
    fields: number;
    content_href: string;
  }>;
  /** How many there are in all. */
  total: number;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  previous_href: string;
  next_href: string;
};

export function Types({
  title,
  new_href,
  new_label,
  empty_title,
  empty_description,
  show_kind,
  manage_label,
  types,
  total,
  range,
  previous_href,
  next_href,
}: TypesProps) {
  return (
    <IndexPage
      title={title}
      parents={[{ label: Publr.t("Structure"), href: "/admin/structure" }]}
      description={Publr.tn("{count} defined", "{count} defined", total)}
      footer={range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
      actions={
        <Button href={new_href}>
          <Icon name="plus" size="sm" />
          <span>{new_label}</span>
        </Button>
      }
      empty={
        types.length === 0 && (
          <Empty>
            <EmptyTitle>{empty_title}</EmptyTitle>
            <EmptyDescription>{empty_description}</EmptyDescription>
          </Empty>
        )
      }
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Name")}</TableHead>
            <TableHead>{Publr.t("Handle")}</TableHead>
            {show_kind && <TableHead>{Publr.t("Kind")}</TableHead>}
            <TableHead>{Publr.t("Visibility")}</TableHead>
            <TableHead>{Publr.t("Owner")}</TableHead>
            <TableHead align="right">{Publr.t("Fields")}</TableHead>
            <TableHead align="right">{manage_label}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {types.map((entry) => (
            <TableRow>
              <TableCell>
                <Link href={entry.href} variant="body-sm" tone="default">
                  {entry.name}
                </Link>
              </TableCell>
              <TableCell>
                <Text as="span" variant="mono-xs" tone="muted">
                  {entry.handle}
                </Text>
              </TableCell>
              {show_kind && (
                <TableCell>
                  <Text as="span" variant="body-sm" tone="muted">
                    {entry.kind}
                  </Text>
                </TableCell>
              )}
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {entry.visibility}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {entry.owner}
                </Text>
              </TableCell>
              <TableCell numeric align="right">
                <Text as="span" variant="body-sm">
                  {entry.fields}
                </Text>
              </TableCell>
              <TableCell align="right">
                {entry.content_href !== "" && (
                  <Button href={entry.content_href} hierarchy="secondary" size="sm">
                    <span>{manage_label}</span>
                    <Icon name="chevron-right" size="xs" />
                  </Button>
                )}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
