import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";
import { CurrencyTable } from "../components/CurrencyTable.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { DropdownMenu } from "@publr/ui/Dropdown.ptsx";
import { DropdownMenuContent } from "@publr/ui/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "@publr/ui/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "@publr/ui/DropdownMenuTrigger.ptsx";

export type SettingsSystemProps = {
  /** The section shown: `general`, or `currencies`. */
  tab: string;
  /** Whether the viewer may read the activity and error logs: the menu beside the tabs. */
  can_logs?: boolean;
  /** Where the currencies form posts. */
  action: string;
  /** The site's currencies, the default first. */
  currencies: Array<{
    index: number;
    code: string;
    symbol: string;
    format: string;
    decimal: string;
    thousands: string;
    example: string;
  }>;
  /** Every ISO 4217 code and its decimals. */
  digits: Array<{ code: string; digits: number }>;
  /** Shown after a save. */
  notice?: string;
  /** Why a save was refused. */
  problem?: string;
};

/** The system's own settings, a section per tab: general, and the currencies the site
 * prices in and how it writes them. */
export function SettingsSystem({
  tab,
  can_logs = false,
  action,
  currencies,
  digits,
  notice = "",
  problem = "",
}: SettingsSystemProps) {
  return (
    <IndexPage
      title="System settings"
      description="How this Publr runs, and the conventions the site follows."
      tabs={
        <TabNav label="System settings">
          <TabNavLink href="/admin/settings/system" active={tab === "general"}>
            General
          </TabNavLink>
          <TabNavLink href="/admin/settings/system/currencies" active={tab === "currencies"}>
            Currencies
          </TabNavLink>
        </TabNav>
      }
      tab_menu={
        can_logs && (
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <Button type="button" hierarchy="tertiary" size="sm" label="More" title="More">
                <Icon name="more" size="sm" />
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="right">
              <DropdownMenuItem href="/admin/settings/system/activity">Activity log</DropdownMenuItem>
              <DropdownMenuItem href="/admin/settings/system/errors">Error log</DropdownMenuItem>
            </DropdownMenuContent>
          </DropdownMenu>
        )
      }
      notice={
        tab === "currencies" && (
          <div class="contents">
            <Text as="p" variant="body-md" tone="muted">
              What money fields hold amounts in, and how pages write them. The default is the one
              pages show. A format uses {"{symbol}"}, {"{amount}"} and {"{code}"}.
            </Text>
            {problem !== "" && (
              <Callout tone="error" title="Not saved">
                {problem}
              </Callout>
            )}
            {notice !== "" && <Callout title={notice} />}
          </div>
        )
      }
      empty={
        tab === "general" && (
          <Empty>
            <EmptyTitle>Nothing to configure yet</EmptyTitle>
            <EmptyDescription>The site's own settings live in the sections below Users.</EmptyDescription>
          </Empty>
        )
      }
      footer={
        tab === "currencies" && (
          <Button type="submit" form="currencies">
            Save currencies
          </Button>
        )
      }
    >
      <form id="currencies" method="post" action={action}>
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        <CurrencyTable rows={currencies} digits={digits} />
      </form>
    </IndexPage>
  );
}
