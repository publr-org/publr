import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Pager } from "../components/Pager.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TabNav } from "@publr/ui/TabNav.ptsx";
import { TabNavLink } from "@publr/ui/TabNavLink.ptsx";

export type UsersProps = {
  users: Array<{
    href: string;
    name: string;
    email: string;
    /** The labels of the account's roles, comma-separated. */
    roles: string;
    /** Signed in at least once; an invited account is inactive until its link is used. */
    active: boolean;
    /** The signed-in user's own row. */
    me: boolean;
    /** The account's value in each plugin column, in `columns`' order; empty shows "—". */
    cells?: Array<{ text: string }>;
  }>;
  /** Columns plugins add (`.register_columns`): `kind` is number, money, date, text, status
   * or link; a column of a stored field sorts the list through `sort_href`. */
  columns?: Array<{ label: string; kind: string; sort_href: string; sorted: string }>;
  /** "51–100 of 230" when there is more than one page; empty otherwise. */
  range: string;
  /** The pages before and after this one; empty at either end. */
  previous_href: string;
  next_href: string;
  /** Plugins' pages that are tabs here, after Users' own; none draws no tabs. Each draws
   * its own page with these tabs over it. */
  plugin_tabs?: Array<{ label: string; href: string }>;
};

/** The accounts, oldest first, a page at a time, and a way to add one. There is always one:
 * whoever looks. */
export function Users({
  users,
  columns = [],
  range,
  previous_href,
  next_href,
  plugin_tabs = [],
}: UsersProps) {
  return (
    <IndexPage
      title={Publr.t("Users")}
      description={Publr.t("Who may sign in, and what they may do.")}
      actions={<Button href="/admin/settings/users/new">{Publr.t("Add user")}</Button>}
      tabs={
        plugin_tabs.length > 0 && (
          <TabNav label={Publr.t("Users")}>
            <TabNavLink href="/admin/settings/users" active={true}>
              {Publr.t("Users")}
            </TabNavLink>
            {plugin_tabs.map((item) => (
              <TabNavLink href={item.href} active={false}>
                {item.label}
              </TabNavLink>
            ))}
          </TabNav>
        )
      }
      footer={range !== "" && <Pager range={range} previous_href={previous_href} next_href={next_href} />}
    >
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{Publr.t("Name")}</TableHead>
            <TableHead>{Publr.t("Email")}</TableHead>
            <TableHead>{Publr.t("Roles")}</TableHead>
            <TableHead>{Publr.t("Status")}</TableHead>
            {columns.map((column) => (
              <TableHead align={column.kind === "number" || column.kind === "money" ? "right" : "left"}>
                {column.sort_href === "" ? column.label : (
                  <Link href={column.sort_href} variant="body-sm" tone="default">
                    {column.label}{column.sorted === "ascending" ? " ↑" : column.sorted === "descending" ? " ↓" : ""}
                  </Link>
                )}
              </TableHead>
            ))}
          </TableRow>
        </TableHeader>
        <TableBody>
          {users.map((user) => (
            <TableRow>
              <TableCell>
                <Link href={user.href} variant="body-sm" tone="default">
                  {user.name}
                </Link>
                {user.me && (
                  <Text as="span" variant="body-sm" tone="muted">
                    {" "}
                    {Publr.t("(you)")}
                  </Text>
                )}
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.email}
                </Text>
              </TableCell>
              <TableCell>
                <Text as="span" variant="body-sm" tone="muted">
                  {user.roles}
                </Text>
              </TableCell>
              <TableCell>
                {user.active ? (
                  <Status tone="success">{Publr.t("Active")}</Status>
                ) : (
                  <Status tone="warning">{Publr.t("Invited")}</Status>
                )}
              </TableCell>
              {(user.cells ?? []).map((cell, index) => (
                <TableCell align={columns[index].kind === "number" || columns[index].kind === "money" ? "right" : "left"}
                  numeric={columns[index].kind === "number" || columns[index].kind === "money" || columns[index].kind === "date"}>
                  {cell.text === "" ? (
                    <Text as="span" variant="body-sm" tone="muted">—</Text>
                  ) : columns[index].kind === "status" ? (
                    <Status tone="neutral">{cell.text}</Status>
                  ) : columns[index].kind === "link" ? (
                    <Link href={cell.text} variant="body-sm" tone="default">{cell.text}</Link>
                  ) : (
                    <Text as="span" variant="body-sm" tone="muted">{cell.text}</Text>
                  )}
                </TableCell>
              ))}
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </IndexPage>
  );
}
