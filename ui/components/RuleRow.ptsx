import { Button } from "@publr/ui/Button.ptsx";
import { NativeSelect } from "@publr/ui/NativeSelect.ptsx";
import { Input } from "@publr/ui/Input.ptsx";
import { Text } from "@publr/ui/Text.ptsx";
export type RuleRowProps = {
  first: boolean; last: boolean;
  prefix: string; group_index: number; index: number;
  field: string; operator: string; value: string; location: boolean;
  subjects: Array<{ value: string; label: string; choices: string }>;
};
export function RuleRow({ first, last, prefix, group_index, index, field, operator, value, location, subjects }: RuleRowProps) {
  return (
    <div class="flex flex-col gap-3" data-rule={index} data-rule-group={group_index}>
      <div data-first hidden={!first}>
        <div data-show hidden={group_index !== 0}><Text variant="body-sm" as="strong">Show when</Text></div>
        <div data-or hidden={group_index === 0}><Text variant="body-sm" as="strong">Or</Text></div>
      </div>
      <div class="flex items-center gap-2">
              <div data-and hidden={index === 0}><Text variant="body-sm" tone="muted">And</Text></div>
              <NativeSelect label="Field" name={`${prefix}.${group_index}.${index}.field`}
               >
                {subjects.map((subject) => (
                  <option value={subject.value} data-choices={subject.choices} selected={field === subject.value}>{subject.label}</option>
                ))}
              </NativeSelect>
              <NativeSelect label="Operator" name={`${prefix}.${group_index}.${index}.operator`}
               >
                <option value="equal" selected={operator === "equal"}>is</option>
                <option value="not_equal" selected={operator === "not_equal"}>is not</option>
                {!location && <option value="empty" selected={operator === "empty"}>is empty</option>}
                {!location && <option value="not_empty" selected={operator === "not_empty"}>is not empty</option>}
                {!location && <option value="contains" selected={operator === "contains"}>contains</option>}
              </NativeSelect>
              
                <Input name={`${prefix}.${group_index}.${index}.value`}
                  value={value} placeholder="Value" />
              <Button type="button" hierarchy="tertiary" name="rules-remove">Remove</Button>
      </div>
      <div data-last hidden={!last}><Button type="button" hierarchy="secondary" name="rules-add"
        disabled={index >= 7}>And</Button></div>
    </div>
  );
}
