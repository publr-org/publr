---
import Base from '../../layouts/base.publr';
import LatestGreetings from '../../components/latest-greetings.publr';
const greeting = Publr.build.getEntry();
---
<Base title={greeting.title}>
  <article class="mx-auto max-w-prose px-6 pt-16 pb-8">
    <p class="mb-6 text-sm"><a href="/greetings" class="text-muted hover:text-accent">← All greetings</a></p>
    <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-accent">A greeting</p>
    <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">{greeting.title}</h1>
    <time class="mt-4 block text-sm text-muted">Recorded {greeting.created_at}</time>
    <p class="mt-10 text-lg leading-relaxed text-muted">This page was built to a file for <code>{greeting.slug ?? ""}</code>. Record another greeting and only the pages that list them are rebuilt; this one is left alone.</p>
  </article>
  <aside class="mx-auto max-w-prose px-6 pb-16">
    <LatestGreetings heading="More greetings" island />
  </aside>
</Base>
