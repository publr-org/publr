import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Empty } from "@publr/ui/Empty.ptsx";
import { EmptyDescription } from "@publr/ui/EmptyDescription.ptsx";
import { EmptyTitle } from "@publr/ui/EmptyTitle.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";

export type ContentProps = {
  /** The view's name, for the window and the crumbs. */
  title: string;
  /** Whether any record type exists; without one there is nothing to list. */
  has_types: boolean;
  /** The list itself (ContentList), rendered once by the adapter: the page wraps it, and
   * the list's script fetches it bare to draw it again in place, its header included. */
  list?: JSX.Element;
};

/** The content: one view of the records, filtered and saved, or the way to the first
 * content type when there is none. */
export function Content({ title, has_types, list }: ContentProps) {
  return (
    <IndexPage
      title={title}
      own_header={has_types}
      actions={
        !has_types && (
          <Button href="/admin/types/new">
            <Icon name="plus" size="sm" />
            <span>New content type</span>
          </Button>
        )
      }
      empty={
        !has_types && (
          <Empty>
            <EmptyTitle>No content types yet</EmptyTitle>
            <EmptyDescription>Content is made of records of a type. Define a type first.</EmptyDescription>
          </Empty>
        )
      }
    >
      {list}
    </IndexPage>
  );
}
