import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { IndexSection } from "../components/IndexSection.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";

export type PluginReviewProps = {
  title: string;
  summary: string;
  /** Where Allow posts, and what it says: Allow & Enable, or Allow & Update. */
  action: string;
  allow_label: string;
  /** Where Cancel goes, leaving everything as it is. */
  cancel_href: string;
  /** On an update: a post that drops the newer version; empty otherwise. */
  discard_action: string;
  /** The heading over `requests`: what installing asks, or an update's new permissions. */
  requests_title: string;
  /** What the plugin asks for that it does not hold, low to high. */
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    on: boolean;
    editable: boolean;
    flags: Array<{ name: string; label: string; on: boolean }>;
    takes_domains: boolean;
    domains: string;
    anywhere: boolean;
    secrets: Array<{ name: string; label: string; help: string; set: boolean; status: string }>;
  }>;
  /** On an update, what it holds already. */
  granted: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    on: boolean;
    editable: boolean;
    flags: Array<{ name: string; label: string; on: boolean }>;
    takes_domains: boolean;
    domains: string;
    anywhere: boolean;
    secrets: Array<{ name: string; label: string; help: string; set: boolean; status: string }>;
  }>;
  /** What allowing grants, in a sentence. */
  note_text: string;
  /** What stops it, each in plain words: plugins it needs that do not fit (enabling), or
   * enabled plugins that need the version running now (updating). Allow is hidden. */
  stops_title: string;
  stops: Array<{ code: string; text: string }>;
  /** On an update, the remotes of other plugins it would switch off. */
  switches_off: Array<{ code: string; text: string }>;
};

/** What enabling or updating a plugin grants, before it is done: every request with the
 * plugin's reason and risk, low to high, and (enabling) a switch for each key and each flag
 * it asked for, set as asked; allowed from the title band with what is left on. */
export function PluginReview({
  title,
  summary,
  action,
  allow_label,
  cancel_href,
  discard_action,
  requests_title,
  requests,
  granted,
  note_text,
  stops_title,
  stops,
  switches_off,
}: PluginReviewProps) {
  return (
    <IndexPage
      title={title}
      parents={[{ label: Publr.t("Plugins"), href: "/admin/settings/plugins" }]}
      description={summary}
      actions={
        <div class="contents">
          {discard_action !== "" && (
            <ConfirmAction
              inline
              label={Publr.t("Discard this version")}
              title={Publr.t("Discard this version?")}
              description={Publr.t("The uploaded version goes; the one running stays as it is.")}
              action={discard_action}
            />
          )}
          {cancel_href !== "" && (
            <Button href={cancel_href} hierarchy="secondary">{Publr.t("Cancel")}</Button>
          )}
          {stops.length === 0 && <Button type="submit" form="plugin-review">{allow_label}</Button>}
        </div>
      }
      notice={
        <>
          {stops.length > 0 && <Callout tone="warning" title={stops_title} items={stops} />}
          {switches_off.length > 0 && (
            <Callout tone="warning" title={Publr.t("This switches off parts of other plugins")} items={switches_off}>
              {Publr.t("Their calls to these answer as unavailable and their hooks don't run. The rest of each plugin works.")}
            </Callout>
          )}
          <Callout title={Publr.t("Nothing changes until you allow it")}>{note_text}</Callout>
        </>
      }
    >
      <form id="plugin-review" method="post" action={action} class="contents">
        <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
        <IndexSection
          title={requests_title}
          empty={requests.length === 0 ? Publr.t("Nothing beyond its own operations and content types.") : undefined}
        >
          <PluginRequests requests={requests} />
        </IndexSection>
      </form>
      {granted.length > 0 && (
        <IndexSection title={Publr.t("It already may")}>
          <PluginRequests requests={granted} />
        </IndexSection>
      )}
    </IndexPage>
  );
}
