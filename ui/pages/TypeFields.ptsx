import { IndexPage } from "../layouts/IndexPage.ptsx";
import { TypeColumns } from "../components/TypeColumns.ptsx";

export type TypeFieldsProps = {
  title: string;
  /** Structure and the list the type belongs to. */
  parents: Array<{ label: string; href: string }>;
  type_href: string;
  /** The fields (FieldList), the levels over them a deep link starts with (TypeLevel), and
   * the preview (RecordEditor), rendered by the adapter. */
  list: JSX.Element;
  levels?: JSX.Element;
  open: boolean;
  preview: JSX.Element;
};

/** A content type's page, under Settings like the rest of the structure: its fields, with
 * the picker and the field forms opening as levels over them on this same page, and the
 * form as a record of the type shows it, side by side with the fields in the preview. The
 * head of the type is on its settings page; Add field's arrow leads there and to the
 * records. The list draws its own title band because it redraws in place. */
export function TypeFields({ title, parents, type_href, list, levels, open, preview }: TypeFieldsProps) {
  return (
    <IndexPage title={title} parents={parents} own_header>
      <TypeColumns type_href={type_href} list={list} levels={levels} open={open} preview={preview} />
    </IndexPage>
  );
}
