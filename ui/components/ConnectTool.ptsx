import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { McpSetup } from "./McpSetup.ptsx";

export type ConnectToolProps = {
  /** The page it is on: each tool links here with `?tool=`, picking it again closes it. */
  base: string;
  /** The tool picked (`claude_code`, `codex`, `cursor`, `windsurf`, `other`); empty when none. */
  tool: string;
  /** This site's MCP address, `<admin address>/mcp`, which every tool adds. */
  address: string;
  /** What a tool calls this site, `publr-<site>`. */
  name: string;
  /** The admin's address, which an agent links a project folder to. */
  site: string;
  /** Cursor's link that adds this site's MCP server. */
  cursor_link: string;
  /** The address can be reached from the internet, so chat apps can add it. */
  reachable: boolean;
  /** Lined up with the page's left edge, for a page that is not centred. */
  start?: boolean;
};

/** Connecting a tool to this site: pick the one you use, and its steps show. */
export function ConnectTool({ base, tool, address, name, site, cursor_link, reachable, start = false }: ConnectToolProps) {
  return (
    <div class={["flex w-full flex-col gap-8", start ? "items-start" : "items-center"]}>
      <nav aria-label={Publr.t("Your own tool")} class={["flex flex-wrap gap-2", start ? "justify-start" : "justify-center"]}>
        <Button href={tool === "claude_code" ? base : base + "?tool=claude_code"} hierarchy={tool === "claude_code" ? "contrast" : "secondary"} size="sm">
          {"Claude Code"}
        </Button>
        <Button href={tool === "codex" ? base : base + "?tool=codex"} hierarchy={tool === "codex" ? "contrast" : "secondary"} size="sm">
          {"Codex"}
        </Button>
        <Button href={tool === "cursor" ? base : base + "?tool=cursor"} hierarchy={tool === "cursor" ? "contrast" : "secondary"} size="sm">
          {"Cursor"}
        </Button>
        <Button href={tool === "windsurf" ? base : base + "?tool=windsurf"} hierarchy={tool === "windsurf" ? "contrast" : "secondary"} size="sm">
          {"Windsurf"}
        </Button>
        {reachable && (
          <Button href={tool === "claude_ai" ? base : base + "?tool=claude_ai"} hierarchy={tool === "claude_ai" ? "contrast" : "secondary"} size="sm">
            {"Claude.ai"}
          </Button>
        )}
        {reachable && (
          <Button href={tool === "chatgpt" ? base : base + "?tool=chatgpt"} hierarchy={tool === "chatgpt" ? "contrast" : "secondary"} size="sm">
            {"ChatGPT"}
          </Button>
        )}
        <Button href={tool === "other" ? base : base + "?tool=other"} hierarchy={tool === "other" ? "contrast" : "secondary"} size="sm">
          {Publr.t("Other agent")}
        </Button>
      </nav>
      {tool !== "" && <McpSetup tool={tool} address={address} name={name} site={site} cursor_link={cursor_link} />}
    </div>
  );
}
