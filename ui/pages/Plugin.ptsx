import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { ConfirmAction } from "../components/ConfirmAction.ptsx";
import { ContentAccess } from "../components/ContentAccess.ptsx";
import { IndexSection } from "../components/IndexSection.ptsx";
import { PluginRequests } from "../components/PluginRequests.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type PluginProps = {
  name: string;
  version: string;
  summary: string;
  enabled: boolean;
  /** The version of a newer module waiting to be applied, and its review; empty for none. */
  update: string;
  update_href: string;
  /** The version the last update replaced, to roll back to; empty for none. */
  previous: string;
  enable_href: string;
  disable_action: string;
  rollback_action: string;
  decide_action: string;
  access_action: string;
  remove_action: string;
  requests: Array<{
    key: string;
    sentence: string;
    reason: string;
    tier: string;
    state: string;
    note: string;
    can_grant: boolean;
    can_revoke: boolean;
    can_deny: boolean;
  }>;
  show_access: boolean;
  scope: string;
  recommend: string;
  note: string;
  types: Array<{ handle: string; name: string; checked: boolean }>;
};

/** One plugin: whether it runs, its versions (an update waiting, the previous one to roll
 * back to), what it wants to do, granted or revoked one at a time, and its content access.
 * Revoking takes effect on its next call. */
export function Plugin({
  name,
  version,
  summary,
  enabled,
  update,
  update_href,
  previous,
  enable_href,
  disable_action,
  rollback_action,
  decide_action,
  access_action,
  remove_action,
  requests,
  show_access,
  scope,
  recommend,
  note,
  types,
}: PluginProps) {
  return (
    <IndexPage
      title={name}
      parents={[{ label: "Plugins", href: "/admin/settings/plugins" }]}
      description={summary}
      actions={
        <div class="contents">
          <ConfirmAction
            inline
            label="Remove plugin"
            title={`Remove ${name}?`}
            description="Its operations and hooks stop and its grants go. Its content types and their records stay."
            action={remove_action}
          />
          {previous !== "" && (
            <form method="post" action={rollback_action}>
              <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
              <Button type="submit" hierarchy="secondary">Roll back to {previous}</Button>
            </form>
          )}
          {update !== "" && (
            <Button href={update_href} hierarchy="secondary">Review {update}</Button>
          )}
          {enabled ? (
            <form method="post" action={disable_action}>
              <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
              <Button type="submit" hierarchy="secondary">Disable</Button>
            </form>
          ) : (
            <Button href={enable_href}>Enable</Button>
          )}
        </div>
      }
      meta={
        <div class="contents">
          {enabled ? <Status tone="success">Enabled</Status> : <Status tone="neutral">Disabled</Status>}
          <Text as="span" variant="body-sm" tone="muted">
            Version {version}
          </Text>
        </div>
      }
      notice={
        update !== "" && (
          <Callout title={`Version ${update} is available`}>
            This version keeps running until you review and apply it.
          </Callout>
        )
      }
    >
      <IndexSection
        title="This plugin wants to"
        empty={requests.length === 0 ? "Nothing beyond its own operations and content types." : undefined}
      >
        <PluginRequests csrf={Publr.request.session.csrf} action={decide_action} requests={requests} />
      </IndexSection>
      {show_access && (
        <IndexSection padded title="Content access">
          <form method="post" action={access_action} class="flex flex-col gap-4">
            <input type="hidden" name="csrf" value={Publr.request.session.csrf} />
            <ContentAccess scope={scope} recommend={recommend} note={note} types={types} />
            <div>
              <Button type="submit" hierarchy="secondary">
                Save content access
              </Button>
            </div>
          </form>
        </IndexSection>
      )}
    </IndexPage>
  );
}
