import { Publr } from "publr-jsx";
import { IndexPage } from "../layouts/IndexPage.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Link } from "@publr/ui/Link.ptsx";
import { Status } from "@publr/ui/Status.ptsx";
import { Table } from "@publr/ui/Table.ptsx";
import { TableBody } from "@publr/ui/TableBody.ptsx";
import { TableCell } from "@publr/ui/TableCell.ptsx";
import { TableHead } from "@publr/ui/TableHead.ptsx";
import { TableHeader } from "@publr/ui/TableHeader.ptsx";
import { TableRow } from "@publr/ui/TableRow.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

/** Every kept version of a record, newest first, after the current one. */
export type RevisionsProps = {
  title: string;
  record_title: string;
  record_href: string;
  status: string;
  changed: boolean;
  updated: string;
  updated_by: string;
  rows: Array<{ href: string; seq: string; kind: string; title: string; at: string; by: string }>;
  /** The page of older versions; empty past the oldest. */
  older_href: string;
};

export function Revisions({
  title,
  record_title,
  record_href,
  status,
  changed,
  updated,
  updated_by,
  rows,
  older_href,
}: RevisionsProps) {
  return (
    <IndexPage
      title={title}
      parents={[{ label: record_title, href: record_href }]}
      description={Publr.t("Every replaced live document is kept.")}
      footer={
        rows.length === 0 ? (
          <Text as="p" variant="body-sm" tone="muted">
            {Publr.t("No previous versions yet: one is kept every time the live document is replaced.")}
          </Text>
        ) : (
          older_href !== "" && (
            <Button href={older_href} hierarchy="secondary" size="sm">
              {Publr.t("Older")}
            </Button>
          )
        )
      }
    >
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>#</TableHead>
          <TableHead>{Publr.t("Kind")}</TableHead>
          <TableHead>{Publr.t("Title")}</TableHead>
          <TableHead>{Publr.t("Taken")}</TableHead>
          <TableHead>{Publr.t("By")}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell>
            <Text as="span" variant="body-sm">
              {Publr.t("current")}
            </Text>
          </TableCell>
          <TableCell>
            <div class="flex flex-wrap items-center gap-3">
              {status === "published" ? (
                <Status tone="success">{status}</Status>
              ) : (
                <Status tone="neutral">{status}</Status>
              )}
              {changed && <Status tone="warning">{Publr.t("pending changes aside")}</Status>}
            </div>
          </TableCell>
          <TableCell>
            <Text as="span" variant="body-sm">
              {record_title}
            </Text>
          </TableCell>
          <TableCell numeric>
            <Text as="span" variant="body-sm" tone="muted">
              {updated}
            </Text>
          </TableCell>
          <TableCell>
            <Text as="span" variant="body-sm" tone="muted">
              {updated_by}
            </Text>
          </TableCell>
        </TableRow>
        {rows.map((row) => (
          <TableRow>
            <TableCell>
              <Link href={row.href} variant="body-sm">
                {row.seq}
              </Link>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm" tone="muted">
                {row.kind}
              </Text>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm">
                {row.title}
              </Text>
            </TableCell>
            <TableCell numeric>
              <Text as="span" variant="body-sm" tone="muted">
                {row.at}
              </Text>
            </TableCell>
            <TableCell>
              <Text as="span" variant="body-sm" tone="muted">
                {row.by}
              </Text>
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
</IndexPage>
  );
}
