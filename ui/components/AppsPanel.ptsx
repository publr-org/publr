import { Publr } from "publr-jsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { SidebarNavItem } from "@publr/ui/SidebarNavItem.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

type Choice = {
  /** What the form sends: empty for everything, else an app's name. */
  value: string;
  label: string;
  current: boolean;
  /** The app's site; empty for everything. */
  href: string;
};

export type AppsPanelProps = {
  /** Everything, then each app. */
  choices: Choice[];
  csrf: string;
  /** The page to come back to, narrowed. */
  back: string;
  /** The project's only app's site: nothing to pick, only the site to open. */
  only_href: string;
};

/** Which app the admin shows, as rows for a phone's drawer: picking one reloads the page
 * narrowed to it, and each app's site opens beside it. The app picker's drawer shows it, or
 * the drawer of the segment a plugin joins to the picker, so one drawer holds both. */
export function AppsPanel({ choices, csrf, back, only_href }: AppsPanelProps) {
  return (
    <div class="flex flex-col" data-part="apps-panel">
      {only_href !== "" && (
        <SidebarNavItem href={only_href} target="_blank">
          <Text as="span" variant="nav" classes="flex-1 truncate">
            {Publr.t("View site")}
          </Text>
          <Icon name="external" size="sm" />
        </SidebarNavItem>
      )}
      {only_href === "" && choices.map((choice) => (
        <div class="flex items-center gap-1" key={choice.value} data-part="app-choice">
          <form method="post" action="/admin/app" class="min-w-0 flex-1">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="app" value={choice.value} />
            <input type="hidden" name="back" value={back} />
            <SidebarNavItem type="submit" active={choice.current}>
              <Text as="span" variant="nav" classes="flex-1 truncate">
                {choice.label}
              </Text>
              {choice.current && <Icon name="check" size="sm" />}
            </SidebarNavItem>
          </form>
          {choice.href !== "" && (
            <Button
              size="sm"
              hierarchy="tertiary"
              href={choice.href}
              target="_blank"
              label={Publr.t("Open {name}", { name: choice.label })}
              title={Publr.t("Open {name}", { name: choice.label })}
            >
              <Icon name="external" size="sm" />
            </Button>
          )}
        </div>
      ))}
    </div>
  );
}
