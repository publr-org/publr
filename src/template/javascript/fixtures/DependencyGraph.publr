---
/**
 * Simplified entries → pages dependency graph: one edited entry lights the
 * pages that read it; the rest stay untouched.
 */
const entries = ['team', 'author', 'post 7', 'post 8'];
const pages = ['/posts/seven', '/posts/eight', '/posts', '/'];
const links: [number, number][] = [
	[0, 0], [0, 1],
	[1, 0], [1, 1],
	[2, 0], [2, 2], [2, 3],
	[3, 1], [3, 2],
];
const changed = 1;
const hot = new Set(links.filter(([from]) => from === changed).map(([, to]) => to));

const W = 460, CW = 150, CH = 40, ROW = 52;
const RX = W - CW;
const H = entries.length * ROW - (ROW - CH);
const y = (i: number) => i * ROW + CH / 2;
const path = (from: number, to: number) => {
	const c = (CW + RX) / 2;
	return `M${CW} ${y(from)} C${c} ${y(from)} ${c} ${y(to)} ${RX} ${y(to)}`;
};
---

<div class="w-full max-w-[460px] font-mono text-[13px]">
	<svg viewBox={`0 0 ${W} ${H}`} class="block w-full" aria-hidden="true">
		{
			links.map(([from, to]) => (
				<path
					d={path(from, to)}
					fill="none"
					stroke={from === changed ? '#f0a35a' : '#f5f4f1'}
					stroke-width="1"
					opacity={from === changed ? 0.9 : 0.12}
				/>
			))
		}
		{
			entries.map((name, i) => (
				<g transform={`translate(0 ${i * ROW})`}>
					<rect width={CW} height={CH} rx="8" fill="#0b0b0b" stroke={i === changed ? '#f0a35a' : '#f5f4f1'} stroke-opacity={i === changed ? 1 : 0.14} />
					<text x="14" y="24" fill="#f5f4f1" fill-opacity={i === changed ? 1 : 0.7} font-size="13" font-family="Geist Mono, monospace">{name}</text>
				</g>
			))
		}
		{
			pages.map((name, i) => (
				<g transform={`translate(${RX} ${i * ROW})`}>
					<rect width={CW} height={CH} rx="8" fill="#0b0b0b" stroke={hot.has(i) ? '#f0a35a' : '#f5f4f1'} stroke-opacity={hot.has(i) ? 1 : 0.14} />
					<text x="14" y="24" fill="#f5f4f1" fill-opacity={hot.has(i) ? 1 : 0.7} font-size="13" font-family="Geist Mono, monospace">{name}</text>
				</g>
			))
		}
	</svg>
	<div class="mt-4 flex justify-between px-1 text-paper/45">
		<span><span class="text-ember">author</span> edited</span>
		<span>{hot.size} of {pages.length} pages updated · live</span>
	</div>
</div>
