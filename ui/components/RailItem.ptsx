import type { IconName } from "@publr/ui/Icon.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";

export type RailItemProps = {
  href: string;
  label: string;
  icon_name: IconName;
  /** A plugin's own icon, in the page's sprite; empty for one of the set. */
  custom_icon?: string;
  active: boolean;
  /** `_blank` for a link that leaves the admin, like the site. */
  target?: string;
};

/** One section on the admin's dark rail: an icon link, lit when the page is in it. */
export function RailItem({ href, label, icon_name, custom_icon = "", active, target = "" }: RailItemProps) {
  return (
    <a
      href={href}
      target={target === "" ? undefined : target}
      aria-label={label}
      title={label}
      aria-current={active ? "page" : undefined}
      class={[
        "inline-flex size-9 items-center justify-center rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rail-foreground",
        active
          ? "bg-rail-accent text-rail-foreground"
          : "text-rail-muted hover:bg-rail-accent/60 hover:text-rail-foreground",
      ]}
    >
      <Icon name={icon_name} custom_icon={custom_icon} size="md" />
    </a>
  );
}
