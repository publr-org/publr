import { Publr } from "publr-jsx";
import { ChoiceButton } from "@publr/ui/ChoiceButton.ptsx";
import { FieldControl } from "../FieldControl.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Radio } from "@publr/ui/Radio.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

export type RecordValueProps = {
  name: string;
  control: string;
  value: string;
  checked: boolean;
  readonly: boolean;
  label_on: string;
  placeholder: string;
  rows: number;
  min: string;
  max: string;
  step: string;
  prefix: string;
  suffix: string;
  card_type: string;
  card_title: string;
  card_status: string;
  card_tone: string;
  card_href: string;
  formats: string;
  /** A plugin kind's editor: its frame's address. */
  src?: string;
  delete_note?: string;
  remove: string;
  up: string;
  down: string;
  options: Array<{
    value: string;
    label: string;
    selected: boolean;
  }>;
  /** A media value inside a group or a repeater: what RecordMedia shows and takes. */
  files?: Array<{
    id: string;
    title: string;
    thumb: string;
    image: boolean;
    kind: string;
    icon: "video" | "audio" | "file";
    facts: string;
    missing: boolean;
    slot: string;
    place: string;
    first: boolean;
    last: boolean;
  }>;
  types?: Array<{ id: string; label: string }>;
  accept?: string;
  can_upload?: boolean;
};

export function RecordValue({
  name,
  control,
  value,
  checked,
  readonly,
  label_on,
  placeholder,
  rows,
  min,
  max,
  step,
  prefix,
  suffix,
  card_type,
  card_title,
  card_status,
  card_tone,
  card_href,
  formats,
  src = "",
  delete_note = "",
  remove,
  up,
  down,
  options,
  files = [],
  types = [],
  accept = "",
  can_upload = true,
}: RecordValueProps) {
  return (
    <FieldControl
      name={name}
      control={control}
      value={value}
      checked={checked}
      readonly={readonly}
      label_on={label_on}
      placeholder={placeholder}
      rows={rows}
      min={min}
      max={max}
      step={step}
      prefix={prefix}
      suffix={suffix}
      card_type={card_type}
      card_title={card_title}
      card_status={card_status}
      card_tone={card_tone}
      card_href={card_href}
      formats={formats}
      src={src}
      delete_note={delete_note}
      remove={remove}
      up={up}
      down={down}
      files={files}
      types={types}
      accept={accept}
      can_upload={can_upload}
    >
      {control === "buttons"
        ? options.map((option) => (
            <ChoiceButton name={name} value={option.value} label={option.label} checked={option.selected} />
          ))
        : control === "rating"
        ? options.map((option) => (
            <label class="cursor-pointer p-0.5 text-muted-foreground/40 transition-colors" title={option.label}>
              <input type="radio" class="sr-only" name={name} value={option.value} checked={option.selected} aria-label={Publr.t("{rating} of {count}", { rating: option.label, count: options.length })} />
              <Icon name="star" size="lg" />
            </label>
          ))
        : control === "radios"
        ? options.map((option) => (
            <label class="flex items-center gap-2">
              <Radio name={name} value={option.value} checked={option.selected} />
              <Text as="span" variant="body-sm">
                {option.label}
              </Text>
            </label>
          ))
        : options.map((option) => (
            <option value={option.value} selected={option.selected}>
              {option.label}
            </option>
          ))}
    </FieldControl>
  );
}
